{
  "schema_version": "wsp.v1",
  "spec_id": "solids-property-cleanroom-astra-w0",
  "family": "bass",
  "model_name": "Conservative property-driven solid heating and conversion W0",
  "target": {
    "quantity": "temperature",
    "unit": "K",
    "description": "Cell-average solid temperature in a finite fixed-volume persistent-matrix slab with supplied thermal boundary history and first-order pyrolysis properties.",
    "excludes": ["autonomous luminous flame spread", "gas-phase burning rate", "quench threshold", "oxidative solid chemistry", "melting and moving geometry", "heat flux as a temperature alias", "full spread qualification"]
  },
  "features": [
    {"name":"initial_temperature_field","unit":"K","source":"supplied_initial_state:all_x_z_cells_with_time_origin","transform":"identity@1"},
    {"name":"initial_time","unit":"s","source":"supplied_initial_state:seconds_since_explicit_time_origin","transform":"identity@1"},
    {"name":"length","unit":"m","source":"specimen:finite_length","transform":"identity@1"},
    {"name":"thickness","unit":"m","source":"specimen:finite_thickness","transform":"identity@1"},
    {"name":"width","unit":"m","source":"specimen:finite_width","transform":"identity@1"},
    {"name":"mesh_x_cells","unit":"1","source":"numerics:positive_integer_nx","transform":"identity@1"},
    {"name":"mesh_z_cells","unit":"1","source":"numerics:positive_integer_nz","transform":"identity@1"},
    {"name":"inert_loading","unit":"kg/m3","source":"property:persistent_inert_matrix_with_provenance_domain_reference","transform":"identity@1"},
    {"name":"inert_heat_capacity","unit":"J/(kg K)","source":"property:constant_domain_inert_cp","transform":"identity@1"},
    {"name":"effective_conductivity","unit":"W/(m K)","source":"property:fixed_effective_matrix_conductivity","transform":"identity@1"},
    {"name":"reactant_loadings","unit":"kg/m3","source":"property:one_value_per_declared_composition_constituent","transform":"identity@1"},
    {"name":"reactant_heat_capacities","unit":"J/(kg K)","source":"property:one_constant_domain_cp_per_constituent","transform":"identity@1"},
    {"name":"reaction_preexponentials","unit":"1/s","source":"property:one_first_order_A_per_constituent_no_default","transform":"identity@1"},
    {"name":"reaction_activation_energies","unit":"J/mol","source":"property:one_E_per_constituent_no_default","transform":"identity@1"},
    {"name":"reaction_enthalpies","unit":"J/kg","source":"property:one_endothermic_L_per_constituent_common_sensible_reference","transform":"identity@1"},
    {"name":"reference_temperature","unit":"K","source":"property:common_explicit_sensible_energy_reference","transform":"identity@1"},
    {"name":"pressure","unit":"Pa","source":"condition:pressure_within_all_property_domains","transform":"identity@1"},
    {"name":"flow_vector_history","unit":"m/s","source":"control:flow_vector_matched_to_boundary_validity_context","transform":"identity@1"},
    {"name":"gravity_vector_history","unit":"m/s2","source":"control:gravity_vector_matched_to_boundary_validity_context","transform":"identity@1"},
    {"name":"surface_normal_history","unit":"1","source":"control:unit_orientation_normal_matched_to_boundary_validity_context","transform":"identity@1"},
    {"name":"oxygen_mole_fraction_history","unit":"1","source":"control:oxygen_matched_to_boundary_validity_context_not_a_burning_rate","transform":"identity@1"},
    {"name":"control_times","unit":"s","source":"control:piecewise_constant_start_end_since_time_origin","transform":"identity@1"},
    {"name":"pilot_history","unit":"1","source":"control:explicit_pilot_on_off_context_only","transform":"identity@1"},
    {"name":"gas_temperature_history","unit":"K","source":"boundary:each_front_back_column_each_control_interval","transform":"identity@1"},
    {"name":"radiant_temperature_history","unit":"K","source":"boundary:each_front_back_column_each_control_interval","transform":"identity@1"},
    {"name":"heat_transfer_history","unit":"W/(m2 K)","source":"boundary:sourced_h_valid_for_exact_environment","transform":"identity@1"},
    {"name":"emissivity_history","unit":"1","source":"boundary:sourced_gray_surface_emissivity","transform":"identity@1"},
    {"name":"absorbed_incident_flux_history","unit":"W/m2","source":"boundary:independent_absorbed_external_heat_excluding_other_boundary_terms","transform":"identity@1"},
    {"name":"maximum_step","unit":"s","source":"numerics:caller_budget_checked_against_positivity_bound","transform":"identity@1"},
    {"name":"conversion_level","unit":"1","source":"observation:declared_solid_conversion_isocontour","transform":"identity@1"},
    {"name":"residual_mass_resolution","unit":"kg","source":"observation:declared_finite_sample_exhaustion_resolution","transform":"identity@1"}
  ],
  "domain": [
    {"feature":"oxygen_mole_fraction_history","min":0.0,"max":1.0},
    {"feature":"emissivity_history","min":0.0,"max":1.0},
    {"feature":"conversion_level","min":0.0,"max":1.0}
  ],
  "tensors": [
    {"name":"gas_constant","shape":[],"role":"physical_parameter","fill":{"rule":"author_writes_all"},"unit":"J/(mol K)","bounds":{"min":0.0,"max":100.0},"description":"NIST molar gas constant, universal SI constant; authored literally, never fitted."},
    {"name":"stefan_boltzmann","shape":[],"role":"physical_parameter","fill":{"rule":"author_writes_all"},"unit":"W/(m2 K4)","bounds":{"min":0.0,"max":0.000001},"description":"NIST Stefan-Boltzmann constant truncated decimal; no material coefficient or simulation default."}
  ],
  "forward":{"entry_point":"ignis_wsp::property_solids_w0::State::advance","version":"property-solids-cleanroom-w0.1","profile":"strict_no_fitting"},
  "notes":"Internal kernel; coordinator owns adapter and immutable release assembly. All non-universal physical coefficients are provenance-bearing request properties with no defaults. The model predicts solid temperature and constituent conversion conditional on known future thermal boundaries. Conversion intervals are genuine solid front geometry, never luminous flame geometry. Luminous front and quench are explicitly unsupported. No outcome exposure, no material-name branches, no runtime fitting. Initial reactants are unconverted and uniform in loading; initial temperature may be spatially nonuniform. Persistent inert matrix is required. Explicit splitting converges only as caller reduces time and spatial steps; CFL is not an accuracy certificate. Domain endpoints in ModelSpec are descriptive; the kernel rejects zero conversion observation levels and all invalid physical states."
}
