# acme_normal.wsp2 — D4-NOSTOPS: D4 with its guessed stops switched off
# Literal revision of D4 sha256:cc0a3270…00ce, spec acme_normal-wsp-v2.
# Author: claude-fable-5-2 (Anthropic). DATA-INFORMED like its parent; no other number is changed.
#
# For use as a committee slot when the prefix carries the script's planned stop: the committee then
# hands this member the stop as a known control, and the campaign's stop times that the parent guesses
# (61.5, 98, 126.5, 275.5 s) must not act as well. The script timelines of the TRAIN tests show no
# stop that was neither the script's end, a detected extinction nor a burner-limit trip, so the
# background of unexplained stops is lowered to one in 8000 flame-seconds, as in D3-NOSTOPS. The
# burner-limit clock of this spec (ft.tau) is not a stop of the script and stays as it is.
ft.atom_logit[0:8] = [-40.0, -40.0, -40.0, -40.0, -40.0, -40.0, -40.0, -40.0]
ft.log_base = -9.0
