# acme_inverse.wsp5 — P1 literal revision of the baseline sha256:00000000…0000, spec acme_inverse-wsp-v5
# Author: claude-fable-5-2 (Anthropic). DATA-INFORMED, not zero-shot: every member is a data-informed
# candidate (see their own edits files for what each number was typed from).
#
#   slot b0   acme_inverse.wsp3 D1: the carried law
#   slot b1   acme_inverse.wsp3 D5: the same, plus one law: in the marginal band of the mixture
#             fraction a flame at a high oxygen flow is held in a limit cycle
#   slots b2, b3   the same two with their guessed stop times switched off
#   slots a0, a1   the reference baseline of the root, silent
#
# The two members agree on every train flame but two (21228C2 and 21270H4, both still burning at the
# stop while pulsing) and on every flame outside the band of mixture fraction 0.47 to about 0.57 at
# the highest oxygen flow. Whether such a flame is held was seen twice in two at 9 mg/s, at 8.9 % and
# 14 % ambient fuel and 1.1 and 2.2 atm; for a leaner ambient, another fuel or a higher pressure the
# train table is silent. One third is the author's probability that the law carries there.
#
# The slot values below were not typed again. They are the stored values of the releases named in
# the slot blocks, copied statement by statement by tools/wsp/committee_edits.py with the slot prefix
# added; only the statements that differ from the baseline's slots are written. That script chooses
# and computes nothing. The lines typed for this file:

# Two thirds that a marginal flame at a high flow goes out like its neighbours, one third that it is held.
mix.w[0:6] = [0.0, 0.0, 2.0, 1.0, 0.0, 0.0]

# When the prefix carries the script's planned stop: the same two scenarios, without their guessed stops.
mix.w_script[0:6] = [0.0, 0.0, 0.0, 0.0, 2.0, 1.0]
# The stored planned stop is the sum of the script's stage durations. On the 29 TRAIN tests that ran
# to the scripted end the flow stopped at that sum minus 0.4 s on the record's clock, which counts
# from the established flame (median; -1.3 to +1.7 s).
script.onset_s = 0.4
