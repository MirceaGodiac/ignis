  "observation_model": {
    "not_inferred": "temperature, species, pyrolysis front from intensity",
    "prefix": "tip and base positions of the stills at or before the cutoff; flow stages; the igniter stage",
    "prefix_operator": "empirical mean at each channel's admitted still times; tip overhang, law advance and delayed base use matching sample operators; the base delay remains evaluated once at its late-window mean time",
    "units": "the model works in sample widths; metres follow from the width condition of the prefix"
  },
  "numerics": {
    "event_coordinates": "active route: p_quenched is first-event quench incidence; p_reached_end is F_end/(1-F_quench), preserving the legacy DTO interface; artifact rows are the actual competing incidences",
    "flow_paths": "up to three whole runs under shifted and scaled flow histories; quantiles of their mixture by a fixed number of halvings of the monotone mixture CDF",
    "integrator": "explicit step num.dt_s for the front, the slow-down downstream evaluated at the start of each step; exact relaxation of the overhang within a step, its time chosen at the start of the step",
    "law_committee": "oxygen.member_weight mixes complete persistent position distributions; active joint applies the new coherent first-event mapping to both speed scenarios, not the old artifact event rows",
    "prefix_anchor": "last-window mean tip minus mean modeled overhang, propagated from mean law position; mean time remains the inherited gain and lead clock",
    "request_time_fitting": "none",
    "speed": "authored mixture of empirical spread and positive quadratic-root oxygen-supply closure; actual width converts SI speed to sample widths/s",
    "uncertainty_limits": "unchanged coefficients and variance formula applied to window-relative increments; not a covariance model for averaged measurement noise or drift"
  },
