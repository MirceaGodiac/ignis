# Astra R1. DATA-INFORMED, not zero-shot. New literals by main author.
# Unchanged prefix/overhang/burn/quench tensors copied from front2/carry-d1.
# S: pure oxygen-supply steady speed; whole-distribution member switch separate.
oxygen.mix = 1
oxygen.member_weight = 1
# L/N: ambient supply density with hot-layer transport is a HYBRID capture-layer
# closure, not a single-state gas or an exact transient solution (ASTRA_PROPERTIES).
# rho from Ferkul's nominal ambient model; nu/alpha use the corrected dry-air
# reference at 1250 K in properties_verified, checked against its source equations.
oxygen.rho_kg_m3 = 1.15
oxygen.nu_m2_s = 0.000178
oxygen.alpha_m2_s = 0.000241
# N: O2 and N2 molar masses, kg/mol. The carrier is approximated as nitrogen.
oxygen.molar_o2_kg_mol = 0.0319988
oxygen.molar_carrier_kg_mol = 0.0280134
# A: SIBAL combustible TOTAL areal loading, 75% of 18.05 mg/cm2, rounded.
# Both faces consume this same sheet: divide total by face count exactly once.
oxygen.fuel_areal_kg_m2 = 0.1354
oxygen.faces = 2
# N: cellulose C6H10O5 + 6 O2, oxygen/fuel mass ratio rounded.
oxygen.stoich_kg_o2_kg_fuel = 1.185
# L/direct-train: steady residence closure around the 9.4-10.4 s train ratios.
# One directly train-read new coefficient; NOT a source-only physical constant.
oxygen.residence_s = 10
# A: inherited nominal wide-sample metric calibration, not a new pixel measurement.
oxygen.reference_width_m = 0.022
