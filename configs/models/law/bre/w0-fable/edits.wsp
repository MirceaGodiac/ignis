lasts.logit.W1[0:6, 0:7] = [[2.21, 1.29, -0.10, 0.46, 1.23, 0.08, -1.0],
                            [2.21, 1.29, -0.10, 0.46, 1.23, 0.08, -1.0],
                            [2.21, 1.29, -0.10, 0.46, 1.23, 0.08, -1.0],
