flame_end.extinction.median.w2[5:7] = [-1.8, -6.0]
flame_end.extinction.shape = 2.2

# lasts: logit = 4.0 * (H(v) - b), v = 0.187 + z_t - base(z); 0.187 = ln 30 - 3.214
lasts.logit.b0 = -2.27
lasts.logit.skip[0:7] = [-3.68, -1.52, 3.60, -1.08, -1.48, -0.44, 0.0]
