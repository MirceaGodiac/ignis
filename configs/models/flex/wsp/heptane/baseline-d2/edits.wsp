# flex_heptane.wsp — reference baseline, NOT a candidate: the classical D^2-law.
# Population rate 0.55 mm2/s (the published median of the FLEX heptane tests), replaced by the
# prefix's own finite-difference rate as the prefix grows; no extinction of any kind, no cool flame,
# no evaporation. It answers one question: what does a forecast score that knows nothing about
# flames going out?
rate.b0 = -0.6
rate.skip[0:7] = 0.0
crit.b0 = 5.0
crit.skip[0:4] = 0.0
class.kappa = 20.0
class.bias = 0.0
diff.b0 = 12.0
diff.skip[0:6] = 0.0
diff.sharp = 40.0
rad.b0 = 0.0
rad.skip[0:6] = 0.0
rad.sharp = 4.0
cool.p.b0 = -30.0
cool.p.skip[0:6] = 0.0
cool.k.b0 = -1.2
cool.k.skip[0:5] = 0.0
cool.d.b0 = -0.7
cool.d.skip[0:5] = 0.0
cool.d.sd = 0.1
post.cool_scale = 1.0
post.k_inf = 0.0
post.k_hot = 0.0
post.tau0_s = 1.0
post.size_exp = 0.5
enc.gain_w[0:3] = [2.0, 0.5, 2.0]
enc.gain_b = -1.5
enc.mix[0:2] = [1.0, 0.0]
enc.e_clip[0:2] = [3.0, 3.0]
filt.sd_evap = 0.2
filt.l_floor = 1.0
unc.s_pop = 0.25
unc.s_floor = 0.08
unc.sigma_d = 3.0e-5
unc.sigma_frame = 8.0e-6
haz.log_disruption = -20.0
