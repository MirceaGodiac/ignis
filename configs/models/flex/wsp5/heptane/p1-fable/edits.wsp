# flex_heptane.wsp5 — P1 literal revision of P0 sha256:9a108f1a…ac0b, spec flex_heptane-wsp-v5
# Author: claude-fable-5-2 (Anthropic). DATA-INFORMED, not zero-shot. P0 plus the two entries of the
# fifth droplet forward that read the flame cameras, with the values of the candidate F1 of
# flex_heptane.wsp4 (see that file for the reason of each). Every number typed by the author. No
# validation outcome was read.
#
# The cameras observe the state the model otherwise infers from the diameter: a flame frame in the
# last quarter second of the prefix says the hot flame is there; none, after at least five frames,
# says it is not. The numbers are instrument facts (frame rates of 15 and 30 per second), not train
# statistics. On the shared records, which carry no camera series, this candidate answers as P0 with
# the heavy-tailed clock.
#
# One droplet in ten outlives the radiative clock by a wide margin (a hot flame seen by the camera for
# eight seconds where the clock allows one, at 2 atm in CO2): the clock's survival keeps a slow tail.
rob.eps_r = 0.1
fl.trust = 0.95
fl.t_min_s = 0.3
fl.gap_s = 0.25
fl.min_points = 5.0
fl.evap_mix = 0.5
