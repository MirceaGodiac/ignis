unc.sigma_d = 3.0e-5
unc.sigma_frame = 8.0e-6
haz.log_disruption = -20.0

# =====================================================================================================
# Fourth-generation entries (spec flex_heptane-wsp-v3): neutral: to be typed by the author
# =====================================================================================================
# neutral: to be typed by the author
# With art.weight = 0 the broad component is absent whatever the thresholds; the thresholds sit at
# their upper bounds so that no flag fires, and the broad sd is 0. With post.he_w = 0 and
# post.seen_max = 3 the forward is the third-generation one, number for number.
art.min_gated = 1000.0
art.d0_tol = 5.0
art.rise_tol = 5.0
art.weight[0:4] = [0.0, 0.0, 0.0, 0.0]
art.r_band[0:2] = [-1000.0, 1000.0]
art.sigma_m = 0.0
art.sigma_rate_m_s = 0.0
post.he_w = 0.0
post.seen_max = 3.0
