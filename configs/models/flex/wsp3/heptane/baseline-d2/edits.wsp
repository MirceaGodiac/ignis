cool.k.skip[0:5] = 0.0
cool.d.b0 = -0.7
cool.d.skip[0:5] = 0.0
cool.d.sd = 0.1
post.cool_scale = 1.0
post.k_inf = 0.0
post.k_hot = 0.0
post.tau0_s = 1.0
post.size_exp = 0.5
post.hot_exp = 0.0
post.tau_exp = 1.0
enc.gain_w[0:3] = [2.0, 0.5, 2.0]
enc.gain_b = -1.5
enc.mix[0:2] = [1.0, 0.0]
enc.e_clip[0:2] = [3.0, 3.0]
