# flex_heptane.wsp3 — reference baseline and lineage root, NOT a candidate: the classical D^2-law.
# Population rate 0.55 mm2/s, replaced by the prefix's own finite-difference rate as the prefix
# grows; no extinction, no cool flame, no evaporation. Same numbers as the baseline of
# flex_heptane-wsp-v1 (as the baseline of flex_heptane-wsp-v2). Data-informed candidates of this spec
# are literal revisions of this release.
# Same numbers as the baseline of flex_heptane-wsp-v2 (flex_heptane.wsp2); the tensors flex_heptane-wsp-v3 adds are neutral.
rate.b0 = -0.6
rate.skip[0:7] = 0.0
