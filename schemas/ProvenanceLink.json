{
  "$defs": {
    "ArtifactId": {
      "minLength": 1,
      "pattern": "^\\S+$",
      "type": "string"
    },
    "DatasetId": {
      "minLength": 1,
      "pattern": "^\\S+$",
      "type": "string"
    },
    "Derivation": {
      "additionalProperties": false,
      "properties": {
        "agent": {
          "default": null,
          "type": [
            "string",
            "null"
          ]
        },
        "inputs": {
          "default": [],
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "method": {
          "$ref": "#/$defs/Method"
        },
        "method_id": {
          "type": "string"
        },
        "method_version": {
          "type": "string"
        },
        "notes": {
          "default": null,
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "method",
        "method_id",
        "method_version"
      ],
      "type": "object"
    },
    "EntityRef": {
      "description": "A typed reference to any IGNIS entity, used for lineage and provenance links.",
      "oneOf": [
        {
          "properties": {
            "id": {
              "$ref": "#/$defs/SourceId"
            },
            "kind": {
              "const": "source",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "id"
          ],
          "type": "object"
        },
        {
          "properties": {
            "id": {
              "$ref": "#/$defs/EvidenceId"
            },
            "kind": {
              "const": "evidence",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "id"
          ],
          "type": "object"
        },
        {
          "properties": {
            "id": {
              "$ref": "#/$defs/RunId"
            },
            "kind": {
              "const": "run",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "id"
          ],
          "type": "object"
        },
        {
          "properties": {
            "id": {
              "$ref": "#/$defs/ObservationId"
            },
            "kind": {
              "const": "observation",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "id"
          ],
          "type": "object"
        },
        {
          "properties": {
            "id": {
              "$ref": "#/$defs/DatasetId"
            },
            "kind": {
              "const": "dataset",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "id"
          ],
          "type": "object"
        },
        {
          "properties": {
            "id": {
              "$ref": "#/$defs/ArtifactId"
            },
            "kind": {
              "const": "artifact",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "id"
          ],
          "type": "object"
        },
        {
          "properties": {
            "id": {
              "$ref": "#/$defs/ReleaseId"
            },
            "kind": {
              "const": "release",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "id"
          ],
          "type": "object"
        },
        {
          "properties": {
            "id": {
              "$ref": "#/$defs/WikiPageId"
            },
            "kind": {
              "const": "wiki_page",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "id"
          ],
          "type": "object"
        },
        {
          "properties": {
            "id": {
              "$ref": "#/$defs/EpisodeId"
            },
            "kind": {
              "const": "episode",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "id"
          ],
          "type": "object"
        }
      ]
    },
    "EpisodeId": {
      "minLength": 1,
      "pattern": "^\\S+$",
      "type": "string"
    },
    "EvidenceId": {
      "minLength": 1,
      "pattern": "^\\S+$",
      "type": "string"
    },
    "EvidenceSchema": {
      "description": "Wire tag of search, read, provenance and wiki documents.",
      "enum": [
        "evidence.v1"
      ],
      "type": "string"
    },
    "LinkId": {
      "minLength": 1,
      "pattern": "^\\S+$",
      "type": "string"
    },
    "Method": {
      "enum": [
        "deterministic",
        "numerical",
        "semantic",
        "human_review"
      ],
      "type": "string"
    },
    "ObservationId": {
      "minLength": 1,
      "pattern": "^\\S+$",
      "type": "string"
    },
    "Origin": {
      "description": "Who produced a payload. `synthetic_fixture` marks hand-made contract examples; such payloads (and\nanything computed from them) can never be presented as NASA results or qualify a model.\nProduced-by-the-system payloads are `system` even when their *data* is synthetic (that is\n`EvidenceClass::Synthetic` / `TrainedOn::Synthetic`).",
      "enum": [
        "system",
        "synthetic_fixture"
      ],
      "type": "string"
    },
    "Relation": {
      "enum": [
        "supports",
        "contradicts",
        "derived_from",
        "describes",
        "same_run_as",
        "cites"
      ],
      "type": "string"
    },
    "ReleaseId": {
      "minLength": 1,
      "pattern": "^\\S+$",
      "type": "string"
    },
    "Resolution": {
      "enum": [
        "resolved",
        "unresolved_conflict",
        "unknown",
        "quarantined",
        "not_applicable"
      ],
      "type": "string"
    },
    "RunId": {
      "minLength": 1,
      "pattern": "^\\S+$",
      "type": "string"
    },
    "SourceId": {
      "minLength": 1,
      "pattern": "^\\S+$",
      "type": "string"
    },
    "WikiPageId": {
      "minLength": 1,
      "pattern": "^\\S+$",
      "type": "string"
    }
  },
  "$id": "ignis/2.1.0/ProvenanceLink",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "A typed edge between entities, with the evidence and method that established it. A purely\nsemantic association is `resolution = unknown`, never an exact identity.",
  "properties": {
    "evidence": {
      "default": [],
      "items": {
        "$ref": "#/$defs/EvidenceId"
      },
      "type": "array"
    },
    "from": {
      "$ref": "#/$defs/EntityRef"
    },
    "link_id": {
      "$ref": "#/$defs/LinkId"
    },
    "method": {
      "$ref": "#/$defs/Derivation"
    },
    "origin": {
      "$ref": "#/$defs/Origin"
    },
    "relation": {
      "$ref": "#/$defs/Relation"
    },
    "resolution": {
      "$ref": "#/$defs/Resolution"
    },
    "schema_version": {
      "$ref": "#/$defs/EvidenceSchema"
    },
    "to": {
      "$ref": "#/$defs/EntityRef"
    }
  },
  "required": [
    "schema_version",
    "link_id",
    "from",
    "to",
    "relation",
    "resolution",
    "method",
    "origin"
  ],
  "title": "ProvenanceLink",
  "type": "object"
}
