{
  "$defs": {
    "EvidenceId": {
      "minLength": 1,
      "pattern": "^\\S+$",
      "type": "string"
    },
    "EvidenceSchema": {
      "description": "Wire tag of the knowledge documents. Wave K1 writes `evidence.v2`; `evidence.v1` (C0) documents\nare still read. An addition of v2 (a field, a relation, a concept node, a new document type) is\nrefused under the v1 tag, so a v1 reader never receives a document it would misread.",
      "oneOf": [
        {
          "enum": [
            "evidence.v2"
          ],
          "type": "string"
        },
        {
          "const": "evidence.v1",
          "description": "C0. Still read; new documents are written as v2.",
          "type": "string"
        }
      ]
    },
    "ParseViewId": {
      "minLength": 1,
      "pattern": "^\\S+$",
      "type": "string"
    },
    "ReadRange": {
      "oneOf": [
        {
          "additionalProperties": false,
          "description": "Physical pages, 1-based, inclusive.",
          "properties": {
            "char_start": {
              "description": "Where reading starts in page `first`, in Unicode scalars from the page start: set by a\n`next` that continues a page too large for one response. Absent means the page start.",
              "format": "uint32",
              "minimum": 0,
              "type": [
                "integer",
                "null"
              ]
            },
            "first": {
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            },
            "kind": {
              "const": "pages",
              "type": "string"
            },
            "last": {
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            }
          },
          "required": [
            "kind",
            "first",
            "last"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "The passage an evidence reference points at, with its neighbourhood as the service defines.",
          "properties": {
            "evidence_id": {
              "$ref": "#/$defs/EvidenceId"
            },
            "kind": {
              "const": "passage",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "evidence_id"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "table",
              "type": "string"
            },
            "table_id": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "table_id"
          ],
          "type": "object"
        }
      ]
    },
    "ResponseFormat": {
      "description": "How much a search or read returns per item: `concise` keeps ids, locators and short text for\nscanning, `detailed` adds scores, full quotes and context. Absent = the service default. It\nchanges the size of each item, never which items match or their order.",
      "enum": [
        "concise",
        "detailed"
      ],
      "type": "string"
    },
    "SourceId": {
      "minLength": 1,
      "pattern": "^\\S+$",
      "type": "string"
    }
  },
  "$id": "ignis/2.1.0/ReadRequest",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "parse_view_id": {
      "anyOf": [
        {
          "$ref": "#/$defs/ParseViewId"
        },
        {
          "type": "null"
        }
      ]
    },
    "range": {
      "$ref": "#/$defs/ReadRange"
    },
    "response_format": {
      "anyOf": [
        {
          "$ref": "#/$defs/ResponseFormat"
        },
        {
          "type": "null"
        }
      ],
      "description": "v2."
    },
    "schema_version": {
      "$ref": "#/$defs/EvidenceSchema"
    },
    "source_id": {
      "$ref": "#/$defs/SourceId"
    }
  },
  "required": [
    "schema_version",
    "source_id",
    "range"
  ],
  "title": "ReadRequest",
  "type": "object"
}
