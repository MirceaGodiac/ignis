{
  "$defs": {
    "IdBasis": {
      "description": "What a `Source.id` hashes: the fetched bytes, a listing entry (url+size+provider checksum, not yet\nfetched) or a provider metadata record (access-gated). Only `Bytes` proves content identity.",
      "enum": [
        "bytes",
        "listing",
        "metadata_record"
      ],
      "type": "string"
    },
    "OffsetUnit": {
      "description": "Unit of `SourceLocator.char_start/char_end`. A Unicode-scalar offset is not a byte offset.",
      "enum": [
        "utf8_byte",
        "unicode_scalar",
        "utf16_code_unit"
      ],
      "type": "string"
    },
    "Rights": {
      "additionalProperties": false,
      "properties": {
        "license": {
          "default": null,
          "type": [
            "string",
            "null"
          ]
        },
        "statement_locator": {
          "anyOf": [
            {
              "$ref": "#/$defs/SourceLocator"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "status": {
          "$ref": "#/$defs/RightsStatus",
          "default": "unverified"
        }
      },
      "type": "object"
    },
    "RightsStatus": {
      "enum": [
        "verified",
        "unverified",
        "restricted",
        "noncommercial"
      ],
      "type": "string"
    },
    "SourceKind": {
      "enum": [
        "dataset_file",
        "publication",
        "video",
        "protocol",
        "calibration",
        "webpage",
        "archive"
      ],
      "type": "string"
    },
    "SourceLocator": {
      "additionalProperties": false,
      "description": "Where a value or passage sits inside one asset. A single locator type serves observations,\nchunks, calibrations and evidence references.\n\nConventions fixed in C0 and checked by [`SourceLocator::validate`]:\n* `asset_sha256` is the bare 64-hex digest of the asset bytes.\n* `page` is the **physical** 1-based page index; the printed label goes in `page_label`.\n* `char_start`/`char_end` are half-open offsets into the text of `parse_view_id`, counted in\n  `offset_unit`. Offsets without a parse view and unit are legacy and not citable.\n* `bbox` is `[x0, y0, x1, y1]` in fractions of the displayed page (after its /Rotate), origin\n  top-left, x right, y down.\n* `table_id` scopes `row`/`column` to a table inside the asset (CSV rows otherwise).\n\nFields added in 2.1.0 are omitted when absent, so the serialized form of older locators, and\ntherefore every prefix `input_hash` that embeds them, is unchanged.",
      "properties": {
        "asset_sha256": {
          "type": "string"
        },
        "bbox": {
          "items": {
            "format": "double",
            "type": "number"
          },
          "maxItems": 4,
          "minItems": 4,
          "type": [
            "array",
            "null"
          ]
        },
        "char_end": {
          "default": null,
          "format": "int64",
          "type": [
            "integer",
            "null"
          ]
        },
        "char_start": {
          "default": null,
          "format": "int64",
          "type": [
            "integer",
            "null"
          ]
        },
        "column": {
          "default": null,
          "type": [
            "string",
            "null"
          ]
        },
        "frame": {
          "default": null,
          "format": "int64",
          "type": [
            "integer",
            "null"
          ]
        },
        "offset_unit": {
          "anyOf": [
            {
              "$ref": "#/$defs/OffsetUnit"
            },
            {
              "type": "null"
            }
          ]
        },
        "page": {
          "default": null,
          "format": "int64",
          "type": [
            "integer",
            "null"
          ]
        },
        "page_label": {
          "type": [
            "string",
            "null"
          ]
        },
        "parse_view_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "path": {
          "default": null,
          "type": [
            "string",
            "null"
          ]
        },
        "pts_s": {
          "default": null,
          "format": "double",
          "type": [
            "number",
            "null"
          ]
        },
        "row": {
          "default": null,
          "format": "int64",
          "type": [
            "integer",
            "null"
          ]
        },
        "table_id": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "asset_sha256"
      ],
      "type": "object"
    }
  },
  "$id": "ignis/2.1.0/Source",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "canonical_url": {
      "default": null,
      "type": [
        "string",
        "null"
      ]
    },
    "doi": {
      "default": null,
      "type": [
        "string",
        "null"
      ]
    },
    "file_name": {
      "default": null,
      "type": [
        "string",
        "null"
      ]
    },
    "file_version": {
      "default": null,
      "type": [
        "string",
        "null"
      ]
    },
    "id": {
      "type": "string"
    },
    "id_basis": {
      "$ref": "#/$defs/IdBasis",
      "default": "bytes"
    },
    "investigation_id": {
      "default": null,
      "type": [
        "string",
        "null"
      ]
    },
    "investigation_version": {
      "default": null,
      "type": [
        "string",
        "null"
      ]
    },
    "kind": {
      "$ref": "#/$defs/SourceKind"
    },
    "media_type": {
      "default": null,
      "type": [
        "string",
        "null"
      ]
    },
    "ntrs_id": {
      "default": null,
      "type": [
        "string",
        "null"
      ]
    },
    "provider_version": {
      "default": null,
      "type": [
        "string",
        "null"
      ]
    },
    "retrieved_at": {
      "default": null,
      "type": [
        "string",
        "null"
      ]
    },
    "rights": {
      "$ref": "#/$defs/Rights",
      "default": {
        "license": null,
        "statement_locator": null,
        "status": "unverified"
      }
    },
    "size_bytes": {
      "default": null,
      "format": "int64",
      "type": [
        "integer",
        "null"
      ]
    },
    "title": {
      "default": null,
      "type": [
        "string",
        "null"
      ]
    }
  },
  "required": [
    "id",
    "kind"
  ],
  "title": "Source",
  "type": "object"
}
