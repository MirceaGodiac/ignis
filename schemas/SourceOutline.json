{
  "$defs": {
    "Digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "EvidenceSchema": {
      "description": "Wire tag of the knowledge documents. Wave K1 writes `evidence.v2`; `evidence.v1` (C0) documents\nare still read. An addition of v2 (a field, a relation, a concept node, a new document type) is\nrefused under the v1 tag, so a v1 reader never receives a document it would misread.",
      "oneOf": [
        {
          "enum": [
            "evidence.v2"
          ],
          "type": "string"
        },
        {
          "const": "evidence.v1",
          "description": "C0. Still read; new documents are written as v2.",
          "type": "string"
        }
      ]
    },
    "GeneratedText": {
      "additionalProperties": false,
      "description": "Text written by a model about a source. It is navigation help, never evidence: a claim cites\nthe passage, not the summary.",
      "properties": {
        "model_id": {
          "type": "string"
        },
        "prompt_hash": {
          "anyOf": [
            {
              "$ref": "#/$defs/Digest"
            },
            {
              "type": "null"
            }
          ]
        },
        "text": {
          "type": "string"
        }
      },
      "required": [
        "text",
        "model_id"
      ],
      "type": "object"
    },
    "Origin": {
      "description": "Who produced a payload. `synthetic_fixture` marks hand-made contract examples; such payloads (and\nanything computed from them) can never be presented as NASA results or qualify a model.\nProduced-by-the-system payloads are `system` even when their *data* is synthetic (that is\n`EvidenceClass::Synthetic` / `TrainedOn::Synthetic`).",
      "enum": [
        "system",
        "synthetic_fixture"
      ],
      "type": "string"
    },
    "OutlineNode": {
      "additionalProperties": false,
      "description": "One section: the document's own heading, its physical page range (1-based, inclusive) and\nchildren. `children_omitted` says the request's depth cut children that exist.",
      "properties": {
        "children": {
          "items": {
            "$ref": "#/$defs/OutlineNode"
          },
          "type": "array"
        },
        "children_omitted": {
          "type": "boolean"
        },
        "node_id": {
          "$ref": "#/$defs/OutlineNodeId"
        },
        "page_end": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "page_start": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "summary": {
          "anyOf": [
            {
              "$ref": "#/$defs/GeneratedText"
            },
            {
              "type": "null"
            }
          ]
        },
        "title": {
          "type": "string"
        }
      },
      "required": [
        "node_id",
        "title",
        "page_start",
        "page_end"
      ],
      "type": "object"
    },
    "OutlineNodeId": {
      "minLength": 1,
      "pattern": "^\\S+$",
      "type": "string"
    },
    "ParseViewId": {
      "minLength": 1,
      "pattern": "^\\S+$",
      "type": "string"
    },
    "SourceId": {
      "minLength": 1,
      "pattern": "^\\S+$",
      "type": "string"
    }
  },
  "$id": "ignis/2.1.0/SourceOutline",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "nodes": {
      "items": {
        "$ref": "#/$defs/OutlineNode"
      },
      "type": "array"
    },
    "origin": {
      "$ref": "#/$defs/Origin"
    },
    "parse_view_id": {
      "$ref": "#/$defs/ParseViewId"
    },
    "schema_version": {
      "$ref": "#/$defs/EvidenceSchema"
    },
    "source_id": {
      "$ref": "#/$defs/SourceId"
    }
  },
  "required": [
    "schema_version",
    "source_id",
    "parse_view_id",
    "nodes",
    "origin"
  ],
  "title": "SourceOutline",
  "type": "object"
}
