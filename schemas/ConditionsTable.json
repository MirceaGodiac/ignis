{
  "$defs": {
    "ConditionCell": {
      "description": "One cell of the conditions matrix. A gap is a status with a reason, never an absent cell or a\nzero. Conditions are experimental inputs, not outcomes; durations and endpoints never appear here.",
      "oneOf": [
        {
          "additionalProperties": false,
          "description": "Raw value, raw unit, SI value and locator of the original.",
          "properties": {
            "key": {
              "$ref": "#/$defs/ConditionKey"
            },
            "status": {
              "const": "value",
              "type": "string"
            },
            "value": {
              "$ref": "#/$defs/Measured"
            }
          },
          "required": [
            "status",
            "key",
            "value"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Sources disagree; every candidate is kept.",
          "properties": {
            "candidates": {
              "items": {
                "$ref": "#/$defs/Measured"
              },
              "type": "array"
            },
            "key": {
              "$ref": "#/$defs/ConditionKey"
            },
            "reason": {
              "type": "string"
            },
            "status": {
              "const": "conflicting",
              "type": "string"
            }
          },
          "required": [
            "status",
            "key",
            "candidates",
            "reason"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "key": {
              "$ref": "#/$defs/ConditionKey"
            },
            "reason": {
              "type": "string"
            },
            "status": {
              "const": "missing",
              "type": "string"
            }
          },
          "required": [
            "status",
            "key",
            "reason"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "key": {
              "$ref": "#/$defs/ConditionKey"
            },
            "reason": {
              "type": "string"
            },
            "status": {
              "const": "not_applicable",
              "type": "string"
            }
          },
          "required": [
            "status",
            "key",
            "reason"
          ],
          "type": "object"
        }
      ]
    },
    "ConditionKey": {
      "description": "A condition the challenge and the graph join on. Numeric keys are stored in the SI unit of their\n[`Quantity`]; the others are categorical text (`n-heptane`, `flat sheet`, `CIR/MDCA`). The\ncatalog is closed: a new key is a contract change.",
      "enum": [
        "oxygen_mole_fraction",
        "pressure",
        "flow_velocity",
        "gravity_level",
        "ambient_temperature",
        "fuel",
        "diluent",
        "sample_geometry",
        "hardware",
        "diagnostics"
      ],
      "type": "string"
    },
    "ConditionsRow": {
      "additionalProperties": false,
      "description": "The conditions of one run (or of an investigation-level test point when the run is unresolved).",
      "properties": {
        "cells": {
          "items": {
            "$ref": "#/$defs/ConditionCell"
          },
          "type": "array"
        },
        "investigation_id": {
          "type": "string"
        },
        "run": {
          "$ref": "#/$defs/RunIdentity"
        }
      },
      "required": [
        "investigation_id",
        "run",
        "cells"
      ],
      "type": "object"
    },
    "CorpusSnapshotId": {
      "minLength": 1,
      "pattern": "^\\S+$",
      "type": "string"
    },
    "DatasetSchema": {
      "description": "Wire tag of dataset, visual observation and conditions documents. Wave K1 writes `dataset.v2`;\n`dataset.v1` (C0) documents are still read, and keep their content digests because a\ndocument is re-serialized with the tag it was read with. New document types require v2.",
      "oneOf": [
        {
          "enum": [
            "dataset.v2"
          ],
          "type": "string"
        },
        {
          "const": "dataset.v1",
          "description": "C0. Still read; new documents are written as v2.",
          "type": "string"
        }
      ]
    },
    "Derivation": {
      "additionalProperties": false,
      "properties": {
        "agent": {
          "default": null,
          "type": [
            "string",
            "null"
          ]
        },
        "inputs": {
          "default": [],
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "method": {
          "$ref": "#/$defs/Method"
        },
        "method_id": {
          "type": "string"
        },
        "method_version": {
          "type": "string"
        },
        "notes": {
          "default": null,
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "method",
        "method_id",
        "method_version"
      ],
      "type": "object"
    },
    "EnvelopeEntry": {
      "description": "What an investigation tested for one key, over its runs.",
      "oneOf": [
        {
          "additionalProperties": false,
          "description": "Numeric key: closed range of the measured SI values.",
          "properties": {
            "key": {
              "$ref": "#/$defs/ConditionKey"
            },
            "max_si": {
              "type": "number"
            },
            "min_si": {
              "type": "number"
            },
            "runs": {
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            },
            "status": {
              "const": "range",
              "type": "string"
            },
            "unit_si": {
              "type": "string"
            }
          },
          "required": [
            "status",
            "key",
            "min_si",
            "max_si",
            "unit_si",
            "runs"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Categorical key: the values tested.",
          "properties": {
            "key": {
              "$ref": "#/$defs/ConditionKey"
            },
            "runs": {
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            },
            "status": {
              "const": "values",
              "type": "string"
            },
            "values": {
              "items": {
                "type": "string"
              },
              "type": "array",
              "uniqueItems": true
            }
          },
          "required": [
            "status",
            "key",
            "values",
            "runs"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "key": {
              "$ref": "#/$defs/ConditionKey"
            },
            "reason": {
              "type": "string"
            },
            "status": {
              "const": "missing",
              "type": "string"
            }
          },
          "required": [
            "status",
            "key",
            "reason"
          ],
          "type": "object"
        }
      ]
    },
    "EvidenceClass": {
      "enum": [
        "original_observation",
        "source_derived",
        "ignis_derived",
        "model_output",
        "synthetic"
      ],
      "type": "string"
    },
    "InvestigationEnvelope": {
      "additionalProperties": false,
      "description": "The tested envelope of one investigation: what a habitat atmosphere is compared against. Outside\nit is \"outside the tested envelope\", never an extrapolation.",
      "properties": {
        "entries": {
          "items": {
            "$ref": "#/$defs/EnvelopeEntry"
          },
          "type": "array"
        },
        "investigation_id": {
          "type": "string"
        },
        "runs": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "investigation_id",
        "runs",
        "entries"
      ],
      "type": "object"
    },
    "Measured": {
      "additionalProperties": false,
      "properties": {
        "derivation": {
          "anyOf": [
            {
              "$ref": "#/$defs/Derivation"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "evidence_class": {
          "$ref": "#/$defs/EvidenceClass",
          "default": "original_observation"
        },
        "flags": {
          "default": [],
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "locator": {
          "anyOf": [
            {
              "$ref": "#/$defs/SourceLocator"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "raw_unit": {
          "default": null,
          "type": [
            "string",
            "null"
          ]
        },
        "raw_value": {
          "anyOf": [
            {
              "format": "double",
              "type": "number"
            },
            {
              "type": "string"
            }
          ],
          "description": "`Measured.raw_value` / `Observation.raw_value`: `float | str | None`."
        },
        "resolution": {
          "$ref": "#/$defs/Resolution",
          "default": "resolved"
        },
        "uncertainty_reason": {
          "default": null,
          "type": [
            "string",
            "null"
          ]
        },
        "uncertainty_si": {
          "default": null,
          "format": "double",
          "type": [
            "number",
            "null"
          ]
        },
        "unit_si": {
          "default": null,
          "type": [
            "string",
            "null"
          ]
        },
        "value_si": {
          "default": null,
          "format": "double",
          "type": [
            "number",
            "null"
          ]
        }
      },
      "required": [
        "raw_value"
      ],
      "type": "object"
    },
    "Method": {
      "enum": [
        "deterministic",
        "numerical",
        "semantic",
        "human_review"
      ],
      "type": "string"
    },
    "OffsetUnit": {
      "description": "Unit of `SourceLocator.char_start/char_end`. A Unicode-scalar offset is not a byte offset.",
      "enum": [
        "utf8_byte",
        "unicode_scalar",
        "utf16_code_unit"
      ],
      "type": "string"
    },
    "Origin": {
      "description": "Who produced a payload. `synthetic_fixture` marks hand-made contract examples; such payloads (and\nanything computed from them) can never be presented as NASA results or qualify a model.\nProduced-by-the-system payloads are `system` even when their *data* is synthetic (that is\n`EvidenceClass::Synthetic` / `TrainedOn::Synthetic`).",
      "enum": [
        "system",
        "synthetic_fixture"
      ],
      "type": "string"
    },
    "PageCursor": {
      "minLength": 1,
      "pattern": "^\\S+$",
      "type": "string"
    },
    "Resolution": {
      "enum": [
        "resolved",
        "unresolved_conflict",
        "unknown",
        "quarantined",
        "not_applicable"
      ],
      "type": "string"
    },
    "RunId": {
      "minLength": 1,
      "pattern": "^\\S+$",
      "type": "string"
    },
    "RunIdentity": {
      "additionalProperties": false,
      "description": "Which run a clip shows; uncertain identity is explicit.",
      "properties": {
        "resolution": {
          "$ref": "#/$defs/Resolution"
        },
        "run_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/RunId"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "resolution"
      ],
      "type": "object"
    },
    "SourceLocator": {
      "additionalProperties": false,
      "description": "Where a value or passage sits inside one asset. A single locator type serves observations,\nchunks, calibrations and evidence references.\n\nConventions fixed in C0 and checked by [`SourceLocator::validate`]:\n* `asset_sha256` is the bare 64-hex digest of the asset bytes.\n* `page` is the **physical** 1-based page index; the printed label goes in `page_label`.\n* `char_start`/`char_end` are half-open offsets into the text of `parse_view_id`, counted in\n  `offset_unit`. Offsets without a parse view and unit are legacy and not citable.\n* `bbox` is `[x0, y0, x1, y1]` in fractions of the displayed page (after its /Rotate), origin\n  top-left, x right, y down.\n* `table_id` scopes `row`/`column` to a table inside the asset (CSV rows otherwise).\n\nFields added in 2.1.0 are omitted when absent, so the serialized form of older locators, and\ntherefore every prefix `input_hash` that embeds them, is unchanged.",
      "properties": {
        "asset_sha256": {
          "type": "string"
        },
        "bbox": {
          "items": {
            "format": "double",
            "type": "number"
          },
          "maxItems": 4,
          "minItems": 4,
          "type": [
            "array",
            "null"
          ]
        },
        "char_end": {
          "default": null,
          "format": "int64",
          "type": [
            "integer",
            "null"
          ]
        },
        "char_start": {
          "default": null,
          "format": "int64",
          "type": [
            "integer",
            "null"
          ]
        },
        "column": {
          "default": null,
          "type": [
            "string",
            "null"
          ]
        },
        "frame": {
          "default": null,
          "format": "int64",
          "type": [
            "integer",
            "null"
          ]
        },
        "offset_unit": {
          "anyOf": [
            {
              "$ref": "#/$defs/OffsetUnit"
            },
            {
              "type": "null"
            }
          ]
        },
        "page": {
          "default": null,
          "format": "int64",
          "type": [
            "integer",
            "null"
          ]
        },
        "page_label": {
          "type": [
            "string",
            "null"
          ]
        },
        "parse_view_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "path": {
          "default": null,
          "type": [
            "string",
            "null"
          ]
        },
        "pts_s": {
          "default": null,
          "format": "double",
          "type": [
            "number",
            "null"
          ]
        },
        "row": {
          "default": null,
          "format": "int64",
          "type": [
            "integer",
            "null"
          ]
        },
        "table_id": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "asset_sha256"
      ],
      "type": "object"
    }
  },
  "$id": "ignis/2.1.0/ConditionsTable",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "A page of the conditions matrix. Every row has exactly one cell per key in `keys`, so a gap is\nalways visible.",
  "properties": {
    "corpus_snapshot": {
      "anyOf": [
        {
          "$ref": "#/$defs/CorpusSnapshotId"
        },
        {
          "type": "null"
        }
      ],
      "description": "Sources the table was built from (PSI experimental tables, extracted passages)."
    },
    "envelopes": {
      "items": {
        "$ref": "#/$defs/InvestigationEnvelope"
      },
      "type": "array"
    },
    "keys": {
      "items": {
        "$ref": "#/$defs/ConditionKey"
      },
      "type": "array"
    },
    "next_cursor": {
      "anyOf": [
        {
          "$ref": "#/$defs/PageCursor"
        },
        {
          "type": "null"
        }
      ]
    },
    "origin": {
      "$ref": "#/$defs/Origin"
    },
    "rows": {
      "items": {
        "$ref": "#/$defs/ConditionsRow"
      },
      "type": "array"
    },
    "schema_version": {
      "$ref": "#/$defs/DatasetSchema"
    },
    "total_count": {
      "format": "uint64",
      "minimum": 0,
      "type": [
        "integer",
        "null"
      ]
    }
  },
  "required": [
    "schema_version",
    "keys",
    "rows",
    "origin"
  ],
  "title": "ConditionsTable",
  "type": "object"
}
