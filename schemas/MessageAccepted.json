{
  "$defs": {
    "EpisodeId": {
      "minLength": 1,
      "pattern": "^\\S+$",
      "type": "string"
    },
    "EventId": {
      "minLength": 1,
      "pattern": "^\\S+$",
      "type": "string"
    }
  },
  "$id": "ignis/2.1.0/MessageAccepted",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Answer of `POST /api/v1/episodes/{id}/messages` (202).",
  "properties": {
    "duplicate": {
      "description": "The key was seen before; nothing new was appended.",
      "type": "boolean"
    },
    "episode_id": {
      "$ref": "#/$defs/EpisodeId"
    },
    "event_id": {
      "$ref": "#/$defs/EventId"
    },
    "seq": {
      "format": "uint64",
      "minimum": 0,
      "type": "integer"
    }
  },
  "required": [
    "episode_id",
    "event_id",
    "seq",
    "duplicate"
  ],
  "title": "MessageAccepted",
  "type": "object"
}
