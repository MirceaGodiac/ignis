{
  "$defs": {
    "ArtifactId": {
      "minLength": 1,
      "pattern": "^\\S+$",
      "type": "string"
    },
    "ArtifactRef": {
      "additionalProperties": false,
      "description": "Reference to immutable bytes in the artifact store. Never a filesystem path or a URL: a download\nlink is resolved through the access service, may expire, and does not change the artifact.",
      "properties": {
        "artifact_id": {
          "$ref": "#/$defs/ArtifactId"
        },
        "byte_length": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "contract": {
          "description": "Exported contract type of the content when it is a JSON/JSONL contract document\n(`\"AnalysisArtifact\"`, `\"ResearchAnswer\"`, ...). Consumers dispatch on it.",
          "type": [
            "string",
            "null"
          ]
        },
        "created_at": {
          "$ref": "#/$defs/Timestamp"
        },
        "inputs": {
          "description": "Entities this artifact was computed from (lineage, not access grants).",
          "items": {
            "$ref": "#/$defs/EntityRef"
          },
          "type": "array"
        },
        "media_type": {
          "description": "IANA media type, e.g. `application/json`, `application/vnd.apache.parquet`, `image/png`.",
          "type": "string"
        },
        "origin": {
          "$ref": "#/$defs/Origin"
        },
        "produced_by": {
          "$ref": "#/$defs/Producer"
        },
        "sha256": {
          "$ref": "#/$defs/Digest"
        }
      },
      "required": [
        "artifact_id",
        "sha256",
        "media_type",
        "byte_length",
        "origin",
        "created_at"
      ],
      "type": "object"
    },
    "DatasetId": {
      "minLength": 1,
      "pattern": "^\\S+$",
      "type": "string"
    },
    "Digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "EntityRef": {
      "description": "A typed reference to any IGNIS entity, used for lineage and provenance links.",
      "oneOf": [
        {
          "properties": {
            "id": {
              "$ref": "#/$defs/SourceId"
            },
            "kind": {
              "const": "source",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "id"
          ],
          "type": "object"
        },
        {
          "properties": {
            "id": {
              "$ref": "#/$defs/EvidenceId"
            },
            "kind": {
              "const": "evidence",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "id"
          ],
          "type": "object"
        },
        {
          "properties": {
            "id": {
              "$ref": "#/$defs/RunId"
            },
            "kind": {
              "const": "run",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "id"
          ],
          "type": "object"
        },
        {
          "properties": {
            "id": {
              "$ref": "#/$defs/ObservationId"
            },
            "kind": {
              "const": "observation",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "id"
          ],
          "type": "object"
        },
        {
          "properties": {
            "id": {
              "$ref": "#/$defs/DatasetId"
            },
            "kind": {
              "const": "dataset",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "id"
          ],
          "type": "object"
        },
        {
          "properties": {
            "id": {
              "$ref": "#/$defs/ArtifactId"
            },
            "kind": {
              "const": "artifact",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "id"
          ],
          "type": "object"
        },
        {
          "properties": {
            "id": {
              "$ref": "#/$defs/ReleaseId"
            },
            "kind": {
              "const": "release",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "id"
          ],
          "type": "object"
        },
        {
          "properties": {
            "id": {
              "$ref": "#/$defs/WikiPageId"
            },
            "kind": {
              "const": "wiki_page",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "id"
          ],
          "type": "object"
        },
        {
          "properties": {
            "id": {
              "$ref": "#/$defs/EpisodeId"
            },
            "kind": {
              "const": "episode",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "id"
          ],
          "type": "object"
        }
      ]
    },
    "EpisodeId": {
      "minLength": 1,
      "pattern": "^\\S+$",
      "type": "string"
    },
    "ErrorCode": {
      "description": "Technical failure classes. Scientific outcomes (insufficient evidence, out of domain) are *not*\nerrors; they are `ScientificStatus` values of a completed call.",
      "oneOf": [
        {
          "enum": [
            "invalid_request",
            "scope_denied",
            "not_found",
            "unsupported",
            "conflict",
            "rate_limited",
            "upstream_unavailable",
            "cancelled",
            "internal"
          ],
          "type": "string"
        },
        {
          "const": "source_missing",
          "description": "A referenced source/asset is not materialized (listing or metadata only).",
          "type": "string"
        },
        {
          "const": "capability_unavailable",
          "description": "A required service or backend is not available in this deployment.",
          "type": "string"
        }
      ]
    },
    "ErrorEnvelope": {
      "additionalProperties": false,
      "description": "The one error shape of services, tools, jobs and the HTTP API.",
      "properties": {
        "code": {
          "$ref": "#/$defs/ErrorCode"
        },
        "log_ref": {
          "anyOf": [
            {
              "$ref": "#/$defs/ArtifactId"
            },
            {
              "type": "null"
            }
          ],
          "description": "Redacted log artifact, when one exists."
        },
        "message": {
          "type": "string"
        },
        "retry": {
          "$ref": "#/$defs/RetryPolicy"
        }
      },
      "required": [
        "code",
        "message",
        "retry"
      ],
      "type": "object"
    },
    "EvidenceId": {
      "minLength": 1,
      "pattern": "^\\S+$",
      "type": "string"
    },
    "ExecutionStatus": {
      "description": "Did the call run? Independent of what it found.",
      "oneOf": [
        {
          "enum": [
            "completed",
            "cancelled"
          ],
          "type": "string"
        },
        {
          "const": "accepted",
          "description": "Long work started; follow `job`.",
          "type": "string"
        },
        {
          "const": "refused",
          "description": "The host or service declined (scope, invalid input, unsupported).",
          "type": "string"
        },
        {
          "const": "failed",
          "description": "Technical failure.",
          "type": "string"
        }
      ]
    },
    "InlinePayload": {
      "additionalProperties": false,
      "description": "Inline content returned together with (or instead of) a full artifact. `partial = true` means\nthis is a preview: the complete content is `full`, and nobody may treat the preview as the result.",
      "properties": {
        "full": {
          "anyOf": [
            {
              "$ref": "#/$defs/ArtifactRef"
            },
            {
              "type": "null"
            }
          ]
        },
        "partial": {
          "type": "boolean"
        },
        "value": true
      },
      "required": [
        "value",
        "partial"
      ],
      "type": "object"
    },
    "JobId": {
      "minLength": 1,
      "pattern": "^\\S+$",
      "type": "string"
    },
    "JobProgress": {
      "additionalProperties": false,
      "properties": {
        "completed": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "total": {
          "description": "Unknown totals stay unknown.",
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "unit": {
          "type": "string"
        }
      },
      "required": [
        "completed",
        "unit"
      ],
      "type": "object"
    },
    "JobRef": {
      "additionalProperties": false,
      "properties": {
        "error": {
          "anyOf": [
            {
              "$ref": "#/$defs/ErrorEnvelope"
            },
            {
              "type": "null"
            }
          ]
        },
        "job_id": {
          "$ref": "#/$defs/JobId"
        },
        "kind": {
          "description": "Operation name, e.g. `models_forecast`, `analysis_execute`.",
          "type": "string"
        },
        "outputs": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ArtifactRef"
          },
          "type": "array"
        },
        "progress": {
          "anyOf": [
            {
              "$ref": "#/$defs/JobProgress"
            },
            {
              "type": "null"
            }
          ]
        },
        "status": {
          "$ref": "#/$defs/JobStatus"
        },
        "submitted_at": {
          "$ref": "#/$defs/Timestamp"
        },
        "updated_at": {
          "$ref": "#/$defs/Timestamp"
        }
      },
      "required": [
        "job_id",
        "kind",
        "status",
        "submitted_at",
        "updated_at"
      ],
      "type": "object"
    },
    "JobStatus": {
      "description": "Public job state. Leases, fencing tokens and the scheduler stay internal.",
      "oneOf": [
        {
          "enum": [
            "queued",
            "running",
            "succeeded",
            "failed",
            "cancelled"
          ],
          "type": "string"
        },
        {
          "const": "cancel_requested",
          "description": "Cancellation asked; the work may still be running.",
          "type": "string"
        },
        {
          "const": "reconciling",
          "description": "The effect of an interrupted attempt is uncertain and is being reconciled. Not `failed`, and\nnot re-run blindly.",
          "type": "string"
        }
      ]
    },
    "ObservationId": {
      "minLength": 1,
      "pattern": "^\\S+$",
      "type": "string"
    },
    "Origin": {
      "description": "Who produced a payload. `synthetic_fixture` marks hand-made contract examples; such payloads (and\nanything computed from them) can never be presented as NASA results or qualify a model.\nProduced-by-the-system payloads are `system` even when their *data* is synthetic (that is\n`EvidenceClass::Synthetic` / `TrainedOn::Synthetic`).",
      "enum": [
        "system",
        "synthetic_fixture"
      ],
      "type": "string"
    },
    "Producer": {
      "additionalProperties": false,
      "description": "What produced an artifact (all optional: an ingestion artifact has no episode).",
      "properties": {
        "episode_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/EpisodeId"
            },
            {
              "type": "null"
            }
          ]
        },
        "job_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/JobId"
            },
            {
              "type": "null"
            }
          ]
        },
        "release_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/ReleaseId"
            },
            {
              "type": "null"
            }
          ]
        },
        "tool_call_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/ToolCallId"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "type": "object"
    },
    "ReleaseId": {
      "minLength": 1,
      "pattern": "^\\S+$",
      "type": "string"
    },
    "RetryPolicy": {
      "description": "What a caller may do after an error. `reconcile` means the effect is uncertain: inspect state\nbefore any retry, never re-run blindly.",
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "never",
              "type": "string"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "after_delay",
              "type": "string"
            },
            "seconds": {
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            }
          },
          "required": [
            "kind",
            "seconds"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "after_user_action",
              "type": "string"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "reconcile",
              "type": "string"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        }
      ]
    },
    "RunId": {
      "minLength": 1,
      "pattern": "^\\S+$",
      "type": "string"
    },
    "ScientificStatus": {
      "description": "What a completed call established. `insufficient_evidence` and `out_of_domain` are valid\nscientific conclusions of a successful execution, not errors.",
      "enum": [
        "not_assessed",
        "conclusive",
        "inconclusive",
        "insufficient_evidence",
        "out_of_domain"
      ],
      "type": "string"
    },
    "SourceId": {
      "minLength": 1,
      "pattern": "^\\S+$",
      "type": "string"
    },
    "Timestamp": {
      "format": "date-time",
      "pattern": "Z$",
      "type": "string"
    },
    "ToolCallId": {
      "minLength": 1,
      "pattern": "^\\S+$",
      "type": "string"
    },
    "ToolsSchema": {
      "description": "Wire tag of tool results and descriptors.",
      "enum": [
        "tools.v1"
      ],
      "type": "string"
    },
    "WikiPageId": {
      "minLength": 1,
      "pattern": "^\\S+$",
      "type": "string"
    }
  },
  "$id": "ignis/2.1.0/ToolResult",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Result envelope of every IGNIS tool (MCP or internal).",
  "properties": {
    "artifact_refs": {
      "default": [],
      "items": {
        "$ref": "#/$defs/ArtifactRef"
      },
      "type": "array"
    },
    "call_id": {
      "$ref": "#/$defs/ToolCallId"
    },
    "error": {
      "anyOf": [
        {
          "$ref": "#/$defs/ErrorEnvelope"
        },
        {
          "type": "null"
        }
      ]
    },
    "execution_status": {
      "$ref": "#/$defs/ExecutionStatus"
    },
    "job": {
      "anyOf": [
        {
          "$ref": "#/$defs/JobRef"
        },
        {
          "type": "null"
        }
      ]
    },
    "origin": {
      "$ref": "#/$defs/Origin"
    },
    "result": {
      "anyOf": [
        {
          "$ref": "#/$defs/InlinePayload"
        },
        {
          "type": "null"
        }
      ]
    },
    "schema_version": {
      "$ref": "#/$defs/ToolsSchema"
    },
    "scientific_status": {
      "$ref": "#/$defs/ScientificStatus"
    },
    "tool": {
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "call_id",
    "tool",
    "execution_status",
    "scientific_status",
    "origin"
  ],
  "title": "ToolResult",
  "type": "object"
}
