{
  "$defs": {
    "ArtifactId": {
      "minLength": 1,
      "pattern": "^\\S+$",
      "type": "string"
    },
    "Author": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/AuthorKind"
        }
      },
      "required": [
        "kind",
        "id"
      ],
      "type": "object"
    },
    "AuthorKind": {
      "enum": [
        "agent",
        "human"
      ],
      "type": "string"
    },
    "ConceptId": {
      "minLength": 1,
      "pattern": "^\\S+$",
      "type": "string"
    },
    "ConceptKind": {
      "description": "Kind of a domain concept of the combustion graph. Concepts are vocabulary nodes (an\ninvestigation, a fuel, a piece of hardware); records (sources, runs, artifacts) are\n[`EntityRef`]s.",
      "oneOf": [
        {
          "enum": [
            "fuel",
            "sample_geometry"
          ],
          "type": "string"
        },
        {
          "const": "investigation",
          "description": "A PSI investigation (`id` = its accession, e.g. `PSI-69`) or a ground investigation.",
          "type": "string"
        },
        {
          "const": "hardware",
          "description": "Flight or ground hardware (CIR/MDCA, MSG/SPICE duct, an ACME module).",
          "type": "string"
        },
        {
          "const": "condition",
          "description": "A controlled condition (oxygen mole fraction, pressure, flow, gravity level).",
          "type": "string"
        },
        {
          "const": "diagnostic",
          "description": "An instrument or measurement method (camera, radiometer, thermocouple).",
          "type": "string"
        },
        {
          "const": "observable",
          "description": "A measured quantity of interest (extinction diameter, spread rate, burning rate).",
          "type": "string"
        }
      ]
    },
    "ConceptRef": {
      "additionalProperties": false,
      "properties": {
        "concept": {
          "$ref": "#/$defs/ConceptKind"
        },
        "id": {
          "$ref": "#/$defs/ConceptId"
        }
      },
      "required": [
        "concept",
        "id"
      ],
      "type": "object"
    },
    "DatasetId": {
      "minLength": 1,
      "pattern": "^\\S+$",
      "type": "string"
    },
    "Digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "EntityRef": {
      "description": "A typed reference to any IGNIS entity, used for lineage and provenance links.",
      "oneOf": [
        {
          "properties": {
            "id": {
              "$ref": "#/$defs/SourceId"
            },
            "kind": {
              "const": "source",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "id"
          ],
          "type": "object"
        },
        {
          "properties": {
            "id": {
              "$ref": "#/$defs/EvidenceId"
            },
            "kind": {
              "const": "evidence",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "id"
          ],
          "type": "object"
        },
        {
          "properties": {
            "id": {
              "$ref": "#/$defs/RunId"
            },
            "kind": {
              "const": "run",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "id"
          ],
          "type": "object"
        },
        {
          "properties": {
            "id": {
              "$ref": "#/$defs/ObservationId"
            },
            "kind": {
              "const": "observation",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "id"
          ],
          "type": "object"
        },
        {
          "properties": {
            "id": {
              "$ref": "#/$defs/DatasetId"
            },
            "kind": {
              "const": "dataset",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "id"
          ],
          "type": "object"
        },
        {
          "properties": {
            "id": {
              "$ref": "#/$defs/ArtifactId"
            },
            "kind": {
              "const": "artifact",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "id"
          ],
          "type": "object"
        },
        {
          "properties": {
            "id": {
              "$ref": "#/$defs/ReleaseId"
            },
            "kind": {
              "const": "release",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "id"
          ],
          "type": "object"
        },
        {
          "properties": {
            "id": {
              "$ref": "#/$defs/WikiPageId"
            },
            "kind": {
              "const": "wiki_page",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "id"
          ],
          "type": "object"
        },
        {
          "properties": {
            "id": {
              "$ref": "#/$defs/EpisodeId"
            },
            "kind": {
              "const": "episode",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "id"
          ],
          "type": "object"
        }
      ]
    },
    "EpisodeId": {
      "minLength": 1,
      "pattern": "^\\S+$",
      "type": "string"
    },
    "EvidenceId": {
      "minLength": 1,
      "pattern": "^\\S+$",
      "type": "string"
    },
    "EvidenceSchema": {
      "description": "Wire tag of the knowledge documents. Wave K1 writes `evidence.v2`; `evidence.v1` (C0) documents\nare still read. An addition of v2 (a field, a relation, a concept node, a new document type) is\nrefused under the v1 tag, so a v1 reader never receives a document it would misread.",
      "oneOf": [
        {
          "enum": [
            "evidence.v2"
          ],
          "type": "string"
        },
        {
          "const": "evidence.v1",
          "description": "C0. Still read; new documents are written as v2.",
          "type": "string"
        }
      ]
    },
    "GraphNode": {
      "anyOf": [
        {
          "$ref": "#/$defs/EntityRef"
        },
        {
          "$ref": "#/$defs/ConceptRef"
        }
      ],
      "description": "A graph node: an IGNIS record ([`EntityRef`], wire `{kind, id}`) or a domain concept\n([`ConceptRef`], wire `{concept, id}`). A v1 link endpoint (always an `EntityRef`) reads\nunchanged. Passages, figures and tables are `EntityRef::Evidence`; analyses are artifacts."
    },
    "ObservationId": {
      "minLength": 1,
      "pattern": "^\\S+$",
      "type": "string"
    },
    "Origin": {
      "description": "Who produced a payload. `synthetic_fixture` marks hand-made contract examples; such payloads (and\nanything computed from them) can never be presented as NASA results or qualify a model.\nProduced-by-the-system payloads are `system` even when their *data* is synthetic (that is\n`EvidenceClass::Synthetic` / `TrainedOn::Synthetic`).",
      "enum": [
        "system",
        "synthetic_fixture"
      ],
      "type": "string"
    },
    "Partition": {
      "description": "Partition of a frozen split. `Test` is the lockbox: only an evaluation scope may read it.",
      "enum": [
        "train",
        "validation",
        "test"
      ],
      "type": "string"
    },
    "ReleaseId": {
      "minLength": 1,
      "pattern": "^\\S+$",
      "type": "string"
    },
    "RunId": {
      "minLength": 1,
      "pattern": "^\\S+$",
      "type": "string"
    },
    "SourceId": {
      "minLength": 1,
      "pattern": "^\\S+$",
      "type": "string"
    },
    "Timestamp": {
      "format": "date-time",
      "pattern": "Z$",
      "type": "string"
    },
    "WikiEntry": {
      "additionalProperties": false,
      "description": "An item as stored in a revision, with the access the host derived for it.",
      "properties": {
        "item_id": {
          "$ref": "#/$defs/WikiItemId"
        },
        "kind": {
          "$ref": "#/$defs/WikiItemKind"
        },
        "refs": {
          "items": {
            "$ref": "#/$defs/GraphNode"
          },
          "type": "array"
        },
        "requires_partitions": {
          "description": "Partitions whose outcomes the item was written under (from the writing scope, never from\nthe author). A reader needs every one of them: summarizing does not launder a restriction.",
          "items": {
            "$ref": "#/$defs/Partition"
          },
          "type": "array",
          "uniqueItems": true
        },
        "text": {
          "type": "string"
        }
      },
      "required": [
        "item_id",
        "kind",
        "text"
      ],
      "type": "object"
    },
    "WikiItem": {
      "additionalProperties": false,
      "description": "One itemized entry of a page. Pages change by item deltas, never by rewriting the page, so an\nedit cannot silently drop what it did not mean to touch.",
      "properties": {
        "item_id": {
          "$ref": "#/$defs/WikiItemId"
        },
        "kind": {
          "$ref": "#/$defs/WikiItemKind"
        },
        "refs": {
          "description": "Sources, passages, artifacts, runs or concepts the item rests on.",
          "items": {
            "$ref": "#/$defs/GraphNode"
          },
          "type": "array"
        },
        "text": {
          "description": "Markdown.",
          "type": "string"
        }
      },
      "required": [
        "item_id",
        "kind",
        "text"
      ],
      "type": "object"
    },
    "WikiItemId": {
      "minLength": 1,
      "pattern": "^\\S+$",
      "type": "string"
    },
    "WikiItemKind": {
      "enum": [
        "concept",
        "method",
        "protocol",
        "hypothesis",
        "calculation",
        "contradiction",
        "open_question",
        "lesson",
        "note"
      ],
      "type": "string"
    },
    "WikiOp": {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "item": {
              "$ref": "#/$defs/WikiItem"
            },
            "op": {
              "const": "add",
              "type": "string"
            }
          },
          "required": [
            "op",
            "item"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "New content for an existing item (same id).",
          "properties": {
            "item": {
              "$ref": "#/$defs/WikiItem"
            },
            "op": {
              "const": "revise",
              "type": "string"
            }
          },
          "required": [
            "op",
            "item"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "item_id": {
              "$ref": "#/$defs/WikiItemId"
            },
            "op": {
              "const": "remove",
              "type": "string"
            },
            "reason": {
              "type": "string"
            }
          },
          "required": [
            "op",
            "item_id",
            "reason"
          ],
          "type": "object"
        }
      ]
    },
    "WikiPageId": {
      "minLength": 1,
      "pattern": "^\\S+$",
      "type": "string"
    }
  },
  "$id": "ignis/2.1.0/WikiRevision",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "An immutable wiki revision: the full item list after `ops`, content-addressed by\n`content_digest`. The wiki is research memory with references; it is never a primary source\nand is not indexed as one.",
  "properties": {
    "author": {
      "$ref": "#/$defs/Author"
    },
    "content_digest": {
      "$ref": "#/$defs/Digest",
      "description": "[`WikiRevision::digest_of`] of `title` and `items`."
    },
    "created_at": {
      "$ref": "#/$defs/Timestamp"
    },
    "episode_id": {
      "anyOf": [
        {
          "$ref": "#/$defs/EpisodeId"
        },
        {
          "type": "null"
        }
      ]
    },
    "items": {
      "items": {
        "$ref": "#/$defs/WikiEntry"
      },
      "type": "array"
    },
    "ops": {
      "description": "The delta that produced this revision from its parent.",
      "items": {
        "$ref": "#/$defs/WikiOp"
      },
      "type": "array"
    },
    "origin": {
      "$ref": "#/$defs/Origin"
    },
    "page_id": {
      "$ref": "#/$defs/WikiPageId"
    },
    "parent_revision": {
      "format": "uint64",
      "minimum": 0,
      "type": [
        "integer",
        "null"
      ]
    },
    "revision": {
      "format": "uint64",
      "minimum": 0,
      "type": "integer"
    },
    "schema_version": {
      "$ref": "#/$defs/EvidenceSchema"
    },
    "title": {
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "page_id",
    "revision",
    "title",
    "items",
    "ops",
    "content_digest",
    "author",
    "created_at",
    "origin"
  ],
  "title": "WikiRevision",
  "type": "object"
}
