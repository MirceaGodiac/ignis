{
  "$defs": {
    "AuthorModel": {
      "additionalProperties": false,
      "description": "Model that wrote a patch: provider and the exact model id actually used (not a marketing name).",
      "properties": {
        "effort": {
          "type": [
            "string",
            "null"
          ]
        },
        "model_id": {
          "type": "string"
        },
        "provider": {
          "type": "string"
        }
      },
      "required": [
        "provider",
        "model_id"
      ],
      "type": "object"
    },
    "DataExposure": {
      "additionalProperties": false,
      "description": "Everything the author saw. Development feedback and other candidates are listed, so W0 (no\nfeedback) and W1 (feedback) stay distinguishable. The test partition never appears here.",
      "properties": {
        "datasets": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ExposedDataset"
          },
          "type": "array"
        },
        "development_feedback": {
          "default": [],
          "description": "Development `EvaluationResult`s shown to the author.",
          "items": {
            "$ref": "#/$defs/EvaluationId"
          },
          "type": "array"
        },
        "prior_candidates": {
          "default": [],
          "description": "Other candidates (e.g. the other author's) shown to the author.",
          "items": {
            "$ref": "#/$defs/ReleaseId"
          },
          "type": "array"
        },
        "sources": {
          "default": [],
          "items": {
            "$ref": "#/$defs/SourceId"
          },
          "type": "array"
        }
      },
      "type": "object"
    },
    "DatasetId": {
      "minLength": 1,
      "pattern": "^\\S+$",
      "type": "string"
    },
    "Digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "EvaluationId": {
      "minLength": 1,
      "pattern": "^\\S+$",
      "type": "string"
    },
    "ExposedDataset": {
      "additionalProperties": false,
      "properties": {
        "dataset_id": {
          "$ref": "#/$defs/DatasetId"
        },
        "partitions": {
          "items": {
            "$ref": "#/$defs/Partition"
          },
          "type": "array",
          "uniqueItems": true
        }
      },
      "required": [
        "dataset_id",
        "partitions"
      ],
      "type": "object"
    },
    "LiteralOp": {
      "description": "One literal assignment. Boxes are `start` + `shape` per dimension (half-open), values row-major.",
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "index": {
              "items": {
                "format": "uint32",
                "minimum": 0,
                "type": "integer"
              },
              "type": "array"
            },
            "op": {
              "const": "set",
              "type": "string"
            },
            "tensor": {
              "type": "string"
            },
            "value": {
              "type": "number"
            }
          },
          "required": [
            "op",
            "tensor",
            "index",
            "value"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "op": {
              "const": "set_box",
              "type": "string"
            },
            "shape": {
              "items": {
                "format": "uint32",
                "minimum": 0,
                "type": "integer"
              },
              "type": "array"
            },
            "start": {
              "items": {
                "format": "uint32",
                "minimum": 0,
                "type": "integer"
              },
              "type": "array"
            },
            "tensor": {
              "type": "string"
            },
            "values": {
              "items": {
                "type": "number"
              },
              "type": "array"
            }
          },
          "required": [
            "op",
            "tensor",
            "start",
            "shape",
            "values"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "op": {
              "const": "fill_box",
              "type": "string"
            },
            "shape": {
              "items": {
                "format": "uint32",
                "minimum": 0,
                "type": "integer"
              },
              "type": "array"
            },
            "start": {
              "items": {
                "format": "uint32",
                "minimum": 0,
                "type": "integer"
              },
              "type": "array"
            },
            "tensor": {
              "type": "string"
            },
            "value": {
              "type": "number"
            }
          },
          "required": [
            "op",
            "tensor",
            "start",
            "shape",
            "value"
          ],
          "type": "object"
        }
      ]
    },
    "Origin": {
      "description": "Who produced a payload. `synthetic_fixture` marks hand-made contract examples; such payloads (and\nanything computed from them) can never be presented as NASA results or qualify a model.\nProduced-by-the-system payloads are `system` even when their *data* is synthetic (that is\n`EvidenceClass::Synthetic` / `TrainedOn::Synthetic`).",
      "enum": [
        "system",
        "synthetic_fixture"
      ],
      "type": "string"
    },
    "Partition": {
      "description": "Partition of a frozen split. `Test` is the lockbox: only an evaluation scope may read it.",
      "enum": [
        "train",
        "validation",
        "test"
      ],
      "type": "string"
    },
    "PatchId": {
      "minLength": 1,
      "pattern": "^\\S+$",
      "type": "string"
    },
    "ReleaseId": {
      "minLength": 1,
      "pattern": "^\\S+$",
      "type": "string"
    },
    "SourceId": {
      "minLength": 1,
      "pattern": "^\\S+$",
      "type": "string"
    },
    "WspSchema": {
      "description": "Wire tag of model specs, patches, build manifests and forecast requests.",
      "enum": [
        "wsp.v1"
      ],
      "type": "string"
    }
  },
  "$id": "ignis/2.1.0/HandwrittenWeightPatch",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "The literal output of an author model for one spec: parent (for W1 revisions), author, exposure\nand the assignments. Within one patch every element is written at most once; overwriting a\nparent's value is what a revision does.",
  "properties": {
    "author": {
      "$ref": "#/$defs/AuthorModel"
    },
    "exposure": {
      "$ref": "#/$defs/DataExposure"
    },
    "ops": {
      "items": {
        "$ref": "#/$defs/LiteralOp"
      },
      "type": "array"
    },
    "origin": {
      "$ref": "#/$defs/Origin"
    },
    "parent_release_id": {
      "anyOf": [
        {
          "$ref": "#/$defs/ReleaseId"
        },
        {
          "type": "null"
        }
      ]
    },
    "patch_id": {
      "$ref": "#/$defs/PatchId"
    },
    "rationale": {
      "description": "Public explanation of the roles of neurons/blocks (not private reasoning).",
      "type": [
        "string",
        "null"
      ]
    },
    "schema_version": {
      "$ref": "#/$defs/WspSchema"
    },
    "spec_hash": {
      "$ref": "#/$defs/Digest"
    }
  },
  "required": [
    "schema_version",
    "patch_id",
    "spec_hash",
    "author",
    "exposure",
    "ops",
    "origin"
  ],
  "title": "HandwrittenWeightPatch",
  "type": "object"
}
