{
  "$defs": {
    "CorpusSnapshotId": {
      "minLength": 1,
      "pattern": "^\\S+$",
      "type": "string"
    },
    "EvidenceSchema": {
      "description": "Wire tag of the knowledge documents. Wave K1 writes `evidence.v2`; `evidence.v1` (C0) documents\nare still read. An addition of v2 (a field, a relation, a concept node, a new document type) is\nrefused under the v1 tag, so a v1 reader never receives a document it would misread.",
      "oneOf": [
        {
          "enum": [
            "evidence.v2"
          ],
          "type": "string"
        },
        {
          "const": "evidence.v1",
          "description": "C0. Still read; new documents are written as v2.",
          "type": "string"
        }
      ]
    },
    "ExpectedTerm": {
      "additionalProperties": false,
      "description": "One expected term of a [`SearchRequest`] and how important the caller thinks it is.",
      "properties": {
        "importance": {
          "anyOf": [
            {
              "$ref": "#/$defs/TermImportance"
            },
            {
              "type": "null"
            }
          ]
        },
        "term": {
          "type": "string"
        }
      },
      "required": [
        "term"
      ],
      "type": "object"
    },
    "Family": {
      "enum": [
        "flex",
        "acme_normal",
        "acme_inverse",
        "bass",
        "other"
      ],
      "type": "string"
    },
    "PageCursor": {
      "minLength": 1,
      "pattern": "^\\S+$",
      "type": "string"
    },
    "ResponseFormat": {
      "description": "How much a search or read returns per item: `concise` keeps ids, locators and short text for\nscanning, `detailed` adds scores, full quotes and context. Absent = the service default. It\nchanges the size of each item, never which items match or their order.",
      "enum": [
        "concise",
        "detailed"
      ],
      "type": "string"
    },
    "SearchFilters": {
      "additionalProperties": false,
      "properties": {
        "families": {
          "items": {
            "$ref": "#/$defs/Family"
          },
          "type": "array"
        },
        "investigation_ids": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "source_ids": {
          "items": {
            "$ref": "#/$defs/SourceId"
          },
          "type": "array"
        },
        "source_kinds": {
          "items": {
            "$ref": "#/$defs/SourceKind"
          },
          "type": "array"
        }
      },
      "type": "object"
    },
    "SearchMode": {
      "enum": [
        "hybrid",
        "lexical",
        "dense"
      ],
      "type": "string"
    },
    "SourceId": {
      "minLength": 1,
      "pattern": "^\\S+$",
      "type": "string"
    },
    "SourceKind": {
      "enum": [
        "dataset_file",
        "publication",
        "video",
        "protocol",
        "calibration",
        "webpage",
        "archive"
      ],
      "type": "string"
    },
    "TermImportance": {
      "enum": [
        "high",
        "medium",
        "low"
      ],
      "type": "string"
    }
  },
  "$id": "ignis/2.1.0/SearchRequest",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "A search. The access scope is not here: the host passes it to the service separately.",
  "properties": {
    "corpus_snapshot": {
      "anyOf": [
        {
          "$ref": "#/$defs/CorpusSnapshotId"
        },
        {
          "type": "null"
        }
      ],
      "description": "Defaults to the snapshot pinned by the scope/episode."
    },
    "cursor": {
      "anyOf": [
        {
          "$ref": "#/$defs/PageCursor"
        },
        {
          "type": "null"
        }
      ]
    },
    "expected_terms": {
      "description": "v2. SIRA query expansion (LANES_V2 R12a): concepts, equivalent phrasings and discriminative\nterms a relevant passage would contain, never a guessed answer. The service keeps those the\ncorpus holds, rarest first, and adds them to the lexical score with IDF weights; the page\nreports which ones it kept.",
      "items": {
        "$ref": "#/$defs/ExpectedTerm"
      },
      "type": "array"
    },
    "filters": {
      "$ref": "#/$defs/SearchFilters",
      "default": {}
    },
    "mode": {
      "$ref": "#/$defs/SearchMode",
      "default": "hybrid"
    },
    "page_size": {
      "description": "Requested page size; the service may return fewer and pages on with `next_cursor`.",
      "format": "uint32",
      "minimum": 0,
      "type": [
        "integer",
        "null"
      ]
    },
    "query": {
      "type": "string"
    },
    "response_format": {
      "anyOf": [
        {
          "$ref": "#/$defs/ResponseFormat"
        },
        {
          "type": "null"
        }
      ],
      "description": "v2."
    },
    "schema_version": {
      "$ref": "#/$defs/EvidenceSchema",
      "default": "evidence.v2"
    }
  },
  "required": [
    "query"
  ],
  "title": "SearchRequest",
  "type": "object"
}
