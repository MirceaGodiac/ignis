{
  "$defs": {
    "AnswerBlock": {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "claim_ids": {
              "default": [],
              "items": {
                "$ref": "#/$defs/ClaimId"
              },
              "type": "array"
            },
            "text": {
              "type": "string"
            },
            "type": {
              "const": "text",
              "type": "string"
            }
          },
          "required": [
            "type",
            "text"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "artifact_id": {
              "$ref": "#/$defs/ArtifactId"
            },
            "caption": {
              "type": [
                "string",
                "null"
              ]
            },
            "type": {
              "const": "artifact",
              "type": "string"
            }
          },
          "required": [
            "type",
            "artifact_id"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "v2: a component from the closed view catalog, bound to the claims it illustrates.",
          "properties": {
            "caption": {
              "type": [
                "string",
                "null"
              ]
            },
            "claim_ids": {
              "default": [],
              "items": {
                "$ref": "#/$defs/ClaimId"
              },
              "type": "array"
            },
            "type": {
              "const": "view",
              "type": "string"
            },
            "view": {
              "$ref": "#/$defs/ViewSpec"
            }
          },
          "required": [
            "type",
            "view"
          ],
          "type": "object"
        }
      ]
    },
    "AnswerId": {
      "minLength": 1,
      "pattern": "^\\S+$",
      "type": "string"
    },
    "AnswerStatus": {
      "oneOf": [
        {
          "enum": [
            "complete",
            "partial",
            "failed"
          ],
          "type": "string"
        },
        {
          "const": "insufficient_evidence",
          "description": "A useful conclusion: the data to answer does not exist (yet), and the answer says what is missing.",
          "type": "string"
        }
      ]
    },
    "ArtifactId": {
      "minLength": 1,
      "pattern": "^\\S+$",
      "type": "string"
    },
    "ArtifactRef": {
      "additionalProperties": false,
      "description": "Reference to immutable bytes in the artifact store. Never a filesystem path or a URL: a download\nlink is resolved through the access service, may expire, and does not change the artifact.",
      "properties": {
        "artifact_id": {
          "$ref": "#/$defs/ArtifactId"
        },
        "byte_length": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "contract": {
          "description": "Exported contract type of the content when it is a JSON/JSONL contract document\n(`\"AnalysisArtifact\"`, `\"ResearchAnswer\"`, ...). Consumers dispatch on it.",
          "type": [
            "string",
            "null"
          ]
        },
        "created_at": {
          "$ref": "#/$defs/Timestamp"
        },
        "inputs": {
          "description": "Entities this artifact was computed from (lineage, not access grants).",
          "items": {
            "$ref": "#/$defs/EntityRef"
          },
          "type": "array"
        },
        "media_type": {
          "description": "IANA media type, e.g. `application/json`, `application/vnd.apache.parquet`, `image/png`.",
          "type": "string"
        },
        "origin": {
          "$ref": "#/$defs/Origin"
        },
        "produced_by": {
          "$ref": "#/$defs/Producer"
        },
        "sha256": {
          "$ref": "#/$defs/Digest"
        }
      },
      "required": [
        "artifact_id",
        "sha256",
        "media_type",
        "byte_length",
        "origin",
        "created_at"
      ],
      "type": "object"
    },
    "Claim": {
      "additionalProperties": false,
      "properties": {
        "checked_by": {
          "anyOf": [
            {
              "$ref": "#/$defs/SupportCheck"
            },
            {
              "type": "null"
            }
          ],
          "description": "v2: how the support was checked, when it was."
        },
        "claim_id": {
          "$ref": "#/$defs/ClaimId"
        },
        "kind": {
          "$ref": "#/$defs/ClaimKind"
        },
        "support": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ClaimSupport"
          },
          "type": "array"
        },
        "text": {
          "type": "string"
        }
      },
      "required": [
        "claim_id",
        "kind",
        "text"
      ],
      "type": "object"
    },
    "ClaimId": {
      "minLength": 1,
      "pattern": "^\\S+$",
      "type": "string"
    },
    "ClaimKind": {
      "description": "What a claim asserts. The kind fixes what may support it, so a prediction cannot be reported as\na measurement and a computed value cannot be cited to prose.",
      "oneOf": [
        {
          "const": "source_reports",
          "description": "\"Paper X reports ...\" (evidence).",
          "type": "string"
        },
        {
          "const": "observed",
          "description": "A measured value (evidence of class original_observation or source_derived).",
          "type": "string"
        },
        {
          "const": "computed",
          "description": "Computed by IGNIS (an artifact value).",
          "type": "string"
        },
        {
          "const": "predicted",
          "description": "A model prediction (a value in an `AnalysisArtifact`).",
          "type": "string"
        },
        {
          "const": "interpretation",
          "description": "The agent's interpretation; may cite anything or nothing.",
          "type": "string"
        }
      ]
    },
    "ClaimSupport": {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "evidence_id": {
              "$ref": "#/$defs/EvidenceId"
            },
            "kind": {
              "const": "evidence",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "evidence_id"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "A value inside an artifact, addressed by an RFC 6901 JSON Pointer, so numbers in the text are\nbound to the computed field instead of being transcribed.",
          "properties": {
            "artifact_id": {
              "$ref": "#/$defs/ArtifactId"
            },
            "kind": {
              "const": "artifact_value",
              "type": "string"
            },
            "pointer": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "artifact_id",
            "pointer"
          ],
          "type": "object"
        }
      ]
    },
    "DatasetId": {
      "minLength": 1,
      "pattern": "^\\S+$",
      "type": "string"
    },
    "Digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "EntityRef": {
      "description": "A typed reference to any IGNIS entity, used for lineage and provenance links.",
      "oneOf": [
        {
          "properties": {
            "id": {
              "$ref": "#/$defs/SourceId"
            },
            "kind": {
              "const": "source",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "id"
          ],
          "type": "object"
        },
        {
          "properties": {
            "id": {
              "$ref": "#/$defs/EvidenceId"
            },
            "kind": {
              "const": "evidence",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "id"
          ],
          "type": "object"
        },
        {
          "properties": {
            "id": {
              "$ref": "#/$defs/RunId"
            },
            "kind": {
              "const": "run",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "id"
          ],
          "type": "object"
        },
        {
          "properties": {
            "id": {
              "$ref": "#/$defs/ObservationId"
            },
            "kind": {
              "const": "observation",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "id"
          ],
          "type": "object"
        },
        {
          "properties": {
            "id": {
              "$ref": "#/$defs/DatasetId"
            },
            "kind": {
              "const": "dataset",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "id"
          ],
          "type": "object"
        },
        {
          "properties": {
            "id": {
              "$ref": "#/$defs/ArtifactId"
            },
            "kind": {
              "const": "artifact",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "id"
          ],
          "type": "object"
        },
        {
          "properties": {
            "id": {
              "$ref": "#/$defs/ReleaseId"
            },
            "kind": {
              "const": "release",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "id"
          ],
          "type": "object"
        },
        {
          "properties": {
            "id": {
              "$ref": "#/$defs/WikiPageId"
            },
            "kind": {
              "const": "wiki_page",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "id"
          ],
          "type": "object"
        },
        {
          "properties": {
            "id": {
              "$ref": "#/$defs/EpisodeId"
            },
            "kind": {
              "const": "episode",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "id"
          ],
          "type": "object"
        }
      ]
    },
    "EpisodeId": {
      "minLength": 1,
      "pattern": "^\\S+$",
      "type": "string"
    },
    "EvidenceClass": {
      "enum": [
        "original_observation",
        "source_derived",
        "ignis_derived",
        "model_output",
        "synthetic"
      ],
      "type": "string"
    },
    "EvidenceId": {
      "minLength": 1,
      "pattern": "^\\S+$",
      "type": "string"
    },
    "EvidenceRef": {
      "additionalProperties": false,
      "description": "A citable pointer into one source version. Verifiable only against that version's asset and\nparse view. Holding an `EvidenceRef` grants no access to restricted originals.",
      "properties": {
        "evidence_class": {
          "$ref": "#/$defs/EvidenceClass"
        },
        "evidence_id": {
          "$ref": "#/$defs/EvidenceId"
        },
        "locator": {
          "anyOf": [
            {
              "$ref": "#/$defs/SourceLocator"
            },
            {
              "type": "null"
            }
          ],
          "description": "Absent for a metadata-only citation (bytes not obtained: listing or access-gated record)."
        },
        "origin": {
          "$ref": "#/$defs/Origin"
        },
        "parse_view_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/ParseViewId"
            },
            {
              "type": "null"
            }
          ]
        },
        "quote": {
          "description": "Exact citable text from the parse view (not the normalized index text).",
          "type": [
            "string",
            "null"
          ]
        },
        "source_id": {
          "$ref": "#/$defs/SourceId"
        }
      },
      "required": [
        "evidence_id",
        "source_id",
        "evidence_class",
        "origin"
      ],
      "type": "object"
    },
    "JobId": {
      "minLength": 1,
      "pattern": "^\\S+$",
      "type": "string"
    },
    "ObservationId": {
      "minLength": 1,
      "pattern": "^\\S+$",
      "type": "string"
    },
    "OffsetUnit": {
      "description": "Unit of `SourceLocator.char_start/char_end`. A Unicode-scalar offset is not a byte offset.",
      "enum": [
        "utf8_byte",
        "unicode_scalar",
        "utf16_code_unit"
      ],
      "type": "string"
    },
    "Origin": {
      "description": "Who produced a payload. `synthetic_fixture` marks hand-made contract examples; such payloads (and\nanything computed from them) can never be presented as NASA results or qualify a model.\nProduced-by-the-system payloads are `system` even when their *data* is synthetic (that is\n`EvidenceClass::Synthetic` / `TrainedOn::Synthetic`).",
      "enum": [
        "system",
        "synthetic_fixture"
      ],
      "type": "string"
    },
    "ParseViewId": {
      "minLength": 1,
      "pattern": "^\\S+$",
      "type": "string"
    },
    "Producer": {
      "additionalProperties": false,
      "description": "What produced an artifact (all optional: an ingestion artifact has no episode).",
      "properties": {
        "episode_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/EpisodeId"
            },
            {
              "type": "null"
            }
          ]
        },
        "job_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/JobId"
            },
            {
              "type": "null"
            }
          ]
        },
        "release_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/ReleaseId"
            },
            {
              "type": "null"
            }
          ]
        },
        "tool_call_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/ToolCallId"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "type": "object"
    },
    "ReleaseId": {
      "minLength": 1,
      "pattern": "^\\S+$",
      "type": "string"
    },
    "ResearchSchema": {
      "description": "Wire tag of episodes, events, answers and traces. Wave K1 writes `research.v2`; `research.v1`\n(C0) documents are still read. A v2 addition (tool arguments, step rationale, a view block, a\nsupport check, a harness pin) is refused under the v1 tag, so a v1 reader never receives a\ndocument it would misread.",
      "oneOf": [
        {
          "enum": [
            "research.v2"
          ],
          "type": "string"
        },
        {
          "const": "research.v1",
          "description": "C0. Still read; new documents are written as v2.",
          "type": "string"
        }
      ]
    },
    "RunId": {
      "minLength": 1,
      "pattern": "^\\S+$",
      "type": "string"
    },
    "SeriesBand": {
      "additionalProperties": false,
      "description": "An uncertainty band around a series (e.g. two quantile rows of an `AnalysisArtifact`).",
      "properties": {
        "lower_pointer": {
          "type": "string"
        },
        "upper_pointer": {
          "type": "string"
        }
      },
      "required": [
        "lower_pointer",
        "upper_pointer"
      ],
      "type": "object"
    },
    "SeriesRef": {
      "additionalProperties": false,
      "description": "One series of a `series_comparison` view, read from one JSON artifact by pointers. Times are\nseconds since the time origin the artifact itself states; the view checks that every series shares\nit. Values are SI in the unit the artifact states; display conversion happens in the chart only.",
      "properties": {
        "artifact_id": {
          "$ref": "#/$defs/ArtifactId"
        },
        "band": {
          "anyOf": [
            {
              "$ref": "#/$defs/SeriesBand"
            },
            {
              "type": "null"
            }
          ]
        },
        "label": {
          "type": [
            "string",
            "null"
          ]
        },
        "role": {
          "$ref": "#/$defs/SeriesRole"
        },
        "time_origin_pointer": {
          "description": "The time origin string, e.g. `/time_origin`.",
          "type": "string"
        },
        "time_pointer": {
          "description": "Array of times (s since the time origin), e.g. `/times_s`.",
          "type": "string"
        },
        "unit_pointer": {
          "description": "The SI unit string, e.g. `/unit`.",
          "type": "string"
        },
        "value_pointer": {
          "description": "Array of values, same length as the times, e.g. `/mean`.",
          "type": "string"
        }
      },
      "required": [
        "artifact_id",
        "role",
        "time_pointer",
        "value_pointer",
        "unit_pointer",
        "time_origin_pointer"
      ],
      "type": "object"
    },
    "SeriesRole": {
      "description": "What a plotted series is. Fixed against the artifact it reads: a predicted series comes only from\nan `AnalysisArtifact`, and an observed or computed one never does.",
      "enum": [
        "observed",
        "computed",
        "predicted"
      ],
      "type": "string"
    },
    "SourceId": {
      "minLength": 1,
      "pattern": "^\\S+$",
      "type": "string"
    },
    "SourceLocator": {
      "additionalProperties": false,
      "description": "Where a value or passage sits inside one asset. A single locator type serves observations,\nchunks, calibrations and evidence references.\n\nConventions fixed in C0 and checked by [`SourceLocator::validate`]:\n* `asset_sha256` is the bare 64-hex digest of the asset bytes.\n* `page` is the **physical** 1-based page index; the printed label goes in `page_label`.\n* `char_start`/`char_end` are half-open offsets into the text of `parse_view_id`, counted in\n  `offset_unit`. Offsets without a parse view and unit are legacy and not citable.\n* `bbox` is `[x0, y0, x1, y1]` in fractions of the displayed page (after its /Rotate), origin\n  top-left, x right, y down.\n* `table_id` scopes `row`/`column` to a table inside the asset (CSV rows otherwise).\n\nFields added in 2.1.0 are omitted when absent, so the serialized form of older locators, and\ntherefore every prefix `input_hash` that embeds them, is unchanged.",
      "properties": {
        "asset_sha256": {
          "type": "string"
        },
        "bbox": {
          "items": {
            "format": "double",
            "type": "number"
          },
          "maxItems": 4,
          "minItems": 4,
          "type": [
            "array",
            "null"
          ]
        },
        "char_end": {
          "default": null,
          "format": "int64",
          "type": [
            "integer",
            "null"
          ]
        },
        "char_start": {
          "default": null,
          "format": "int64",
          "type": [
            "integer",
            "null"
          ]
        },
        "column": {
          "default": null,
          "type": [
            "string",
            "null"
          ]
        },
        "frame": {
          "default": null,
          "format": "int64",
          "type": [
            "integer",
            "null"
          ]
        },
        "offset_unit": {
          "anyOf": [
            {
              "$ref": "#/$defs/OffsetUnit"
            },
            {
              "type": "null"
            }
          ]
        },
        "page": {
          "default": null,
          "format": "int64",
          "type": [
            "integer",
            "null"
          ]
        },
        "page_label": {
          "type": [
            "string",
            "null"
          ]
        },
        "parse_view_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "path": {
          "default": null,
          "type": [
            "string",
            "null"
          ]
        },
        "pts_s": {
          "default": null,
          "format": "double",
          "type": [
            "number",
            "null"
          ]
        },
        "row": {
          "default": null,
          "format": "int64",
          "type": [
            "integer",
            "null"
          ]
        },
        "table_id": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "asset_sha256"
      ],
      "type": "object"
    },
    "SupportCheck": {
      "additionalProperties": false,
      "description": "The result of checking a claim against its cited support. Set by the host or the evaluator, never\nby the agent that wrote the claim.",
      "properties": {
        "confidence": {
          "description": "The checker's own confidence in [0, 1], when it reports one; never invented.",
          "type": [
            "number",
            "null"
          ]
        },
        "method": {
          "$ref": "#/$defs/SupportCheckMethod"
        },
        "model_id": {
          "description": "The checking model; present exactly for the model methods.",
          "type": [
            "string",
            "null"
          ]
        },
        "verdict": {
          "$ref": "#/$defs/SupportVerdict"
        }
      },
      "required": [
        "method",
        "verdict"
      ],
      "type": "object"
    },
    "SupportCheckMethod": {
      "description": "How a claim's support was checked (K1.5).",
      "oneOf": [
        {
          "const": "host_rule",
          "description": "A deterministic host rule (the cited value resolves, the quote occurs at the locator).",
          "type": "string"
        },
        {
          "const": "nli_model",
          "description": "An entailment (NLI) model over the cited passage.",
          "type": "string"
        },
        {
          "const": "llm_judge",
          "description": "A language model judging the cited passage.",
          "type": "string"
        },
        {
          "const": "human",
          "description": "A person.",
          "type": "string"
        }
      ]
    },
    "SupportVerdict": {
      "description": "Does the cited support carry the claim's statement?",
      "oneOf": [
        {
          "enum": [
            "supported",
            "partially_supported",
            "not_supported"
          ],
          "type": "string"
        },
        {
          "const": "unverifiable",
          "description": "The check could not decide (support unreadable, out of the checker's reach).",
          "type": "string"
        }
      ]
    },
    "Timestamp": {
      "format": "date-time",
      "pattern": "Z$",
      "type": "string"
    },
    "ToolCallId": {
      "minLength": 1,
      "pattern": "^\\S+$",
      "type": "string"
    },
    "ViewSpec": {
      "description": "The closed catalog of answer views (K1.4, co-designed with the workspace). The agent places a\ncomponent by naming it with references; it never sends markup. Every reference must be one the\nanswer lists (evidence, artifacts, releases), so a view cannot show what the answer does not cite.\nA new kind is a contract change.",
      "oneOf": [
        {
          "additionalProperties": false,
          "description": "The cited passage, opened at its locator in the original.",
          "properties": {
            "evidence_id": {
              "$ref": "#/$defs/EvidenceId"
            },
            "kind": {
              "const": "source_excerpt",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "evidence_id"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Observation versus prediction (or any series) on one time axis.",
          "properties": {
            "kind": {
              "const": "series_comparison",
              "type": "string"
            },
            "series": {
              "items": {
                "$ref": "#/$defs/SeriesRef"
              },
              "type": "array"
            }
          },
          "required": [
            "kind",
            "series"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Conditions per run with gaps explicit (a `ConditionsTable` artifact).",
          "properties": {
            "kind": {
              "const": "conditions_matrix",
              "type": "string"
            },
            "table": {
              "$ref": "#/$defs/ArtifactId"
            }
          },
          "required": [
            "kind",
            "table"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Tested O2/pressure envelope against habitat atmospheres (a `ConditionsTable` artifact).",
          "properties": {
            "kind": {
              "const": "atmosphere_map",
              "type": "string"
            },
            "table": {
              "$ref": "#/$defs/ArtifactId"
            }
          },
          "required": [
            "kind",
            "table"
          ],
