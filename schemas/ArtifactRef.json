{
  "$defs": {
    "ArtifactId": {
      "minLength": 1,
      "pattern": "^\\S+$",
      "type": "string"
    },
    "DatasetId": {
      "minLength": 1,
      "pattern": "^\\S+$",
      "type": "string"
    },
    "Digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "EntityRef": {
      "description": "A typed reference to any IGNIS entity, used for lineage and provenance links.",
      "oneOf": [
        {
          "properties": {
            "id": {
              "$ref": "#/$defs/SourceId"
            },
            "kind": {
              "const": "source",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "id"
          ],
          "type": "object"
        },
        {
          "properties": {
            "id": {
              "$ref": "#/$defs/EvidenceId"
            },
            "kind": {
              "const": "evidence",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "id"
          ],
          "type": "object"
        },
        {
          "properties": {
            "id": {
              "$ref": "#/$defs/RunId"
            },
            "kind": {
              "const": "run",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "id"
          ],
          "type": "object"
        },
        {
          "properties": {
            "id": {
              "$ref": "#/$defs/ObservationId"
            },
            "kind": {
              "const": "observation",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "id"
          ],
          "type": "object"
        },
        {
          "properties": {
            "id": {
              "$ref": "#/$defs/DatasetId"
            },
            "kind": {
              "const": "dataset",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "id"
          ],
          "type": "object"
        },
        {
          "properties": {
            "id": {
              "$ref": "#/$defs/ArtifactId"
            },
            "kind": {
              "const": "artifact",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "id"
          ],
          "type": "object"
        },
        {
          "properties": {
            "id": {
              "$ref": "#/$defs/ReleaseId"
            },
            "kind": {
              "const": "release",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "id"
          ],
          "type": "object"
        },
        {
          "properties": {
            "id": {
              "$ref": "#/$defs/WikiPageId"
            },
            "kind": {
              "const": "wiki_page",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "id"
          ],
          "type": "object"
        },
        {
          "properties": {
            "id": {
              "$ref": "#/$defs/EpisodeId"
            },
            "kind": {
              "const": "episode",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "id"
          ],
          "type": "object"
        }
      ]
    },
    "EpisodeId": {
      "minLength": 1,
      "pattern": "^\\S+$",
      "type": "string"
    },
    "EvidenceId": {
      "minLength": 1,
      "pattern": "^\\S+$",
      "type": "string"
    },
    "JobId": {
      "minLength": 1,
      "pattern": "^\\S+$",
      "type": "string"
    },
    "ObservationId": {
      "minLength": 1,
      "pattern": "^\\S+$",
      "type": "string"
    },
    "Origin": {
      "description": "Who produced a payload. `synthetic_fixture` marks hand-made contract examples; such payloads (and\nanything computed from them) can never be presented as NASA results or qualify a model.\nProduced-by-the-system payloads are `system` even when their *data* is synthetic (that is\n`EvidenceClass::Synthetic` / `TrainedOn::Synthetic`).",
      "enum": [
        "system",
        "synthetic_fixture"
      ],
      "type": "string"
    },
    "Producer": {
      "additionalProperties": false,
      "description": "What produced an artifact (all optional: an ingestion artifact has no episode).",
      "properties": {
        "episode_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/EpisodeId"
            },
            {
              "type": "null"
            }
          ]
        },
        "job_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/JobId"
            },
            {
              "type": "null"
            }
          ]
        },
        "release_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/ReleaseId"
            },
            {
              "type": "null"
            }
          ]
        },
        "tool_call_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/ToolCallId"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "type": "object"
    },
    "ReleaseId": {
      "minLength": 1,
      "pattern": "^\\S+$",
      "type": "string"
    },
    "RunId": {
      "minLength": 1,
      "pattern": "^\\S+$",
      "type": "string"
    },
    "SourceId": {
      "minLength": 1,
      "pattern": "^\\S+$",
      "type": "string"
    },
    "Timestamp": {
      "format": "date-time",
      "pattern": "Z$",
      "type": "string"
    },
    "ToolCallId": {
      "minLength": 1,
      "pattern": "^\\S+$",
      "type": "string"
    },
    "WikiPageId": {
      "minLength": 1,
      "pattern": "^\\S+$",
      "type": "string"
    }
  },
  "$id": "ignis/2.1.0/ArtifactRef",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Reference to immutable bytes in the artifact store. Never a filesystem path or a URL: a download\nlink is resolved through the access service, may expire, and does not change the artifact.",
  "properties": {
    "artifact_id": {
      "$ref": "#/$defs/ArtifactId"
    },
    "byte_length": {
      "format": "uint64",
      "minimum": 0,
      "type": "integer"
    },
    "contract": {
      "description": "Exported contract type of the content when it is a JSON/JSONL contract document\n(`\"AnalysisArtifact\"`, `\"ResearchAnswer\"`, ...). Consumers dispatch on it.",
      "type": [
        "string",
        "null"
      ]
    },
    "created_at": {
      "$ref": "#/$defs/Timestamp"
    },
    "inputs": {
      "description": "Entities this artifact was computed from (lineage, not access grants).",
      "items": {
        "$ref": "#/$defs/EntityRef"
      },
      "type": "array"
    },
    "media_type": {
      "description": "IANA media type, e.g. `application/json`, `application/vnd.apache.parquet`, `image/png`.",
      "type": "string"
    },
    "origin": {
      "$ref": "#/$defs/Origin"
    },
    "produced_by": {
      "$ref": "#/$defs/Producer"
    },
    "sha256": {
      "$ref": "#/$defs/Digest"
    }
  },
  "required": [
    "artifact_id",
    "sha256",
    "media_type",
    "byte_length",
    "origin",
    "created_at"
  ],
  "title": "ArtifactRef",
  "type": "object"
}
