{
  "$defs": {
    "AnswerId": {
      "minLength": 1,
      "pattern": "^\\S+$",
      "type": "string"
    },
    "AnswerStatus": {
      "oneOf": [
        {
          "enum": [
            "complete",
            "partial",
            "failed"
          ],
          "type": "string"
        },
        {
          "const": "insufficient_evidence",
          "description": "A useful conclusion: the data to answer does not exist (yet), and the answer says what is missing.",
          "type": "string"
        }
      ]
    },
    "ApprovalDecision": {
      "enum": [
        "approved",
        "denied",
        "expired",
        "cancelled"
      ],
      "type": "string"
    },
    "ApprovalId": {
      "minLength": 1,
      "pattern": "^\\S+$",
      "type": "string"
    },
    "ArtifactId": {
      "minLength": 1,
      "pattern": "^\\S+$",
      "type": "string"
    },
    "ArtifactRef": {
      "additionalProperties": false,
      "description": "Reference to immutable bytes in the artifact store. Never a filesystem path or a URL: a download\nlink is resolved through the access service, may expire, and does not change the artifact.",
      "properties": {
        "artifact_id": {
          "$ref": "#/$defs/ArtifactId"
        },
        "byte_length": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "contract": {
          "description": "Exported contract type of the content when it is a JSON/JSONL contract document\n(`\"AnalysisArtifact\"`, `\"ResearchAnswer\"`, ...). Consumers dispatch on it.",
          "type": [
            "string",
            "null"
          ]
        },
        "created_at": {
          "$ref": "#/$defs/Timestamp"
        },
        "inputs": {
          "description": "Entities this artifact was computed from (lineage, not access grants).",
          "items": {
            "$ref": "#/$defs/EntityRef"
          },
          "type": "array"
        },
        "media_type": {
          "description": "IANA media type, e.g. `application/json`, `application/vnd.apache.parquet`, `image/png`.",
          "type": "string"
        },
        "origin": {
          "$ref": "#/$defs/Origin"
        },
        "produced_by": {
          "$ref": "#/$defs/Producer"
        },
        "sha256": {
          "$ref": "#/$defs/Digest"
        }
      },
      "required": [
        "artifact_id",
        "sha256",
        "media_type",
        "byte_length",
        "origin",
        "created_at"
      ],
      "type": "object"
    },
    "Causation": {
      "additionalProperties": false,
      "description": "Why an event happened. Ids from the runtime are kept for correlation, but a scientific job is\nnever keyed only by a Codex id.",
      "properties": {
        "caused_by_seq": {
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "client_request_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/ClientRequestId"
            },
            {
              "type": "null"
            }
          ]
        },
        "job_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/JobId"
            },
            {
              "type": "null"
            }
          ]
        },
        "runtime_item_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "runtime_turn_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "tool_call_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/ToolCallId"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "type": "object"
    },
    "ClientRequestId": {
      "minLength": 1,
      "pattern": "^\\S+$",
      "type": "string"
    },
    "DatasetId": {
      "minLength": 1,
      "pattern": "^\\S+$",
      "type": "string"
    },
    "Digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "EntityRef": {
      "description": "A typed reference to any IGNIS entity, used for lineage and provenance links.",
      "oneOf": [
        {
          "properties": {
            "id": {
              "$ref": "#/$defs/SourceId"
            },
            "kind": {
              "const": "source",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "id"
          ],
          "type": "object"
        },
        {
          "properties": {
            "id": {
              "$ref": "#/$defs/EvidenceId"
            },
            "kind": {
              "const": "evidence",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "id"
          ],
          "type": "object"
        },
        {
          "properties": {
            "id": {
              "$ref": "#/$defs/RunId"
            },
            "kind": {
              "const": "run",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "id"
          ],
          "type": "object"
        },
        {
          "properties": {
            "id": {
              "$ref": "#/$defs/ObservationId"
            },
            "kind": {
              "const": "observation",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "id"
          ],
          "type": "object"
        },
        {
          "properties": {
            "id": {
              "$ref": "#/$defs/DatasetId"
            },
            "kind": {
              "const": "dataset",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "id"
          ],
          "type": "object"
        },
        {
          "properties": {
            "id": {
              "$ref": "#/$defs/ArtifactId"
            },
            "kind": {
              "const": "artifact",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "id"
          ],
          "type": "object"
        },
        {
          "properties": {
            "id": {
              "$ref": "#/$defs/ReleaseId"
            },
            "kind": {
              "const": "release",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "id"
          ],
          "type": "object"
        },
        {
          "properties": {
            "id": {
              "$ref": "#/$defs/WikiPageId"
            },
            "kind": {
              "const": "wiki_page",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "id"
          ],
          "type": "object"
        },
        {
          "properties": {
            "id": {
              "$ref": "#/$defs/EpisodeId"
            },
            "kind": {
              "const": "episode",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "id"
          ],
          "type": "object"
        }
      ]
    },
    "EpisodeId": {
      "minLength": 1,
      "pattern": "^\\S+$",
      "type": "string"
    },
    "EpisodeStatus": {
      "description": "Operational state of an episode. It constrains actions, not reasoning: inside `running` the agent\ndecides whether to read, compute, ask or answer.",
      "oneOf": [
        {
          "enum": [
            "ready",
            "running",
            "waiting_tools",
            "waiting_approval",
            "waiting_user",
            "paused",
            "cancelled",
            "failed"
          ],
          "type": "string"
        },
        {
          "const": "completed",
          "description": "The last turn finished; the episode can be continued by a new message.",
          "type": "string"
        }
      ]
    },
    "ErrorCode": {
      "description": "Technical failure classes. Scientific outcomes (insufficient evidence, out of domain) are *not*\nerrors; they are `ScientificStatus` values of a completed call.",
      "oneOf": [
        {
          "enum": [
            "invalid_request",
            "scope_denied",
            "not_found",
            "unsupported",
            "conflict",
            "rate_limited",
            "upstream_unavailable",
            "cancelled",
            "internal"
          ],
          "type": "string"
        },
        {
          "const": "source_missing",
          "description": "A referenced source/asset is not materialized (listing or metadata only).",
          "type": "string"
        },
        {
          "const": "source_gone",
          "description": "The id is known (its manifest entry exists) but the upstream provider no longer serves the\nobject (HTTP 404/410): a corpus-integrity problem. Never retryable; distinct from\n`not_found` (unknown id) and `upstream_unavailable` (outage, retry later).",
          "type": "string"
        },
        {
          "const": "capability_unavailable",
          "description": "A required service or backend is not available in this deployment.",
          "type": "string"
        }
      ]
    },
    "ErrorEnvelope": {
      "additionalProperties": false,
      "description": "The one error shape of services, tools, jobs and the HTTP API.",
      "properties": {
        "code": {
          "$ref": "#/$defs/ErrorCode"
        },
        "log_ref": {
          "anyOf": [
            {
              "$ref": "#/$defs/ArtifactId"
            },
            {
              "type": "null"
            }
          ],
          "description": "Redacted log artifact, when one exists."
        },
        "message": {
          "type": "string"
        },
        "retry": {
          "$ref": "#/$defs/RetryPolicy"
        }
      },
      "required": [
        "code",
        "message",
        "retry"
      ],
      "type": "object"
    },
    "EventBody": {
      "description": "Event payloads. Large content is referenced through artifacts, never inlined.",
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "episode.status_changed",
              "type": "string"
            },
            "payload": {
              "additionalProperties": false,
              "properties": {
                "from": {
                  "$ref": "#/$defs/EpisodeStatus"
                },
                "reason": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "to": {
                  "$ref": "#/$defs/EpisodeStatus"
                }
              },
              "required": [
                "from",
                "to"
              ],
              "type": "object"
            }
          },
          "required": [
            "kind",
            "payload"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "message.user",
              "type": "string"
            },
            "payload": {
              "additionalProperties": false,
              "properties": {
                "message_id": {
                  "$ref": "#/$defs/MessageId"
                },
                "text": {
                  "type": "string"
                }
              },
              "required": [
                "message_id",
                "text"
              ],
              "type": "object"
            }
          },
          "required": [
            "kind",
            "payload"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Incremental assistant text. Never the only copy: `message.completed` carries the snapshot.",
          "properties": {
            "kind": {
              "const": "message.delta",
              "type": "string"
            },
            "payload": {
              "additionalProperties": false,
              "properties": {
                "message_id": {
                  "$ref": "#/$defs/MessageId"
                },
                "text": {
                  "type": "string"
                }
              },
              "required": [
                "message_id",
                "text"
              ],
              "type": "object"
            }
          },
          "required": [
            "kind",
            "payload"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "message.completed",
              "type": "string"
            },
            "payload": {
              "additionalProperties": false,
              "properties": {
                "message_id": {
                  "$ref": "#/$defs/MessageId"
                },
                "text": {
                  "type": "string"
                }
              },
              "required": [
                "message_id",
                "text"
              ],
              "type": "object"
            }
          },
          "required": [
            "kind",
            "payload"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "tool.started",
              "type": "string"
            },
            "payload": {
              "additionalProperties": false,
              "properties": {
                "arguments": {
                  "anyOf": [
                    {
                      "$ref": "#/$defs/ToolArguments"
                    },
                    {
                      "type": "null"
                    }
                  ],
                  "description": "v2: the call's arguments, redacted by scope (absent in v1 logs)."
                },
                "call_id": {
                  "$ref": "#/$defs/ToolCallId"
                },
                "tool": {
                  "type": "string"
                }
              },
              "required": [
                "call_id",
                "tool"
              ],
              "type": "object"
            }
          },
          "required": [
            "kind",
            "payload"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "v2: the model's own short explanation of a step (why this search, why this computation),\ntied to the tool call it introduces when there is one.",
          "properties": {
            "kind": {
              "const": "step.rationale",
              "type": "string"
            },
            "payload": {
              "additionalProperties": false,
              "properties": {
                "call_id": {
                  "anyOf": [
                    {
                      "$ref": "#/$defs/ToolCallId"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "source": {
                  "$ref": "#/$defs/RationaleSource"
                },
                "text": {
                  "type": "string"
                }
              },
              "required": [
                "text",
                "source"
              ],
              "type": "object"
            }
          },
          "required": [
            "kind",
            "payload"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "tool.finished",
              "type": "string"
            },
            "payload": {
              "additionalProperties": false,
              "properties": {
                "result": {
                  "$ref": "#/$defs/ToolResult"
                }
              },
              "required": [
                "result"
              ],
              "type": "object"
            }
          },
          "required": [
            "kind",
            "payload"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "job.updated",
              "type": "string"
            },
            "payload": {
              "additionalProperties": false,
              "properties": {
                "job": {
                  "$ref": "#/$defs/JobRef"
                }
              },
              "required": [
                "job"
              ],
              "type": "object"
            }
          },
          "required": [
            "kind",
            "payload"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "artifact.created",
              "type": "string"
            },
            "payload": {
              "additionalProperties": false,
              "properties": {
                "artifact": {
                  "$ref": "#/$defs/ArtifactRef"
                }
              },
              "required": [
                "artifact"
              ],
              "type": "object"
            }
          },
          "required": [
            "kind",
            "payload"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "A runtime-initiated approval request; resolved explicitly by the host, never by the UI alone.",
          "properties": {
            "kind": {
              "const": "approval.requested",
              "type": "string"
            },
            "payload": {
              "additionalProperties": false,
              "properties": {
                "action": {
                  "type": "string"
                },
                "approval_id": {
                  "$ref": "#/$defs/ApprovalId"
                },
                "effect": {
                  "$ref": "#/$defs/ToolEffect"
                }
              },
              "required": [
                "approval_id",
                "action",
                "effect"
              ],
              "type": "object"
            }
          },
          "required": [
            "kind",
            "payload"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "approval.resolved",
              "type": "string"
            },
            "payload": {
              "additionalProperties": false,
              "properties": {
                "approval_id": {
                  "$ref": "#/$defs/ApprovalId"
                },
                "decision": {
                  "$ref": "#/$defs/ApprovalDecision"
                }
              },
              "required": [
                "approval_id",
                "decision"
              ],
              "type": "object"
            }
          },
          "required": [
            "kind",
            "payload"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "The final answer of a turn, stored as a `ResearchAnswer` artifact.",
          "properties": {
            "kind": {
              "const": "answer.completed",
              "type": "string"
            },
            "payload": {
              "additionalProperties": false,
              "properties": {
                "answer": {
                  "$ref": "#/$defs/ArtifactRef"
                },
                "answer_id": {
                  "$ref": "#/$defs/AnswerId"
                },
                "status": {
                  "$ref": "#/$defs/AnswerStatus"
                }
              },
              "required": [
                "answer_id",
                "status",
                "answer"
              ],
              "type": "object"
            }
          },
          "required": [
            "kind",
            "payload"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "An upstream runtime notification IGNIS does not interpret, archived for diagnostics. The UI\nmay show it as opaque; nobody derives domain meaning from it.",
          "properties": {
            "kind": {
              "const": "runtime.opaque",
              "type": "string"
            },
            "payload": {
              "additionalProperties": false,
              "properties": {
                "method": {
                  "type": "string"
                },
                "payload": {
                  "anyOf": [
                    {
                      "$ref": "#/$defs/ArtifactRef"
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              },
              "required": [
                "method"
              ],
              "type": "object"
            }
          },
          "required": [
            "kind",
            "payload"
          ],
          "type": "object"
        }
      ]
    },
    "EventId": {
      "minLength": 1,
      "pattern": "^\\S+$",
      "type": "string"
    },
    "EvidenceId": {
      "minLength": 1,
      "pattern": "^\\S+$",
      "type": "string"
    },
    "ExecutionStatus": {
      "description": "Did the call run? Independent of what it found.",
      "oneOf": [
        {
          "enum": [
            "completed",
            "cancelled"
          ],
          "type": "string"
        },
        {
          "const": "accepted",
          "description": "Long work started; follow `job`.",
          "type": "string"
        },
        {
          "const": "refused",
          "description": "The host or service declined (scope, invalid input, unsupported).",
          "type": "string"
        },
        {
          "const": "failed",
          "description": "Technical failure.",
          "type": "string"
        }
      ]
    },
    "InlinePayload": {
      "additionalProperties": false,
      "description": "Inline content returned together with (or instead of) a full artifact. `partial = true` means\nthis is a preview: the complete content is `full`, and nobody may treat the preview as the result.",
      "properties": {
        "full": {
          "anyOf": [
            {
              "$ref": "#/$defs/ArtifactRef"
            },
            {
              "type": "null"
            }
          ]
        },
        "partial": {
          "type": "boolean"
        },
        "value": true
      },
      "required": [
        "value",
        "partial"
      ],
      "type": "object"
    },
    "JobId": {
      "minLength": 1,
      "pattern": "^\\S+$",
      "type": "string"
    },
    "JobProgress": {
      "additionalProperties": false,
      "properties": {
        "completed": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "total": {
          "description": "Unknown totals stay unknown.",
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "unit": {
          "type": "string"
        }
      },
      "required": [
        "completed",
        "unit"
      ],
      "type": "object"
    },
    "JobRef": {
      "additionalProperties": false,
      "properties": {
        "error": {
          "anyOf": [
            {
              "$ref": "#/$defs/ErrorEnvelope"
            },
            {
              "type": "null"
            }
          ]
        },
        "job_id": {
          "$ref": "#/$defs/JobId"
        },
        "kind": {
          "description": "Operation name, e.g. `models_forecast`, `analysis_execute`.",
          "type": "string"
        },
        "outputs": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ArtifactRef"
          },
          "type": "array"
        },
        "progress": {
          "anyOf": [
            {
              "$ref": "#/$defs/JobProgress"
            },
            {
              "type": "null"
            }
          ]
        },
        "status": {
          "$ref": "#/$defs/JobStatus"
        },
        "submitted_at": {
          "$ref": "#/$defs/Timestamp"
        },
        "updated_at": {
          "$ref": "#/$defs/Timestamp"
        }
      },
      "required": [
        "job_id",
        "kind",
        "status",
        "submitted_at",
        "updated_at"
      ],
      "type": "object"
    },
    "JobStatus": {
      "description": "Public job state. Leases, fencing tokens and the scheduler stay internal.",
      "oneOf": [
        {
          "enum": [
            "queued",
            "running",
            "succeeded",
            "failed",
            "cancelled"
          ],
          "type": "string"
        },
        {
          "const": "cancel_requested",
          "description": "Cancellation asked; the work may still be running.",
          "type": "string"
        },
        {
          "const": "reconciling",
          "description": "The effect of an interrupted attempt is uncertain and is being reconciled. Not `failed`, and\nnot re-run blindly.",
          "type": "string"
        }
      ]
    },
    "MessageId": {
      "minLength": 1,
      "pattern": "^\\S+$",
      "type": "string"
    },
    "ObservationId": {
      "minLength": 1,
      "pattern": "^\\S+$",
      "type": "string"
    },
    "Origin": {
      "description": "Who produced a payload. `synthetic_fixture` marks hand-made contract examples; such payloads (and\nanything computed from them) can never be presented as NASA results or qualify a model.\nProduced-by-the-system payloads are `system` even when their *data* is synthetic (that is\n`EvidenceClass::Synthetic` / `TrainedOn::Synthetic`).",
      "enum": [
        "system",
        "synthetic_fixture"
      ],
      "type": "string"
    },
    "Producer": {
      "additionalProperties": false,
      "description": "What produced an artifact (all optional: an ingestion artifact has no episode).",
      "properties": {
        "episode_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/EpisodeId"
            },
            {
              "type": "null"
            }
          ]
        },
        "job_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/JobId"
            },
            {
              "type": "null"
            }
          ]
        },
        "release_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/ReleaseId"
            },
            {
              "type": "null"
            }
          ]
        },
        "tool_call_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/ToolCallId"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "type": "object"
    },
    "RationaleSource": {
      "description": "Where a step rationale comes from. Closed on purpose: only the model's own explanation, written\nfor the user, is shown; hidden chain-of-thought is never recorded as a rationale.",
      "enum": [
        "model_explanation"
      ],
      "type": "string"
    },
    "ReleaseId": {
      "minLength": 1,
      "pattern": "^\\S+$",
      "type": "string"
    },
    "ResearchSchema": {
      "description": "Wire tag of episodes, events, answers and traces. Wave K1 writes `research.v2`; `research.v1`\n(C0) documents are still read. A v2 addition (tool arguments, step rationale, a view block, a\nsupport check, a harness pin) is refused under the v1 tag, so a v1 reader never receives a\ndocument it would misread.",
      "oneOf": [
        {
          "enum": [
            "research.v2"
          ],
          "type": "string"
        },
        {
          "const": "research.v1",
          "description": "C0. Still read; new documents are written as v2.",
          "type": "string"
        }
      ]
    },
    "RetryPolicy": {
      "description": "What a caller may do after an error. `reconcile` means the effect is uncertain: inspect state\nbefore any retry, never re-run blindly.",
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "never",
              "type": "string"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "after_delay",
              "type": "string"
            },
            "seconds": {
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            }
          },
          "required": [
            "kind",
            "seconds"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "after_user_action",
              "type": "string"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "reconcile",
              "type": "string"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        }
      ]
    },
    "RunId": {
      "minLength": 1,
      "pattern": "^\\S+$",
      "type": "string"
    },
    "ScientificStatus": {
      "description": "What a completed call established. `insufficient_evidence` and `out_of_domain` are valid\nscientific conclusions of a successful execution, not errors.",
      "enum": [
        "not_assessed",
        "conclusive",
        "inconclusive",
        "insufficient_evidence",
        "out_of_domain"
      ],
      "type": "string"
    },
    "SourceId": {
      "minLength": 1,
      "pattern": "^\\S+$",
      "type": "string"
    },
    "Timestamp": {
      "format": "date-time",
      "pattern": "Z$",
      "type": "string"
    },
    "ToolArguments": {
      "additionalProperties": false,
      "description": "The arguments of a tool call as shown in the log (K1.1). The host redacts what the viewer's\nscope may not see before the event is written; the pointers say what was removed, so a missing\nfield is never mistaken for an argument the agent did not send. Large arguments (a program's\nsource) are a partial preview pointing at the full artifact.",
      "properties": {
        "redacted": {
          "description": "RFC 6901 JSON Pointers of the members removed by redaction.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "value": {
          "$ref": "#/$defs/InlinePayload"
        }
      },
      "required": [
        "value"
      ],
      "type": "object"
    },
    "ToolCallId": {
      "minLength": 1,
      "pattern": "^\\S+$",
      "type": "string"
    },
    "ToolEffect": {
      "description": "Side-effect class of a tool. Approval and idempotency policy key on it.",
      "enum": [
        "read",
        "workspace_write",
        "compute",
        "network_fetch",
        "external_write"
      ],
      "type": "string"
    },
    "ToolResult": {
      "additionalProperties": false,
      "description": "Result envelope of every IGNIS tool (MCP or internal).",
      "properties": {
        "artifact_refs": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ArtifactRef"
          },
          "type": "array"
        },
        "call_id": {
          "$ref": "#/$defs/ToolCallId"
        },
        "error": {
          "anyOf": [
            {
              "$ref": "#/$defs/ErrorEnvelope"
            },
            {
              "type": "null"
            }
          ]
        },
        "execution_status": {
          "$ref": "#/$defs/ExecutionStatus"
        },
        "job": {
          "anyOf": [
            {
              "$ref": "#/$defs/JobRef"
            },
            {
              "type": "null"
            }
          ]
        },
        "origin": {
          "$ref": "#/$defs/Origin"
        },
        "result": {
          "anyOf": [
            {
              "$ref": "#/$defs/InlinePayload"
            },
            {
              "type": "null"
            }
          ]
        },
        "schema_version": {
          "$ref": "#/$defs/ToolsSchema"
        },
        "scientific_status": {
          "$ref": "#/$defs/ScientificStatus"
        },
        "tool": {
          "type": "string"
        }
      },
      "required": [
        "schema_version",
        "call_id",
        "tool",
        "execution_status",
        "scientific_status",
        "origin"
      ],
      "type": "object"
    },
    "ToolsSchema": {
      "description": "Wire tag of tool results and descriptors.",
      "enum": [
        "tools.v1"
      ],
      "type": "string"
    },
    "WikiPageId": {
      "minLength": 1,
      "pattern": "^\\S+$",
      "type": "string"
    }
  },
  "$id": "ignis/2.1.0/ResearchEvent",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "One entry of an episode's append-only log. `seq` is gap-free and monotonic per episode and is\nthe replay authority: SSE sends it as the event `id`, clients resume with `after=<seq>` and\ndeduplicate by `(episode_id, seq)`. Reconnecting never re-executes tools.",
  "properties": {
    "body": {
      "$ref": "#/$defs/EventBody"
    },
    "causation": {
      "$ref": "#/$defs/Causation"
    },
    "episode_id": {
      "$ref": "#/$defs/EpisodeId"
    },
    "event_id": {
      "$ref": "#/$defs/EventId"
    },
    "occurred_at": {
      "$ref": "#/$defs/Timestamp"
    },
    "origin": {
      "$ref": "#/$defs/Origin"
    },
    "schema_version": {
      "$ref": "#/$defs/ResearchSchema"
    },
    "seq": {
      "format": "uint64",
      "minimum": 0,
      "type": "integer"
    }
  },
  "required": [
    "schema_version",
    "event_id",
    "episode_id",
    "seq",
    "occurred_at",
    "body",
    "origin"
  ],
  "title": "ResearchEvent",
  "type": "object"
}
