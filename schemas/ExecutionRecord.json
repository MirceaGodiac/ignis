{
  "$defs": {
    "AnalysisLanguage": {
      "description": "Language of an `analysis_execute` program. Closed: a new value needs a runner image that\nprovides it (and a preflight that proves it).",
      "oneOf": [
        {
          "const": "python",
          "description": "CPython of the pinned runner image, run isolated (`python -I`).",
          "type": "string"
        }
      ]
    },
    "AnalysisOutput": {
      "additionalProperties": false,
      "description": "A file the program wrote under `/out`, kept as an artifact.",
      "properties": {
        "artifact": {
          "$ref": "#/$defs/ArtifactRef"
        },
        "path": {
          "description": "Path relative to `/out`, `/`-separated.",
          "type": "string"
        }
      },
      "required": [
        "path",
        "artifact"
      ],
      "type": "object"
    },
    "ArtifactId": {
      "minLength": 1,
      "pattern": "^\\S+$",
      "type": "string"
    },
    "ArtifactRef": {
      "additionalProperties": false,
      "description": "Reference to immutable bytes in the artifact store. Never a filesystem path or a URL: a download\nlink is resolved through the access service, may expire, and does not change the artifact.",
      "properties": {
        "artifact_id": {
          "$ref": "#/$defs/ArtifactId"
        },
        "byte_length": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "contract": {
          "description": "Exported contract type of the content when it is a JSON/JSONL contract document\n(`\"AnalysisArtifact\"`, `\"ResearchAnswer\"`, ...). Consumers dispatch on it.",
          "type": [
            "string",
            "null"
          ]
        },
        "created_at": {
          "$ref": "#/$defs/Timestamp"
        },
        "inputs": {
          "description": "Entities this artifact was computed from (lineage, not access grants).",
          "items": {
            "$ref": "#/$defs/EntityRef"
          },
          "type": "array"
        },
        "media_type": {
          "description": "IANA media type, e.g. `application/json`, `application/vnd.apache.parquet`, `image/png`.",
          "type": "string"
        },
        "origin": {
          "$ref": "#/$defs/Origin"
        },
        "produced_by": {
          "$ref": "#/$defs/Producer"
        },
        "sha256": {
          "$ref": "#/$defs/Digest"
        }
      },
      "required": [
        "artifact_id",
        "sha256",
        "media_type",
        "byte_length",
        "origin",
        "created_at"
      ],
      "type": "object"
    },
    "CapturedStream": {
      "additionalProperties": false,
      "description": "A captured output stream. `truncated` means the stream exceeded the budget: `total_bytes` were\nwritten, only the first `stream_bytes` are in `artifact`.",
      "properties": {
        "artifact": {
          "anyOf": [
            {
              "$ref": "#/$defs/ArtifactRef"
            },
            {
              "type": "null"
            }
          ],
          "description": "Absent when the stream was empty."
        },
        "total_bytes": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "truncated": {
          "type": "boolean"
        }
      },
      "required": [
        "total_bytes",
        "truncated"
      ],
      "type": "object"
    },
    "DatasetId": {
      "minLength": 1,
      "pattern": "^\\S+$",
      "type": "string"
    },
    "Digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "EntityRef": {
      "description": "A typed reference to any IGNIS entity, used for lineage and provenance links.",
      "oneOf": [
        {
          "properties": {
            "id": {
              "$ref": "#/$defs/SourceId"
            },
            "kind": {
              "const": "source",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "id"
          ],
          "type": "object"
        },
        {
          "properties": {
            "id": {
              "$ref": "#/$defs/EvidenceId"
            },
            "kind": {
              "const": "evidence",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "id"
          ],
          "type": "object"
        },
        {
          "properties": {
            "id": {
              "$ref": "#/$defs/RunId"
            },
            "kind": {
              "const": "run",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "id"
          ],
          "type": "object"
        },
        {
          "properties": {
            "id": {
              "$ref": "#/$defs/ObservationId"
            },
            "kind": {
              "const": "observation",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "id"
          ],
          "type": "object"
        },
        {
          "properties": {
            "id": {
              "$ref": "#/$defs/DatasetId"
            },
            "kind": {
              "const": "dataset",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "id"
          ],
          "type": "object"
        },
        {
          "properties": {
            "id": {
              "$ref": "#/$defs/ArtifactId"
            },
            "kind": {
              "const": "artifact",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "id"
          ],
          "type": "object"
        },
        {
          "properties": {
            "id": {
              "$ref": "#/$defs/ReleaseId"
            },
            "kind": {
              "const": "release",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "id"
          ],
          "type": "object"
        },
        {
          "properties": {
            "id": {
              "$ref": "#/$defs/WikiPageId"
            },
            "kind": {
              "const": "wiki_page",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "id"
          ],
          "type": "object"
        },
        {
          "properties": {
            "id": {
              "$ref": "#/$defs/EpisodeId"
            },
            "kind": {
              "const": "episode",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "id"
          ],
          "type": "object"
        }
      ]
    },
    "EpisodeId": {
      "minLength": 1,
      "pattern": "^\\S+$",
      "type": "string"
    },
    "EvidenceId": {
      "minLength": 1,
      "pattern": "^\\S+$",
      "type": "string"
    },
    "ExecutionOutcome": {
      "description": "How the program ended.",
      "oneOf": [
        {
          "additionalProperties": false,
          "description": "The process exited by itself (any code; non-zero is the program's failure, not the host's).",
          "properties": {
            "exit_code": {
              "format": "int64",
              "type": "integer"
            },
            "kind": {
              "const": "exited",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "exit_code"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Killed at the wall-clock budget.",
          "properties": {
            "kind": {
              "const": "timed_out",
              "type": "string"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Killed by the memory budget.",
          "properties": {
            "kind": {
              "const": "out_of_memory",
              "type": "string"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        }
      ]
    },
    "JobId": {
      "minLength": 1,
      "pattern": "^\\S+$",
      "type": "string"
    },
    "MountedInput": {
      "additionalProperties": false,
      "description": "An input as the program saw it: `/in/<name>` held exactly these bytes.",
      "properties": {
        "artifact": {
          "$ref": "#/$defs/ArtifactRef"
        },
        "name": {
          "type": "string"
        }
      },
      "required": [
        "name",
        "artifact"
      ],
      "type": "object"
    },
    "ObservationId": {
      "minLength": 1,
      "pattern": "^\\S+$",
      "type": "string"
    },
    "Origin": {
      "description": "Who produced a payload. `synthetic_fixture` marks hand-made contract examples; such payloads (and\nanything computed from them) can never be presented as NASA results or qualify a model.\nProduced-by-the-system payloads are `system` even when their *data* is synthetic (that is\n`EvidenceClass::Synthetic` / `TrainedOn::Synthetic`).",
      "enum": [
        "system",
        "synthetic_fixture"
      ],
      "type": "string"
    },
    "Producer": {
      "additionalProperties": false,
      "description": "What produced an artifact (all optional: an ingestion artifact has no episode).",
      "properties": {
        "episode_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/EpisodeId"
            },
            {
              "type": "null"
            }
          ]
        },
        "job_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/JobId"
            },
            {
              "type": "null"
            }
          ]
        },
        "release_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/ReleaseId"
            },
            {
              "type": "null"
            }
          ]
        },
        "tool_call_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/ToolCallId"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "type": "object"
    },
    "RejectedOutput": {
      "additionalProperties": false,
      "description": "A path under `/out` that was not kept, and why (symbolic link, special file, budget).",
      "properties": {
        "path": {
          "type": "string"
        },
        "reason": {
          "type": "string"
        }
      },
      "required": [
        "path",
        "reason"
      ],
      "type": "object"
    },
    "ReleaseId": {
      "minLength": 1,
      "pattern": "^\\S+$",
      "type": "string"
    },
    "RunId": {
      "minLength": 1,
      "pattern": "^\\S+$",
      "type": "string"
    },
    "RunnerEnvironment": {
      "additionalProperties": false,
      "description": "What a program ran in: the content address of the image, the OCI runtime and its isolation.",
      "properties": {
        "image_id": {
          "$ref": "#/$defs/Digest",
          "description": "Image id (`sha256:` of the image config), pinned by the host."
        },
        "interpreter": {
          "description": "Interpreter version reported by the image during preflight.",
          "type": "string"
        },
        "isolation": {
          "$ref": "#/$defs/RunnerIsolation"
        },
        "oci_runtime": {
          "description": "OCI runtime name as the container engine reports it (`runsc`, `runc`).",
          "type": "string"
        }
      },
      "required": [
        "image_id",
        "oci_runtime",
        "isolation",
        "interpreter"
      ],
      "type": "object"
    },
    "RunnerIsolation": {
      "description": "Isolation the runner actually provided. Recorded on every execution and in capability status;\nnever inferred from configuration alone (the preflight probe proves it).",
      "oneOf": [
        {
          "const": "gvisor",
          "description": "OCI container under gVisor (`runsc`): a user-space kernel between the program and the host.",
          "type": "string"
        },
        {
          "const": "container",
          "description": "OCI container under the host kernel (namespaces, seccomp, no capabilities). Development\nisolation; the public deployment uses `gvisor`.",
          "type": "string"
        }
      ]
    },
    "RunnerLimits": {
      "additionalProperties": false,
      "description": "Resource budget of one execution, set by the host (never by the request).",
      "properties": {
        "cpu_millis": {
          "description": "CPU quota in thousandths of a core.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "memory_bytes": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "output_bytes": {
          "description": "Total bytes of `/out` files kept as artifacts.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "pids": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "stream_bytes": {
          "description": "Bytes of stdout and of stderr each kept as an artifact (the rest is counted, not stored).",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "tmp_bytes": {
          "description": "Scratch space (`/tmp`, in memory).",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "wall_seconds": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "wall_seconds",
        "memory_bytes",
        "cpu_millis",
        "pids",
        "tmp_bytes",
        "output_bytes",
        "stream_bytes"
      ],
      "type": "object"
    },
    "SourceId": {
      "minLength": 1,
      "pattern": "^\\S+$",
      "type": "string"
    },
    "Timestamp": {
      "format": "date-time",
      "pattern": "Z$",
      "type": "string"
    },
    "ToolCallId": {
      "minLength": 1,
      "pattern": "^\\S+$",
      "type": "string"
    },
    "ToolsSchema": {
      "description": "Wire tag of tool results and descriptors.",
      "enum": [
        "tools.v1"
      ],
      "type": "string"
    },
    "WikiPageId": {
      "minLength": 1,
      "pattern": "^\\S+$",
      "type": "string"
    }
  },
  "$id": "ignis/2.1.0/ExecutionRecord",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "The record of one `analysis_execute` run (the job's first output artifact): code identity,\nenvironment, inputs, budget, outcome and the artifacts produced. A computed value cited in an\nanswer points into one of `outputs` (or `stdout`), and this record says how it was computed.",
  "properties": {
    "environment": {
      "$ref": "#/$defs/RunnerEnvironment"
    },
    "finished_at": {
      "$ref": "#/$defs/Timestamp"
    },
    "inputs": {
      "description": "Inputs as mounted.",
      "items": {
        "$ref": "#/$defs/MountedInput"
      },
      "type": "array"
    },
    "language": {
      "$ref": "#/$defs/AnalysisLanguage"
    },
    "limits": {
      "$ref": "#/$defs/RunnerLimits"
    },
    "origin": {
      "$ref": "#/$defs/Origin",
      "description": "`synthetic_fixture` when any input is."
    },
    "outcome": {
      "$ref": "#/$defs/ExecutionOutcome"
    },
    "outputs": {
      "items": {
        "$ref": "#/$defs/AnalysisOutput"
      },
      "type": "array"
    },
    "program": {
      "$ref": "#/$defs/ArtifactRef",
      "description": "The program exactly as executed."
    },
    "rejected_outputs": {
      "items": {
        "$ref": "#/$defs/RejectedOutput"
      },
      "type": "array"
    },
    "schema_version": {
      "$ref": "#/$defs/ToolsSchema"
    },
    "started_at": {
      "$ref": "#/$defs/Timestamp"
    },
    "stderr": {
      "$ref": "#/$defs/CapturedStream"
    },
    "stdout": {
      "$ref": "#/$defs/CapturedStream"
    }
  },
  "required": [
    "schema_version",
    "language",
    "program",
    "environment",
    "limits",
    "outcome",
    "stdout",
    "stderr",
    "started_at",
    "finished_at",
    "origin"
  ],
  "title": "ExecutionRecord",
  "type": "object"
}
