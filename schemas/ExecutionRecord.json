{
  "$defs": {
    "AnalysisLanguage": {
      "description": "Language of an `analysis_execute` program. Closed: a new value needs a runner image that\nprovides it (and a preflight that proves it).",
      "oneOf": [
        {
          "const": "python",
          "description": "CPython of the pinned runner image, run isolated (`python -I`).",
          "type": "string"
        }
      ]
    },
    "AnalysisOutput": {
      "additionalProperties": false,
      "description": "A file the program wrote under `/out`, kept as an artifact.",
      "properties": {
        "artifact": {
          "$ref": "#/$defs/ArtifactRef"
        },
        "path": {
          "description": "Path relative to `/out`, `/`-separated.",
          "type": "string"
        }
      },
      "required": [
        "path",
        "artifact"
      ],
      "type": "object"
    },
    "ArtifactId": {
      "minLength": 1,
      "pattern": "^\\S+$",
      "type": "string"
    },
    "ArtifactRef": {
      "additionalProperties": false,
      "description": "Reference to immutable bytes in the artifact store. Never a filesystem path or a URL: a download\nlink is resolved through the access service, may expire, and does not change the artifact.",
      "properties": {
        "artifact_id": {
          "$ref": "#/$defs/ArtifactId"
        },
        "byte_length": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "contract": {
          "description": "Exported contract type of the content when it is a JSON/JSONL contract document\n(`\"AnalysisArtifact\"`, `\"ResearchAnswer\"`, ...). Consumers dispatch on it.",
          "type": [
            "string",
            "null"
          ]
        },
        "created_at": {
          "$ref": "#/$defs/Timestamp"
        },
        "inputs": {
          "description": "Entities this artifact was computed from (lineage, not access grants).",
          "items": {
            "$ref": "#/$defs/EntityRef"
          },
          "type": "array"
        },
        "media_type": {
          "description": "IANA media type, e.g. `application/json`, `application/vnd.apache.parquet`, `image/png`.",
          "type": "string"
        },
        "origin": {
          "$ref": "#/$defs/Origin"
        },
        "produced_by": {
          "$ref": "#/$defs/Producer"
        },
        "sha256": {
          "$ref": "#/$defs/Digest"
        }
      },
      "required": [
        "artifact_id",
        "sha256",
        "media_type",
        "byte_length",
        "origin",
        "created_at"
      ],
      "type": "object"
    },
    "CapturedStream": {
      "additionalProperties": false,
      "description": "A captured output stream. `truncated` means the stream exceeded the budget: `total_bytes` were\nwritten, only the first `stream_bytes` are in `artifact`.",
      "properties": {
        "artifact": {
          "anyOf": [
            {
              "$ref": "#/$defs/ArtifactRef"
            },
            {
              "type": "null"
            }
          ],
          "description": "Absent when the stream was empty."
        },
        "total_bytes": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "truncated": {
          "type": "boolean"
        }
      },
      "required": [
        "total_bytes",
        "truncated"
      ],
      "type": "object"
    },
    "ColumnRole": {
      "oneOf": [
        {
          "enum": [
            "run_id",
            "value",
            "uncertainty",
            "condition",
            "flag"
          ],
          "type": "string"
        },
        {
          "const": "time",
          "description": "Seconds since the bundle's `time_origin`.",
          "type": "string"
        },
        {
          "const": "available_at",
          "description": "Time the value became available to an observer (seconds since `time_origin`).",
          "type": "string"
        },
        {
          "const": "locator",
          "description": "Serialized `SourceLocator` / evidence id of the row.",
          "type": "string"
        }
      ]
    },
    "ColumnSpec": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string"
        },
        "nullable": {
          "type": "boolean"
        },
        "quantity": {
          "anyOf": [
            {
              "$ref": "#/$defs/Quantity"
            },
            {
              "type": "null"
            }
          ]
        },
        "role": {
          "$ref": "#/$defs/ColumnRole"
        },
        "unit": {
          "description": "SI unit of the stored values; display conversions never change it.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "name",
        "role",
        "nullable"
      ],
      "type": "object"
    },
    "ConditionFilter": {
      "additionalProperties": false,
      "description": "A filter on one key. A filter keeps rows whose cell is a value inside it; rows whose cell is\nmissing or conflicting are kept only with `ConditionsQuery::include_unknown`.",
      "properties": {
        "any_of": {
          "description": "Categorical keys.",
          "items": {
            "type": "string"
          },
          "type": "array",
          "uniqueItems": true
        },
        "key": {
          "$ref": "#/$defs/ConditionKey"
        },
        "max_si": {
          "type": [
            "number",
            "null"
          ]
        },
        "min_si": {
          "description": "Numeric keys, SI.",
          "type": [
            "number",
            "null"
          ]
        }
      },
      "required": [
        "key"
      ],
      "type": "object"
    },
    "ConditionKey": {
      "description": "A condition the challenge and the graph join on. Numeric keys are stored in the SI unit of their\n[`Quantity`]; the others are categorical text (`n-heptane`, `flat sheet`, `CIR/MDCA`). The\ncatalog is closed: a new key is a contract change.",
      "enum": [
        "oxygen_mole_fraction",
        "pressure",
        "flow_velocity",
        "gravity_level",
        "ambient_temperature",
        "fuel",
        "diluent",
        "sample_geometry",
        "hardware",
        "diagnostics"
      ],
      "type": "string"
    },
    "ConditionsQuery": {
      "additionalProperties": false,
      "description": "`conditions_query`: per-run conditions and, on request, each investigation's tested envelope.",
      "properties": {
        "cursor": {
          "anyOf": [
            {
              "$ref": "#/$defs/PageCursor"
            },
            {
              "type": "null"
            }
          ]
        },
        "filters": {
          "items": {
            "$ref": "#/$defs/ConditionFilter"
          },
          "type": "array"
        },
        "include_envelopes": {
          "default": false,
          "type": "boolean"
        },
        "include_unknown": {
          "default": false,
          "type": "boolean"
        },
        "investigation_ids": {
          "description": "Empty = every investigation.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "keys": {
          "description": "Columns; empty = every key.",
          "items": {
            "$ref": "#/$defs/ConditionKey"
          },
          "type": "array"
        },
        "page_size": {
          "format": "uint32",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "run_ids": {
          "items": {
            "$ref": "#/$defs/RunId"
          },
          "type": "array"
        },
        "schema_version": {
          "$ref": "#/$defs/DatasetSchema"
        }
      },
      "required": [
        "schema_version"
      ],
      "type": "object"
    },
    "DatasetId": {
      "minLength": 1,
      "pattern": "^\\S+$",
      "type": "string"
    },
    "DatasetSchema": {
      "description": "Wire tag of dataset, visual observation and conditions documents. Wave K1 writes `dataset.v2`;\n`dataset.v1` (C0) documents are still read, and keep their content digests because a\ndocument is re-serialized with the tag it was read with. New document types require v2.",
      "oneOf": [
        {
          "enum": [
            "dataset.v2"
          ],
          "type": "string"
        },
        {
          "const": "dataset.v1",
          "description": "C0. Still read; new documents are written as v2.",
          "type": "string"
        }
      ]
    },
    "Digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "EntityRef": {
      "description": "A typed reference to any IGNIS entity, used for lineage and provenance links.",
      "oneOf": [
        {
          "properties": {
            "id": {
              "$ref": "#/$defs/SourceId"
            },
            "kind": {
              "const": "source",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "id"
          ],
          "type": "object"
        },
        {
          "properties": {
            "id": {
              "$ref": "#/$defs/EvidenceId"
            },
            "kind": {
              "const": "evidence",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "id"
          ],
          "type": "object"
        },
        {
          "properties": {
            "id": {
              "$ref": "#/$defs/RunId"
            },
            "kind": {
              "const": "run",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "id"
          ],
          "type": "object"
        },
        {
          "properties": {
            "id": {
              "$ref": "#/$defs/ObservationId"
            },
            "kind": {
              "const": "observation",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "id"
          ],
          "type": "object"
        },
        {
          "properties": {
            "id": {
              "$ref": "#/$defs/DatasetId"
            },
            "kind": {
              "const": "dataset",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "id"
          ],
          "type": "object"
        },
        {
          "properties": {
            "id": {
              "$ref": "#/$defs/ArtifactId"
            },
            "kind": {
              "const": "artifact",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "id"
          ],
          "type": "object"
        },
        {
          "properties": {
            "id": {
              "$ref": "#/$defs/ReleaseId"
            },
            "kind": {
              "const": "release",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "id"
          ],
          "type": "object"
        },
        {
          "properties": {
            "id": {
              "$ref": "#/$defs/WikiPageId"
            },
            "kind": {
              "const": "wiki_page",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "id"
          ],
          "type": "object"
        },
        {
          "properties": {
            "id": {
              "$ref": "#/$defs/EpisodeId"
            },
            "kind": {
              "const": "episode",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "id"
          ],
          "type": "object"
        }
      ]
    },
    "EpisodeId": {
      "minLength": 1,
      "pattern": "^\\S+$",
      "type": "string"
    },
    "EvidenceId": {
      "minLength": 1,
      "pattern": "^\\S+$",
      "type": "string"
    },
    "ExecutionOutcome": {
      "description": "How the program ended.",
      "oneOf": [
        {
          "additionalProperties": false,
          "description": "The process exited by itself (any code; non-zero is the program's failure, not the host's).",
          "properties": {
            "exit_code": {
              "format": "int64",
              "type": "integer"
            },
            "kind": {
              "const": "exited",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "exit_code"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Killed at the wall-clock budget.",
          "properties": {
            "kind": {
              "const": "timed_out",
              "type": "string"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Killed by the memory budget.",
          "properties": {
            "kind": {
              "const": "out_of_memory",
              "type": "string"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        }
      ]
    },
    "JobId": {
      "minLength": 1,
      "pattern": "^\\S+$",
      "type": "string"
    },
    "MountedInput": {
      "additionalProperties": false,
      "description": "An input as the program saw it: `/in/<name>` held exactly these bytes (`artifact.sha256`,\nverified while copying). `resolved` says what a dataset or conditions reference resolved to; it\nis absent for a workspace artifact.",
      "properties": {
        "artifact": {
          "$ref": "#/$defs/ArtifactRef"
        },
        "name": {
          "type": "string"
        },
        "resolved": {
          "anyOf": [
            {
              "$ref": "#/$defs/ResolvedInput"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "name",
        "artifact"
      ],
      "type": "object"
    },
    "ObservationId": {
      "minLength": 1,
      "pattern": "^\\S+$",
      "type": "string"
    },
    "Origin": {
      "description": "Who produced a payload. `synthetic_fixture` marks hand-made contract examples; such payloads (and\nanything computed from them) can never be presented as NASA results or qualify a model.\nProduced-by-the-system payloads are `system` even when their *data* is synthetic (that is\n`EvidenceClass::Synthetic` / `TrainedOn::Synthetic`).",
      "enum": [
        "system",
        "synthetic_fixture"
      ],
      "type": "string"
    },
    "PageCursor": {
      "minLength": 1,
      "pattern": "^\\S+$",
      "type": "string"
    },
    "Partition": {
      "description": "Partition of a frozen split. `Test` is the lockbox: only an evaluation scope may read it.",
      "enum": [
        "train",
        "validation",
        "test"
      ],
      "type": "string"
    },
    "Producer": {
      "additionalProperties": false,
      "description": "What produced an artifact (all optional: an ingestion artifact has no episode).",
      "properties": {
        "episode_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/EpisodeId"
            },
            {
              "type": "null"
            }
          ]
        },
        "job_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/JobId"
            },
            {
              "type": "null"
            }
          ]
        },
        "release_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/ReleaseId"
            },
            {
              "type": "null"
            }
          ]
        },
        "tool_call_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/ToolCallId"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "type": "object"
    },
    "Quantity": {
      "enum": [
        "liquid_diameter",
        "visible_flame_diameter",
        "uv_flame_diameter",
        "droplet_position",
        "pressure",
        "mole_fraction",
        "temperature",
        "mass_flow",
        "volume_flow",
        "std_volume_flow",
        "front_contour",
        "front_position",
        "spread_rate",
        "flow_velocity",
        "gravity_level"
      ],
      "type": "string"
    },
    "RejectedOutput": {
      "additionalProperties": false,
      "description": "A path under `/out` that was not kept, and why (symbolic link, special file, budget).",
      "properties": {
        "path": {
          "type": "string"
        },
        "reason": {
          "type": "string"
        }
      },
      "required": [
        "path",
        "reason"
      ],
      "type": "object"
    },
    "ReleaseId": {
      "minLength": 1,
      "pattern": "^\\S+$",
      "type": "string"
    },
    "ResolvedInput": {
      "description": "What a by-reference input resolved to when it was mounted, so a result names exactly the data\nit read (and its units).",
      "oneOf": [
        {
          "additionalProperties": false,
          "description": "A view of a dataset bundle. `artifact` of the mounted input is the view's Parquet artifact.",
          "properties": {
            "bundle_digest": {
              "$ref": "#/$defs/Digest",
              "description": "[`super::DatasetBundle::content_digest`] of the bundle the view belongs to."
            },
            "columns": {
              "items": {
                "$ref": "#/$defs/ColumnSpec"
              },
              "type": "array"
            },
            "dataset_id": {
              "$ref": "#/$defs/DatasetId"
            },
            "kind": {
              "const": "dataset_view",
              "type": "string"
            },
            "partitions": {
              "description": "Partitions of the bundle, each granted by the scope that mounted it.",
              "items": {
                "$ref": "#/$defs/Partition"
              },
              "type": "array",
              "uniqueItems": true
            },
            "row_count": {
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            },
            "time_origin": {
              "description": "Event that defines t = 0 for every time column.",
              "type": "string"
            },
            "view": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "dataset_id",
            "view",
            "bundle_digest",
            "partitions",
            "time_origin",
            "columns",
            "row_count"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "The complete answer of a conditions query. `artifact` of the mounted input is the stored\n`ConditionsTable` document.",
          "properties": {
            "kind": {
              "const": "conditions",
              "type": "string"
            },
            "query": {
              "$ref": "#/$defs/ConditionsQuery"
            },
            "row_count": {
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            },
            "snapshot": {
              "$ref": "#/$defs/Digest",
              "description": "`conditions_snapshot` of the data the table was answered from."
            }
          },
          "required": [
            "kind",
            "query",
            "snapshot",
            "row_count"
          ],
          "type": "object"
        }
      ]
    },
    "RunId": {
      "minLength": 1,
      "pattern": "^\\S+$",
      "type": "string"
    },
    "RunnerEnvironment": {
      "additionalProperties": false,
      "description": "What a program ran in: the content address of the image, the OCI runtime and its isolation.",
      "properties": {
        "image_id": {
          "$ref": "#/$defs/Digest",
          "description": "Image id (`sha256:` of the image config), pinned by the host."
        },
        "interpreter": {
          "description": "Interpreter version reported by the image during preflight.",
          "type": "string"
        },
        "isolation": {
          "$ref": "#/$defs/RunnerIsolation"
        },
        "oci_runtime": {
          "description": "OCI runtime name as the container engine reports it (`runsc`, `runc`).",
          "type": "string"
        }
      },
      "required": [
        "image_id",
        "oci_runtime",
        "isolation",
        "interpreter"
      ],
      "type": "object"
    },
    "RunnerIsolation": {
      "description": "Isolation the runner actually provided. Recorded on every execution and in capability status;\nnever inferred from configuration alone (the preflight probe proves it).",
      "oneOf": [
        {
          "const": "gvisor",
          "description": "OCI container under gVisor (`runsc`): a user-space kernel between the program and the host.",
          "type": "string"
        },
        {
          "const": "container",
          "description": "OCI container under the host kernel (namespaces, seccomp, no capabilities). Development\nisolation; the public deployment uses `gvisor`.",
          "type": "string"
        }
      ]
    },
    "RunnerLimits": {
      "additionalProperties": false,
      "description": "Resource budget of one execution, set by the host (never by the request).",
      "properties": {
        "cpu_millis": {
          "description": "CPU quota in thousandths of a core.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "memory_bytes": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "output_bytes": {
          "description": "Total bytes of `/out` files kept as artifacts.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "pids": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "stream_bytes": {
          "description": "Bytes of stdout and of stderr each kept as an artifact (the rest is counted, not stored).",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "tmp_bytes": {
          "description": "Scratch space (`/tmp`, in memory).",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "wall_seconds": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "wall_seconds",
        "memory_bytes",
        "cpu_millis",
        "pids",
        "tmp_bytes",
        "output_bytes",
        "stream_bytes"
      ],
      "type": "object"
    },
    "SourceId": {
      "minLength": 1,
      "pattern": "^\\S+$",
      "type": "string"
    },
    "Timestamp": {
      "format": "date-time",
      "pattern": "Z$",
      "type": "string"
    },
    "ToolCallId": {
      "minLength": 1,
      "pattern": "^\\S+$",
      "type": "string"
    },
    "ToolsSchema": {
      "description": "Wire tag of tool results and descriptors.",
      "enum": [
        "tools.v1"
      ],
      "type": "string"
    },
    "WikiPageId": {
      "minLength": 1,
      "pattern": "^\\S+$",
      "type": "string"
    }
  },
  "$id": "ignis/2.1.0/ExecutionRecord",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "The record of one `analysis_execute` run (the job's first output artifact): code identity,\nenvironment, inputs, budget, outcome and the artifacts produced. A computed value cited in an\nanswer points into one of `outputs` (or `stdout`), and this record says how it was computed.",
  "properties": {
    "environment": {
      "$ref": "#/$defs/RunnerEnvironment"
    },
    "finished_at": {
      "$ref": "#/$defs/Timestamp"
    },
    "inputs": {
      "description": "Inputs as mounted.",
      "items": {
        "$ref": "#/$defs/MountedInput"
      },
      "type": "array"
    },
    "language": {
      "$ref": "#/$defs/AnalysisLanguage"
    },
    "limits": {
      "$ref": "#/$defs/RunnerLimits"
    },
    "origin": {
      "$ref": "#/$defs/Origin",
      "description": "`synthetic_fixture` when any input is."
    },
    "outcome": {
      "$ref": "#/$defs/ExecutionOutcome"
    },
    "outputs": {
      "items": {
        "$ref": "#/$defs/AnalysisOutput"
      },
      "type": "array"
    },
    "program": {
      "$ref": "#/$defs/ArtifactRef",
      "description": "The program exactly as executed."
    },
    "rejected_outputs": {
      "items": {
        "$ref": "#/$defs/RejectedOutput"
      },
      "type": "array"
    },
    "schema_version": {
      "$ref": "#/$defs/ToolsSchema"
    },
    "started_at": {
      "$ref": "#/$defs/Timestamp"
    },
    "stderr": {
      "$ref": "#/$defs/CapturedStream"
    },
