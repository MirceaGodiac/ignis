{
  "$defs": {
    "AtmosphereTarget": {
      "additionalProperties": false,
      "description": "`ConditionsQuery::near`: a named crew atmosphere, or explicit oxygen and pressure bounds\n(a point when min = max).",
      "properties": {
        "atmosphere": {
          "anyOf": [
            {
              "$ref": "#/$defs/CrewAtmosphere"
            },
            {
              "type": "null"
            }
          ]
        },
        "oxygen_max": {
          "type": [
            "number",
            "null"
          ]
        },
        "oxygen_min": {
          "type": [
            "number",
            "null"
          ]
        },
        "pressure_max_pa": {
          "type": [
            "number",
            "null"
          ]
        },
        "pressure_min_pa": {
          "type": [
            "number",
            "null"
          ]
        }
      },
      "type": "object"
    },
    "ConditionFilter": {
      "additionalProperties": false,
      "description": "A filter on one key. A filter keeps rows whose cell is a value inside it; rows whose cell is\nmissing or conflicting are kept only with `ConditionsQuery::include_unknown`.",
      "properties": {
        "any_of": {
          "description": "Categorical keys.",
          "items": {
            "type": "string"
          },
          "type": "array",
          "uniqueItems": true
        },
        "key": {
          "$ref": "#/$defs/ConditionKey"
        },
        "max_si": {
          "type": [
            "number",
            "null"
          ]
        },
        "min_si": {
          "description": "Numeric keys, SI.",
          "type": [
            "number",
            "null"
          ]
        }
      },
      "required": [
        "key"
      ],
      "type": "object"
    },
    "ConditionKey": {
      "description": "A condition the challenge and the graph join on. Numeric keys are stored in the SI unit of their\n[`Quantity`]; the others are categorical text (`n-heptane`, `flat sheet`, `CIR/MDCA`). The\ncatalog is closed: a new key is a contract change.",
      "enum": [
        "oxygen_mole_fraction",
        "pressure",
        "flow_velocity",
        "gravity_level",
        "ambient_temperature",
        "fuel",
        "diluent",
        "sample_geometry",
        "hardware",
        "diagnostics"
      ],
      "type": "string"
    },
    "CrewAtmosphere": {
      "description": "A crew atmosphere named by the Flame in Freefall challenge.",
      "oneOf": [
        {
          "const": "moon_base",
          "description": "Moon base and rovers: oxygen ≥ 30 % at 4.3–10.2 psi (29.6–70.3 kPa).",
          "type": "string"
        },
        {
          "const": "spacesuit",
          "description": "Spacesuit: 100 % oxygen at 4.3 psi (29.6 kPa).",
          "type": "string"
        },
        {
          "const": "iss_earth",
          "description": "ISS and Earth: 21 % oxygen at 14.7 psi (101.3 kPa).",
          "type": "string"
        }
      ]
    },
    "DatasetSchema": {
      "description": "Wire tag of dataset, visual observation and conditions documents. Wave K1 writes `dataset.v2`;\n`dataset.v1` (C0) documents are still read, and keep their content digests because a\ndocument is re-serialized with the tag it was read with. New document types require v2.",
      "oneOf": [
        {
          "enum": [
            "dataset.v2"
          ],
          "type": "string"
        },
        {
          "const": "dataset.v1",
          "description": "C0. Still read; new documents are written as v2.",
          "type": "string"
        }
      ]
    },
    "PageCursor": {
      "minLength": 1,
      "pattern": "^\\S+$",
      "type": "string"
    },
    "RunId": {
      "minLength": 1,
      "pattern": "^\\S+$",
      "type": "string"
    }
  },
  "$id": "ignis/2.1.0/ConditionsQuery",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "`conditions_query`: per-run conditions and, on request, each investigation's tested envelope.",
  "properties": {
    "cursor": {
      "anyOf": [
        {
          "$ref": "#/$defs/PageCursor"
        },
        {
          "type": "null"
        }
      ]
    },
    "filters": {
      "items": {
        "$ref": "#/$defs/ConditionFilter"
      },
      "type": "array"
    },
    "include_envelopes": {
      "default": false,
      "type": "boolean"
    },
    "include_unknown": {
      "default": false,
      "type": "boolean"
    },
    "investigation_ids": {
      "description": "Empty = every investigation.",
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "keys": {
      "description": "Columns; empty = every key.",
      "items": {
        "$ref": "#/$defs/ConditionKey"
      },
      "type": "array"
    },
    "near": {
      "anyOf": [
        {
          "$ref": "#/$defs/AtmosphereTarget"
        },
        {
          "type": "null"
        }
      ],
      "description": "Rank the matching rows by how near their ambient oxygen and pressure are to this target,\nnearest first (each row then carries `nearness`). Rows without both values are left out."
    },
    "page_size": {
      "format": "uint32",
      "minimum": 0,
      "type": [
        "integer",
        "null"
      ]
    },
    "run_ids": {
      "items": {
        "$ref": "#/$defs/RunId"
      },
      "type": "array"
    },
    "schema_version": {
      "$ref": "#/$defs/DatasetSchema"
    }
  },
  "required": [
    "schema_version"
  ],
  "title": "ConditionsQuery",
  "type": "object"
}
