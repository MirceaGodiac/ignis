{
  "$defs": {
    "EvidenceSchema": {
      "description": "Wire tag of the knowledge documents. Wave K1 writes `evidence.v2`; `evidence.v1` (C0) documents\nare still read. An addition of v2 (a field, a relation, a concept node, a new document type) is\nrefused under the v1 tag, so a v1 reader never receives a document it would misread.",
      "oneOf": [
        {
          "enum": [
            "evidence.v2"
          ],
          "type": "string"
        },
        {
          "const": "evidence.v1",
          "description": "C0. Still read; new documents are written as v2.",
          "type": "string"
        }
      ]
    },
    "PageCursor": {
      "minLength": 1,
      "pattern": "^\\S+$",
      "type": "string"
    },
    "WikiPageId": {
      "minLength": 1,
      "pattern": "^\\S+$",
      "type": "string"
    }
  },
  "$id": "ignis/2.1.0/WikiReadRequest",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "`wiki_read`: one page (head, or a given revision), or the page index when `page_id` is absent.",
  "properties": {
    "cursor": {
      "anyOf": [
        {
          "$ref": "#/$defs/PageCursor"
        },
        {
          "type": "null"
        }
      ],
      "description": "Index only."
    },
    "page_id": {
      "anyOf": [
        {
          "$ref": "#/$defs/WikiPageId"
        },
        {
          "type": "null"
        }
      ]
    },
    "page_size": {
      "description": "Index only.",
      "format": "uint32",
      "minimum": 0,
      "type": [
        "integer",
        "null"
      ]
    },
    "revision": {
      "format": "uint64",
      "minimum": 0,
      "type": [
        "integer",
        "null"
      ]
    },
    "schema_version": {
      "$ref": "#/$defs/EvidenceSchema"
    }
  },
  "required": [
    "schema_version"
  ],
  "title": "WikiReadRequest",
  "type": "object"
}
