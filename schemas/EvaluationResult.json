{
  "$defs": {
    "ArtifactId": {
      "minLength": 1,
      "pattern": "^\\S+$",
      "type": "string"
    },
    "ArtifactRef": {
      "additionalProperties": false,
      "description": "Reference to immutable bytes in the artifact store. Never a filesystem path or a URL: a download\nlink is resolved through the access service, may expire, and does not change the artifact.",
      "properties": {
        "artifact_id": {
          "$ref": "#/$defs/ArtifactId"
        },
        "byte_length": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "contract": {
          "description": "Exported contract type of the content when it is a JSON/JSONL contract document\n(`\"AnalysisArtifact\"`, `\"ResearchAnswer\"`, ...). Consumers dispatch on it.",
          "type": [
            "string",
            "null"
          ]
        },
        "created_at": {
          "$ref": "#/$defs/Timestamp"
        },
        "inputs": {
          "description": "Entities this artifact was computed from (lineage, not access grants).",
          "items": {
            "$ref": "#/$defs/EntityRef"
          },
          "type": "array"
        },
        "media_type": {
          "description": "IANA media type, e.g. `application/json`, `application/vnd.apache.parquet`, `image/png`.",
          "type": "string"
        },
        "origin": {
          "$ref": "#/$defs/Origin"
        },
        "produced_by": {
          "$ref": "#/$defs/Producer"
        },
        "sha256": {
          "$ref": "#/$defs/Digest"
        }
      },
      "required": [
        "artifact_id",
        "sha256",
        "media_type",
        "byte_length",
        "origin",
        "created_at"
      ],
      "type": "object"
    },
    "CaseAccounting": {
      "additionalProperties": false,
      "description": "Every case of the protocol is counted: failures and refusals stay in the denominator. For a\nharness benchmark a case is one (task, arm, repetition) run.",
      "properties": {
        "failed": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "refused": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "scored": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "total": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "total",
        "scored",
        "refused",
        "failed"
      ],
      "type": "object"
    },
    "CaseFailure": {
      "additionalProperties": false,
      "properties": {
        "case_id": {
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/CaseFailureKind"
        },
        "reason": {
          "type": "string"
        },
        "subject": {
          "$ref": "#/$defs/ReleaseId"
        }
      },
      "required": [
        "case_id",
        "subject",
        "kind",
        "reason"
      ],
      "type": "object"
    },
    "CaseFailureKind": {
      "enum": [
        "refused",
        "failed"
      ],
      "type": "string"
    },
    "ClientRequestId": {
      "minLength": 1,
      "pattern": "^\\S+$",
      "type": "string"
    },
    "ClusterBy": {
      "description": "How tasks are grouped for the cluster bootstrap of paired deltas.",
      "oneOf": [
        {
          "const": "task_cluster",
          "description": "The task's `cluster` field (study or run group).",
          "type": "string"
        },
        {
          "const": "task",
          "description": "Each task its own cluster.",
          "type": "string"
        }
      ]
    },
    "ComputeUsage": {
      "additionalProperties": false,
      "properties": {
        "cpu_time_s": {
          "type": [
            "number",
            "null"
          ]
        },
        "wall_time_s": {
          "type": "number"
        }
      },
      "required": [
        "wall_time_s"
      ],
      "type": "object"
    },
    "CostTotal": {
      "additionalProperties": false,
      "description": "A money amount summed from traces. Absent when any run's cost is unknown: never a guess.",
      "properties": {
        "amount": {
          "type": "number"
        },
        "currency": {
          "description": "ISO 4217 code, e.g. `USD`.",
          "type": "string"
        }
      },
      "required": [
        "amount",
        "currency"
      ],
      "type": "object"
    },
    "DatasetId": {
      "minLength": 1,
      "pattern": "^\\S+$",
      "type": "string"
    },
    "Digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "EntityRef": {
      "description": "A typed reference to any IGNIS entity, used for lineage and provenance links.",
      "oneOf": [
        {
          "properties": {
            "id": {
              "$ref": "#/$defs/SourceId"
            },
            "kind": {
              "const": "source",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "id"
          ],
          "type": "object"
        },
        {
          "properties": {
            "id": {
              "$ref": "#/$defs/EvidenceId"
            },
            "kind": {
              "const": "evidence",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "id"
          ],
          "type": "object"
        },
        {
          "properties": {
            "id": {
              "$ref": "#/$defs/RunId"
            },
            "kind": {
              "const": "run",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "id"
          ],
          "type": "object"
        },
        {
          "properties": {
            "id": {
              "$ref": "#/$defs/ObservationId"
            },
            "kind": {
              "const": "observation",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "id"
          ],
          "type": "object"
        },
        {
          "properties": {
            "id": {
              "$ref": "#/$defs/DatasetId"
            },
            "kind": {
              "const": "dataset",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "id"
          ],
          "type": "object"
        },
        {
          "properties": {
            "id": {
              "$ref": "#/$defs/ArtifactId"
            },
            "kind": {
              "const": "artifact",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "id"
          ],
          "type": "object"
        },
        {
          "properties": {
            "id": {
              "$ref": "#/$defs/ReleaseId"
            },
            "kind": {
              "const": "release",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "id"
          ],
          "type": "object"
        },
        {
          "properties": {
            "id": {
              "$ref": "#/$defs/WikiPageId"
            },
            "kind": {
              "const": "wiki_page",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "id"
          ],
          "type": "object"
        },
        {
          "properties": {
            "id": {
              "$ref": "#/$defs/EpisodeId"
            },
            "kind": {
              "const": "episode",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "id"
          ],
          "type": "object"
        }
      ]
    },
    "EpisodeId": {
      "minLength": 1,
      "pattern": "^\\S+$",
      "type": "string"
    },
    "EvaluationId": {
      "minLength": 1,
      "pattern": "^\\S+$",
      "type": "string"
    },
    "EvaluationPurpose": {
      "oneOf": [
        {
          "const": "development_feedback",
          "description": "Repeatable feedback on train/validation, shown to authors (W1).",
          "type": "string"
        },
        {
          "const": "final_test",
          "description": "The lockbox run on the frozen protocol. Results are not shown to authors as feedback.",
          "type": "string"
        },
        {
          "const": "harness_benchmark",
          "description": "v2: harness variants compared on a gold set (H0/H1 and ablations). Not a model evaluation:\nit never qualifies a release.",
          "type": "string"
        }
      ]
    },
    "EvaluationRequest": {
      "additionalProperties": false,
      "properties": {
        "baselines": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ModelUnderTest"
          },
          "type": "array"
        },
        "candidate": {
          "anyOf": [
            {
              "$ref": "#/$defs/ModelUnderTest"
            },
            {
              "type": "null"
            }
          ]
        },
        "client_request_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/ClientRequestId"
            },
            {
              "type": "null"
            }
          ]
        },
        "cutoffs_s": {
          "description": "Prefix cutoffs in seconds since the dataset's time origin, strictly increasing. Model\npurposes only (empty for a harness benchmark).",
          "items": {
            "type": "number"
          },
          "type": "array"
        },
        "dataset_hash": {
          "anyOf": [
            {
              "$ref": "#/$defs/Digest"
            },
            {
              "type": "null"
            }
          ],
          "description": "`DatasetBundle::content_digest` of the bundle evaluated. Model purposes only."
        },
        "dataset_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/DatasetId"
            },
            {
              "type": "null"
            }
          ]
        },
        "harness": {
          "anyOf": [
            {
              "$ref": "#/$defs/HarnessBenchmark"
            },
            {
              "type": "null"
            }
          ],
          "description": "v2, harness benchmark only."
        },
        "metrics": {
          "items": {
            "$ref": "#/$defs/MetricSpec"
          },
          "type": "array"
        },
        "partition": {
          "$ref": "#/$defs/Partition",
          "description": "For a harness benchmark: `validation` on a dev set, `test` on the hold-out."
        },
        "protocol": {
          "$ref": "#/$defs/ProtocolRef"
        },
        "purpose": {
          "$ref": "#/$defs/EvaluationPurpose"
        },
        "request_id": {
          "$ref": "#/$defs/EvaluationId"
        },
        "schema_version": {
          "$ref": "#/$defs/EvaluationSchema"
        },
        "split_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "target": {
          "anyOf": [
            {
              "$ref": "#/$defs/Quantity"
            },
            {
              "type": "null"
            }
          ],
          "description": "Model purposes only (absent for a harness benchmark)."
        },
        "unit": {
          "description": "SI unit of the target; must equal `target`'s. Model purposes only.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "schema_version",
        "request_id",
        "purpose",
        "protocol",
        "partition",
        "metrics"
      ],
      "type": "object"
    },
    "EvaluationSchema": {
      "description": "Wire tag of gold tasks, evaluation requests and results. Wave K1 writes `evaluation.v2`;\n`evaluation.v1` (C0) documents are still read and keep their `request_hash`, because a document\nis re-serialized with the tag it was read with and v1 documents never carry a v2 field. A v2\naddition (a gold task or set, a harness benchmark) is refused under the v1 tag.",
      "oneOf": [
        {
          "enum": [
            "evaluation.v2"
          ],
          "type": "string"
        },
        {
          "const": "evaluation.v1",
          "description": "C0. Still read; new documents are written as v2.",
          "type": "string"
        }
      ]
    },
    "EvidenceId": {
      "minLength": 1,
      "pattern": "^\\S+$",
      "type": "string"
    },
    "ForecastSettings": {
      "additionalProperties": false,
      "description": "Settings of a forecast request (strict: unknown fields are refused).",
      "properties": {
        "horizon_s": {
          "default": null,
          "format": "double",
          "type": [
            "number",
            "null"
          ]
        },
        "n_points": {
          "default": null,
          "format": "uint32",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "quantile_levels": {
          "default": null,
          "items": {
            "format": "double",
            "type": "number"
          },
          "type": [
            "array",
            "null"
          ]
        },
        "seed": {
          "default": 0,
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "times_s": {
          "description": "Explicit forecast times (s since the time origin). Lets cases at different cutoffs share one\ntime grid so that event metrics compare like with like.",
          "items": {
            "format": "double",
            "type": "number"
          },
          "type": [
            "array",
            "null"
          ]
        }
      },
      "type": "object"
    },
    "GoldSetId": {
      "minLength": 1,
      "pattern": "^\\S+$",
      "type": "string"
    },
    "GoldSetRef": {
      "additionalProperties": false,
      "description": "The gold set a benchmark runs on, pinned by digest.",
      "properties": {
        "set_hash": {
          "$ref": "#/$defs/Digest"
        },
        "set_id": {
          "$ref": "#/$defs/GoldSetId"
        },
        "split": {
          "$ref": "#/$defs/GoldSplit"
        },
        "task_count": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "set_id",
        "set_hash",
        "split",
        "task_count"
      ],
      "type": "object"
    },
    "GoldSplit": {
      "description": "Which half of the gold tasks: the dev set shared with the builders, or the private hold-out kept\nin the evaluator vault, run once on a frozen protocol (LAB-Bench style).",
      "enum": [
        "dev",
        "holdout"
      ],
      "type": "string"
    },
    "GoldTaskId": {
      "minLength": 1,
      "pattern": "^\\S+$",
      "type": "string"
    },
    "HarnessBenchmark": {
      "additionalProperties": false,
      "properties": {
        "baseline": {
          "description": "The arm deltas are measured against (H0).",
          "type": "string"
        },
        "cluster_by": {
          "$ref": "#/$defs/ClusterBy"
        },
        "gold_set": {
          "$ref": "#/$defs/GoldSetRef"
        },
        "repetitions": {
          "description": "Runs per task and arm (seeds); deltas are paired on (task, repetition).",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "variants": {
          "description": "One arm measures a harness; two or more compare harnesses. All arms share the runtime\nbuild, model and effort, so only the harness differs.",
          "items": {
            "$ref": "#/$defs/HarnessVariant"
          },
          "type": "array"
        }
      },
      "required": [
        "gold_set",
        "variants",
        "baseline",
        "repetitions",
        "cluster_by"
      ],
      "type": "object"
    },
    "HarnessComparison": {
      "additionalProperties": false,
      "properties": {
        "deltas": {
          "default": [],
          "items": {
            "$ref": "#/$defs/PairedDelta"
          },
          "type": "array"
        },
        "runs": {
          "description": "Every planned run (task × arm × repetition), including refused and failed ones.",
          "items": {
            "$ref": "#/$defs/HarnessRunResult"
          },
          "type": "array"
        },
        "scores": {
          "items": {
            "$ref": "#/$defs/VariantScore"
          },
          "type": "array"
        }
      },
      "required": [
        "runs",
        "scores"
      ],
      "type": "object"
    },
    "HarnessRunResult": {
      "additionalProperties": false,
      "description": "One (task, arm, repetition) run. Its trace (research.v2 `TraceBundle`) holds the cost and\ntokens; the run refers to it by id.",
      "properties": {
        "answered": {
          "description": "False when the agent chose \"insufficient evidence\" (precision counts only answered runs).",
          "type": "boolean"
        },
        "outcome": {
          "$ref": "#/$defs/RunOutcome"
        },
        "repetition": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "score": {
          "description": "Task score in [0, 1]; present exactly for a scored run.",
          "type": [
            "number",
            "null"
          ]
        },
        "task_id": {
          "$ref": "#/$defs/GoldTaskId"
        },
        "trace_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/TraceId"
            },
            {
              "type": "null"
            }
          ]
        },
        "variant": {
          "type": "string"
        }
      },
      "required": [
        "variant",
        "task_id",
        "repetition",
        "outcome",
        "answered"
      ],
      "type": "object"
    },
    "HarnessVariant": {
      "additionalProperties": false,
      "description": "One harness arm. Refers to the harness bundle by digest (research.v2 `HarnessRef`), never by\nembedding it.",
      "properties": {
        "effort": {
          "type": [
            "string",
            "null"
          ]
        },
        "harness_digest": {
          "$ref": "#/$defs/Digest"
        },
        "model": {
          "type": "string"
        },
        "name": {
          "description": "Short name (`h0`, `h1`, `h1-no-wiki`); unique in the benchmark.",
          "type": "string"
        },
        "runtime_build": {
          "$ref": "#/$defs/RuntimeBuildId"
        }
      },
      "required": [
        "name",
        "harness_digest",
        "runtime_build",
        "model"
      ],
      "type": "object"
    },
    "Interval": {
      "additionalProperties": false,
      "description": "A two-sided interval at `level` (e.g. 0.95).",
      "properties": {
        "hi": {
          "type": "number"
        },
        "level": {
          "type": "number"
        },
        "lo": {
          "type": "number"
        }
      },
      "required": [
        "lo",
        "hi",
        "level"
      ],
      "type": "object"
    },
    "JobId": {
      "minLength": 1,
      "pattern": "^\\S+$",
      "type": "string"
    },
    "MetricSpec": {
      "additionalProperties": false,
      "properties": {
        "metric": {
          "description": "Scorer id in `ignis-lab/src/eval` (e.g. `crps`, `pinball`, `interval_coverage`, `brier_ipcw`;\nfor a harness benchmark e.g. `accuracy`, `precision`, `citation_support`, `check_pass`).",
          "type": "string"
        },
        "version": {
          "type": "string"
        }
      },
      "required": [
        "metric",
        "version"
      ],
      "type": "object"
    },
    "MetricValue": {
      "additionalProperties": false,
      "properties": {
        "group": {
          "additionalProperties": {
            "type": "string"
          },
          "description": "Group key (e.g. `{\"fuel\": \"heptane\"}`); absent for the overall value.",
          "type": "object"
        },
        "metric": {
          "type": "string"
        },
        "n": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "population": {
          "$ref": "#/$defs/Population"
        },
        "subject": {
          "$ref": "#/$defs/ReleaseId"
        },
        "unit": {
          "type": "string"
        },
        "value": {
          "description": "Absent when undefined (no cases), never zero by default.",
          "type": [
            "number",
            "null"
          ]
        },
        "version": {
          "type": "string"
        }
      },
      "required": [
        "metric",
        "version",
        "subject",
        "population",
        "unit",
        "n"
      ],
      "type": "object"
    },
    "ModelUnderTest": {
      "additionalProperties": false,
      "description": "A model under evaluation: release, forward code identity and the settings it runs with.",
      "properties": {
        "forward_hash": {
          "anyOf": [
            {
              "$ref": "#/$defs/Digest"
            },
            {
              "type": "null"
            }
          ]
        },
        "release_id": {
          "$ref": "#/$defs/ReleaseId"
        },
        "settings": {
          "$ref": "#/$defs/ForecastSettings",
          "default": {
            "horizon_s": null,
            "n_points": null,
            "quantile_levels": null,
            "seed": 0
          }
        }
      },
      "required": [
        "release_id"
      ],
      "type": "object"
    },
    "ObservationId": {
      "minLength": 1,
      "pattern": "^\\S+$",
      "type": "string"
    },
    "Origin": {
      "description": "Who produced a payload. `synthetic_fixture` marks hand-made contract examples; such payloads (and\nanything computed from them) can never be presented as NASA results or qualify a model.\nProduced-by-the-system payloads are `system` even when their *data* is synthetic (that is\n`EvidenceClass::Synthetic` / `TrainedOn::Synthetic`).",
      "enum": [
        "system",
        "synthetic_fixture"
      ],
      "type": "string"
    },
    "PairedDelta": {
      "additionalProperties": false,
      "description": "`variant − baseline` on one metric, paired on (task, repetition), with a cluster-bootstrap\ninterval over `clusters` clusters.",
      "properties": {
        "baseline": {
          "type": "string"
        },
        "clusters": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "delta": {
          "type": "number"
        },
        "interval": {
          "$ref": "#/$defs/Interval"
        },
        "metric": {
          "type": "string"
        },
        "pairs": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "variant": {
          "type": "string"
        }
      },
      "required": [
        "metric",
        "baseline",
        "variant",
        "delta",
        "interval",
        "pairs",
        "clusters"
      ],
      "type": "object"
    },
    "Partition": {
      "description": "Partition of a frozen split. `Test` is the lockbox: only an evaluation scope may read it.",
      "enum": [
        "train",
        "validation",
        "test"
      ],
      "type": "string"
    },
    "Population": {
      "description": "Population a metric is computed over. Conditional quality (scored cases only) is always shown\nnext to coverage over all cases.",
      "enum": [
        "scored_cases",
        "all_cases"
      ],
      "type": "string"
    },
    "Producer": {
      "additionalProperties": false,
      "description": "What produced an artifact (all optional: an ingestion artifact has no episode).",
      "properties": {
        "episode_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/EpisodeId"
            },
            {
              "type": "null"
            }
          ]
        },
        "job_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/JobId"
            },
            {
              "type": "null"
            }
          ]
        },
        "release_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/ReleaseId"
            },
            {
              "type": "null"
            }
          ]
        },
        "tool_call_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/ToolCallId"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "type": "object"
    },
    "ProtocolRef": {
      "additionalProperties": false,
      "properties": {
        "frozen_hash": {
          "anyOf": [
            {
              "$ref": "#/$defs/Digest"
            },
            {
              "type": "null"
            }
          ],
          "description": "Digest of the frozen protocol (targets, groups, metrics, cutoffs). Required for a final test\nand for anything that touches the hold-out."
        },
        "protocol_id": {
          "type": "string"
        },
        "version": {
          "type": "string"
        }
      },
      "required": [
        "protocol_id",
        "version"
      ],
      "type": "object"
    },
    "Quantity": {
      "enum": [
        "liquid_diameter",
        "visible_flame_diameter",
        "uv_flame_diameter",
        "droplet_position",
        "pressure",
        "mole_fraction",
        "temperature",
        "mass_flow",
        "volume_flow",
        "std_volume_flow",
        "front_contour",
        "front_position",
        "spread_rate",
        "flow_velocity",
        "gravity_level"
      ],
      "type": "string"
    },
    "ReleaseId": {
      "minLength": 1,
      "pattern": "^\\S+$",
      "type": "string"
    },
    "RunId": {
      "minLength": 1,
      "pattern": "^\\S+$",
      "type": "string"
    },
    "RunOutcome": {
      "oneOf": [
        {
          "const": "scored",
          "description": "The run finished and was scored.",
          "type": "string"
        },
        {
          "const": "refused",
          "description": "The runtime or host declined (scope, input, unsupported).",
          "type": "string"
        },
        {
          "const": "failed",
          "description": "A technical failure or a timeout: no answer to score.",
          "type": "string"
        }
      ]
    },
    "RuntimeBuildId": {
      "minLength": 1,
      "pattern": "^\\S+$",
      "type": "string"
    },
    "SourceId": {
      "minLength": 1,
      "pattern": "^\\S+$",
      "type": "string"
    },
    "Timestamp": {
      "format": "date-time",
      "pattern": "Z$",
      "type": "string"
    },
    "ToolCallId": {
      "minLength": 1,
      "pattern": "^\\S+$",
      "type": "string"
    },
    "TraceId": {
      "minLength": 1,
      "pattern": "^\\S+$",
      "type": "string"
    },
    "VariantScore": {
      "additionalProperties": false,
      "description": "One metric of one arm over its runs.",
      "properties": {
        "cost": {
          "anyOf": [
            {
              "$ref": "#/$defs/CostTotal"
            },
            {
              "type": "null"
            }
          ]
        },
        "interval": {
          "anyOf": [
            {
              "$ref": "#/$defs/Interval"
            },
            {
              "type": "null"
            }
          ]
        },
        "metric": {
          "type": "string"
        },
        "n": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "tokens": {
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "value": {
          "description": "Absent when undefined (no runs it applies to).",
          "type": [
            "number",
            "null"
          ]
        },
        "variant": {
          "type": "string"
        },
        "version": {
          "type": "string"
        }
      },
      "required": [
        "variant",
        "metric",
        "version",
        "n"
      ],
      "type": "object"
    },
    "Verdict": {
      "description": "What the result says about the candidate's qualification for the declared target.",
      "oneOf": [
        {
          "enum": [
            "not_assessed",
            "inconclusive",
            "not_qualified"
          ],
          "type": "string"
        },
        {
          "const": "qualified",
          "description": "Only from a system-produced final test on a frozen protocol.",
          "type": "string"
        }
      ]
    },
    "WikiPageId": {
      "minLength": 1,
      "pattern": "^\\S+$",
      "type": "string"
    }
  },
  "$id": "ignis/2.1.0/EvaluationResult",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "cases": {
      "$ref": "#/$defs/CaseAccounting"
    },
    "compute": {
      "anyOf": [
        {
          "$ref": "#/$defs/ComputeUsage"
        },
        {
          "type": "null"
        }
      ]
    },
    "coverage": {
      "description": "`scored / total` for the candidate, or over all runs of a harness benchmark (0 when there are\nno cases).",
      "type": "number"
    },
    "created_at": {
      "$ref": "#/$defs/Timestamp"
    },
    "failures": {
      "default": [],
      "description": "Candidate failures; when `per_case` is absent this list is complete. Empty for a harness\nbenchmark, whose refused and failed runs are in `harness.runs`.",
      "items": {
        "$ref": "#/$defs/CaseFailure"
      },
      "type": "array"
    },
    "harness": {
      "anyOf": [
        {
          "$ref": "#/$defs/HarnessComparison"
        },
        {
          "type": "null"
        }
      ],
      "description": "v2, harness benchmark only."
    },
    "metrics": {
      "description": "Model metrics (subject = a release). Empty for a harness benchmark, whose metrics are in\n`harness`.",
      "items": {
        "$ref": "#/$defs/MetricValue"
      },
      "type": "array"
    },
    "origin": {
      "$ref": "#/$defs/Origin"
    },
    "per_case": {
      "anyOf": [
        {
          "$ref": "#/$defs/ArtifactRef"
        },
        {
          "type": "null"
        }
      ],
      "description": "Per-case outputs and scores (Parquet/JSONL)."
    },
    "request": {
      "$ref": "#/$defs/EvaluationRequest",
      "description": "The request, embedded so a result is self-describing."
    },
    "request_hash": {
      "$ref": "#/$defs/Digest"
    },
    "result_id": {
      "$ref": "#/$defs/EvaluationId"
    },
    "schema_version": {
      "$ref": "#/$defs/EvaluationSchema"
    },
    "verdict": {
      "$ref": "#/$defs/Verdict"
    }
  },
  "required": [
    "schema_version",
    "result_id",
    "request",
    "request_hash",
    "cases",
    "coverage",
    "metrics",
    "verdict",
    "origin",
    "created_at"
  ],
  "title": "EvaluationResult",
  "type": "object"
}
