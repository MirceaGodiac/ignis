{
  "$defs": {
    "ApprovalId": {
      "minLength": 1,
      "pattern": "^\\S+$",
      "type": "string"
    },
    "EpisodeId": {
      "minLength": 1,
      "pattern": "^\\S+$",
      "type": "string"
    },
    "HostDecision": {
      "description": "A host decision on an approval the runtime requested: the subset of [`ApprovalDecision`] a\nperson may send (`expired` and `cancelled` are the host's own).",
      "enum": [
        "approved",
        "denied"
      ],
      "type": "string"
    }
  },
  "$id": "ignis/2.1.0/ApprovalAccepted",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Answer of `POST /api/v1/episodes/{id}/approvals/{approval_id}` (202).",
  "properties": {
    "approval_id": {
      "$ref": "#/$defs/ApprovalId"
    },
    "decision": {
      "$ref": "#/$defs/HostDecision"
    },
    "episode_id": {
      "$ref": "#/$defs/EpisodeId"
    }
  },
  "required": [
    "episode_id",
    "approval_id",
    "decision"
  ],
  "title": "ApprovalAccepted",
  "type": "object"
}
