# /etc/ignis/release.env — what is running (written by infra/scripts/release.sh; root 0644).
# Every image is named by digest/id, never by a moving tag.
IGNIS_IMAGE=ignis-server@sha256:<digest>
CLOUDFLARED_IMAGE=cloudflare/cloudflared@sha256:<digest>
DOCKER_GID=<gid of /var/run/docker.sock>
IGNIS_ENV_FILE=/etc/ignis/ignis.env
CLOUDFLARED_ENV_FILE=/etc/ignis/cloudflared.env
IGNIS_SECRETS_DIR=/etc/ignis/secrets
# Backups: bucket prefix of the state snapshots.
IGNIS_BACKUP_PREFIX=backups/
