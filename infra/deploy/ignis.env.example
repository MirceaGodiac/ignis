# /etc/ignis/ignis.env — configuration of the ignis container. For now it also holds the
# credentials as plain entries (root:root 0600): fill only the ones you use, leave the rest empty.
# Sealing them into /etc/ignis/secrets files comes later (infra/README.md §Credentials).

# --- Cloudflare Access (both applications; AUD tags from the Zero Trust dashboard)
IGNIS_ACCESS_TEAM_DOMAIN=https://<team>.cloudflareaccess.com
IGNIS_ACCESS_ORIGIN_AUD=<aud tag of the origin (tunnel hostname) application>
IGNIS_ACCESS_USER_AUD=<aud tag of the UI hostname application>
IGNIS_ACCESS_SERVICE_TOKEN_ID=<client id of the Worker's service token>

# --- R2 artifact store
IGNIS_R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
IGNIS_R2_BUCKET=ignis-artifacts
IGNIS_R2_ACCESS_KEY_ID=<R2 API token access key id>
IGNIS_R2_SECRET_ACCESS_KEY=

# --- Agent runtime: codex (Codex App Server) or claude (Claude Code). Both binaries are in the image.
IGNIS_AGENT_RUNTIME=codex
IGNIS_CODEX_SHA256=<sha256 of the codex binary, from the release manifest>
# IGNIS_CODEX_MODEL=
IGNIS_CLAUDE_BIN=/usr/local/bin/claude
# IGNIS_CLAUDE_MODEL=

# --- Model credentials: one per runtime is enough.
# Codex, API billing:
CODEX_API_KEY=
# Codex, ChatGPT plan: sign in once (infra/README.md §Plan sign-in), then uncomment.
# IGNIS_CODEX_LOGIN_HOME=/srv/ignis/login/codex
# Claude, plan token (`claude setup-token`) or API billing:
CLAUDE_CODE_OAUTH_TOKEN=
ANTHROPIC_API_KEY=
# Claude, signed-in config directory instead of a token:
# IGNIS_CLAUDE_LOGIN_HOME=/srv/ignis/login/claude

# --- Isolated runner (image id from tools/runner/build.sh; gVisor required)
IGNIS_RUNNER_IMAGE=sha256:<runner image id>
IGNIS_RUNNER_RUNTIME=runsc

# --- Model families (FLEX/ACME/BASS): off until their releases are qualified. Their contracts and
# tool descriptors stay published; /api/v1/capabilities reports them as disabled.
# IGNIS_ENABLE_MODELS=true
