# /etc/ignis/ignis.env — non-secret configuration of the ignis container (root:root 0644).
# Secrets are files in /etc/ignis/secrets (see infra/README.md §Secrets), never here.

# --- Cloudflare Access (both applications; AUD tags from the Zero Trust dashboard)
IGNIS_ACCESS_TEAM_DOMAIN=https://<team>.cloudflareaccess.com
IGNIS_ACCESS_ORIGIN_AUD=<aud tag of the origin (tunnel hostname) application>
IGNIS_ACCESS_USER_AUD=<aud tag of the UI hostname application>
IGNIS_ACCESS_SERVICE_TOKEN_ID=<client id of the Worker's service token>

# --- R2 artifact store
IGNIS_R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
IGNIS_R2_BUCKET=ignis-artifacts
IGNIS_R2_ACCESS_KEY_ID=<R2 API token access key id; secret in /etc/ignis/secrets>

# --- Agent runtime (pinned Codex; the binary is in the image)
IGNIS_CODEX_SHA256=<sha256 of the codex binary, from the release manifest>
# IGNIS_CODEX_MODEL=

# --- Isolated runner (image id from tools/runner/build.sh; gVisor required)
IGNIS_RUNNER_IMAGE=sha256:<runner image id>
IGNIS_RUNNER_RUNTIME=runsc
