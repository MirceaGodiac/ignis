# Polls the deploy branch every minute (a no-op when nothing changed: one `git fetch`).
# Pause deploys without disabling the timer: `echo "reason" | sudo tee /etc/ignis/autodeploy.hold`.
[Unit]
Description=Poll GitHub for a new IGNIS release

[Timer]
OnBootSec=10min
OnUnitInactiveSec=1min
RandomizedDelaySec=10

[Install]
WantedBy=timers.target
