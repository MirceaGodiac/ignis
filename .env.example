# IGNIS environment: local development template.
#
#   cp .env.example .env
#   set -a; . ./.env; set +a          # bash / Git Bash: export every line into this shell
#   ignis serve --dev                 # then http://127.0.0.1:8787/api
#
# Nothing in IGNIS reads .env by itself: the variables count only once they are exported, as above
# (or by Docker / systemd through an env file in deployment). .env is gitignored; never commit it.
# Every variable, its reader and its default: docs/CONFIGURATION.md.
#
# Rules for this file:
#   * The values that are set below are the built-in defaults, written out for a local run with
#     no network credentials. Deleting a line changes nothing.
#   * Optional settings are commented out. Keep a setting commented out rather than leaving it
#     empty: an empty value counts as set, and `ignis serve` rejects an empty enum value (for
#     example IGNIS_AUTH=).
#   * Secrets are commented out. Fill them only in your own .env. Deployed hosts keep theirs in
#     /etc/ignis/*.env (infra/README.md §Credentials).
#   * Relative paths resolve against the directory you run `ignis` from: the repository root.

# =============================================================================================
# Paths and roots (all commands)
# =============================================================================================
# Data root: manifests/, splits/, review/, corpus/, datasets/ (committed), raw/, work/ (built).
IGNIS_DATA=data
# Artifacts root: models/<hex>/ releases, evidence/evidence.sqlite catalog, analysis/, vision/.
IGNIS_ARTIFACTS=artifacts
# Runs root: jobs/ ledger, evaluation/ (seals, reveal_log.jsonl), wiki/wiki.sqlite.
IGNIS_RUNS=runs
# Lockbox root: sealed continuations and the evaluator bundle (datasets/). Evaluation scopes only.
IGNIS_HOLDOUT=holdout
# Configs root: resources/, training/, models/, evidence/, vision/, evaluation/, pricing/.
IGNIS_CONFIGS=configs
# Decoded-video frame cache of ignis-vision (frames/ is appended).
IGNIS_CACHE=data/cache
# Extra split lookup of ignis lab/eval; frozen splits in data/splits are found from every command.
IGNIS_SPLITS=data/work/splits
# IGNIS_FROZEN_SPLITS=data/splits
# SAM2.1 checkpoint when configs/vision/sam2.toml names none (sidecar/sam2).
# IGNIS_SAM2_CHECKPOINT=data/models/sam2/sam2.1_hiera_small.pt

# =============================================================================================
# Server: ignis serve
# =============================================================================================
IGNIS_PORT=8787
# Repository root; the paths below resolve against it.
IGNIS_ROOT=.
# Runtime state: state.sqlite (episodes, events, jobs) and artifacts/.
IGNIS_STATE_DIR=runs/server
# Records the legacy /api registry reads.
IGNIS_RECORDS=data/work/records
IGNIS_EVIDENCE_DB=artifacts/evidence/evidence.sqlite
# local = one loopback user; cloudflare-access = behind Cloudflare Access (needs the ACCESS block).
IGNIS_AUTH=local
# local | r2 (r2 needs the R2 block).
IGNIS_ARTIFACT_BACKEND=local
# log | enforce: what answer_submit does with a number that does not resolve to its reference.
IGNIS_ANSWER_GROUNDING=log
# Largest single upload, in bytes (2 GiB).
IGNIS_MAX_UPLOAD_BYTES=2147483648
# MCP endpoint port, always on 127.0.0.1; 0 picks a free port.
IGNIS_MCP_PORT=0
# Serve the FLEX/ACME/BASS model families (hand-written releases in IGNIS_WSP_SERVED). Off by default.
# IGNIS_ENABLE_MODELS=true
# IGNIS_WSP_SERVED=configs/models/served
# Versioned LLM price list for cost metrics; unset = the list built into the binary.
# IGNIS_PRICE_LIST=configs/pricing/llm_prices.toml
# Log filter (tracing). The server image uses info,tower_http=info.
RUST_LOG=info

# --- Source access without copies (M12/R11)
IGNIS_SOURCE_MANIFESTS=data/manifests
IGNIS_MEDIA_INDEX=data/media/keyframes
IGNIS_MEDIA_CACHE=data/media
IGNIS_PSI_GEODE_URL=https://psi.nasa.gov/geode-py/ws
# Public origin of the UI (https://..., no trailing slash); unset = NTRS opens as a link out and
# .ts recordings get no playlist.
# IGNIS_PUBLIC_URL=http://localhost:5173

# --- Web discovery (R4): off unless 1/true/yes/on; search also needs a provider key.
# IGNIS_ENABLE_WEB=1
# PARALLEL_API_KEY=changeme
# IGNIS_WEB_SEARCH_URL=https://api.parallel.ai/v1/search

# =============================================================================================
# Cloudflare Access (required with IGNIS_AUTH=cloudflare-access; unused locally)
# =============================================================================================
# IGNIS_ACCESS_TEAM_DOMAIN=https://<team>.cloudflareaccess.com
# IGNIS_ACCESS_ORIGIN_AUD=<aud tag of the origin application>
# IGNIS_ACCESS_USER_AUD=<aud tag of the UI application, different from the origin one>
# IGNIS_ACCESS_SERVICE_TOKEN_ID=<client id of the Worker's service token>

# =============================================================================================
# R2 artifact store and state backups (required with IGNIS_ARTIFACT_BACKEND=r2 or --push/--pull)
# =============================================================================================
# IGNIS_R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# IGNIS_R2_BUCKET=ignis-artifacts
# IGNIS_R2_ACCESS_KEY_ID=changeme
# IGNIS_R2_SECRET_ACCESS_KEY=changeme
IGNIS_BACKUP_PREFIX=backups/

# =============================================================================================
# Agent runtime (unset binary = runtime reported unavailable; the rest of the server works)
# =============================================================================================
# codex (Codex App Server, pinned 0.169.0) or claude (Claude Code, headless).
IGNIS_AGENT_RUNTIME=codex
# Native codex executable (not an npm shim); tools/codex/setup.sh prints it.
# IGNIS_CODEX_BIN=/path/to/codex
# Expected sha256 of that executable; unset = recorded, not enforced.
# IGNIS_CODEX_SHA256=<sha256 hex>
# IGNIS_CODEX_MODEL=<model id; unset = Codex default>
# Signed-in CODEX_HOME (ChatGPT plan) used instead of an API key; must be writable.
# IGNIS_CODEX_LOGIN_HOME=/path/to/codex-home
# Claude Code executable. Also used by `ignis data review auto` and the `ignis evidence` model
# passes (default: claude on PATH).
# IGNIS_CLAUDE_BIN=claude
# IGNIS_CLAUDE_MODEL=<model id; unset = Claude Code default>
# Signed-in Claude config directory used when no token or key is set; must be writable.
# IGNIS_CLAUDE_LOGIN_HOME=/path/to/claude-config
# Let the Claude investigator hand one bounded subtask to a native subagent.
# IGNIS_CLAUDE_DELEGATION=true
# Harness directory (investigator.md, skills/) instead of the bundle compiled from harness/.
# IGNIS_HARNESS_DIR=harness

# --- Model credentials (secrets; one per runtime is enough; passed only to the runtime child)
# Codex, API billing (OPENAI_API_KEY is the fallback name):
# CODEX_API_KEY=changeme
# OPENAI_API_KEY=changeme
# Claude, plan token from `claude setup-token`, or API billing:
# CLAUDE_CODE_OAUTH_TOKEN=changeme
# ANTHROPIC_API_KEY=changeme

# =============================================================================================
# Isolated analysis runner (analysis_execute; unset image = runner reported unavailable)
# =============================================================================================
# Image id printed by tools/runner/build.sh.
# IGNIS_RUNNER_IMAGE=sha256:<runner image id>
# OCI runtime: runsc (gVisor). Without gVisor locally, set IGNIS_RUNNER_ALLOW_CONTAINER=true
# (accepted with IGNIS_AUTH=local only).
IGNIS_RUNNER_RUNTIME=runsc
# IGNIS_RUNNER_ALLOW_CONTAINER=true
IGNIS_RUNNER_ENGINE=docker
# Per-run mounts (absolute, shareable with the engine); unset = <state-dir>/runner.
# IGNIS_RUNNER_DIR=/abs/path/runs/server/runner

# =============================================================================================
# Evidence: dense retrieval and reranking (being removed, LANES_V2 R12a; optional)
# =============================================================================================
# DEEPINFRA_API_KEY=changeme

# =============================================================================================
# Curation: automatic adjudication (`ignis data review auto`)
# =============================================================================================
# Backoff after consecutive model failures, in milliseconds.
# IGNIS_AUTO_BACKOFF_MS=30000

# =============================================================================================
# Web dashboard dev server (web/vite.config.ts): it proxies /api to 127.0.0.1:$IGNIS_PORT.
# =============================================================================================
# PORT=5173

# =============================================================================================
# Deployment only: read by infra/deploy/compose.yaml, systemd and infra/scripts on the origin
# host from /etc/ignis/{release,cloudflared,edge}.env. Listed for reference; not used locally.
# =============================================================================================
# IGNIS_IMAGE=ignis-server@sha256:<digest>
# CLOUDFLARED_IMAGE=cloudflare/cloudflared@sha256:<digest>
# DOCKER_GID=<gid of /var/run/docker.sock>
# IGNIS_ENV_FILE=/etc/ignis/ignis.env
# CLOUDFLARED_ENV_FILE=/etc/ignis/cloudflared.env
# IGNIS_SECRETS_DIR=/etc/ignis/secrets
# IGNIS_RELEASE_ENV=/etc/ignis/release.env
# TUNNEL_TOKEN=changeme
# CLOUDFLARE_API_TOKEN=changeme
# CLOUDFLARE_ACCOUNT_ID=changeme
# UI_HOSTNAME=<ui hostname>
# ORIGIN_HOSTNAME=<origin hostname>
# Worker (infra/worker): ORIGIN_URL is a var in wrangler.jsonc; ORIGIN_CLIENT_ID and
# ORIGIN_CLIENT_SECRET are Worker secrets (`npx wrangler secret put`), never environment here.
