# Only for a UI served apart from the API (Vercel + `ignis serve --auth google`). Leave both unset
# for local dev (Vite proxy) and for the Cloudflare Worker deployment.
# OAuth 2.0 web client id; the server's IGNIS_GOOGLE_CLIENT_ID must be the same value.
VITE_GOOGLE_CLIENT_ID=
# Origin of the API, no trailing slash, e.g. https://api.example.org
VITE_API_BASE=
